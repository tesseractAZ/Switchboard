#!/usr/bin/python3
"""Switchboard per-call quality sink — turns raw RTP numbers into a durable record,
a Home Assistant sensor, and a proactive "that call was rough" notification.

ONE producer feeds this script today:

  * the dialplan ``[switchboard-rtpqos]`` h-extension (source=dialplan) — fires on
    hangup with the EXACT final ``CHANNEL(rtcp,*)`` stats for the leg that DIALED
    (the initiating phone / inbound trunk). Authoritative.

``--source`` exists because a second producer was designed — an AMI poller
supplying the far/ANSWERING leg, which never runs a context and so has no
h-extension. It was never built: every record in the ledger to date is
``source=dialplan``. **So every quality number here describes the CALLER's leg
only**; the answering phone's receive quality (notably the cordless on an inbound
trunk call) is not measured. Do not read a clean ledger as "both directions were
fine". If that producer is ever added, ``source=poll`` is the reserved value.

Keeping the quality logic HERE (not in the dialplan or the poller) means one place
to test and tune. Everything is wrapped so this can NEVER take down a call leg: the
dialplan invokes us backgrounded via TrySystem, and we always exit 0.

Outputs:
  * /data/state/callqos.jsonl  — append-only, last MAX_RECORDS legs (readers dedupe
    by channel, preferring source=dialplan). The "record everything" ledger.
  * sensor.switchboard_last_call (dialplan source only) — numeric worst-leg MES so
    HA's Recorder graphs the trend; all metrics ride along as attributes.
  * a persistent notification (bell menu) when a call scores poorly — keyed by
    channel so a dialplan+poll double-report can't double-notify.

Usage (all metric flags optional; missing/"unknown"/"unavailable" -> null):
    switchboard-callqos --source dialplan --tag rooms --chan PJSIP/12-00000000 \
        --cid 12 --codec ulaw --billsec 25 --hcause 16 \
        --rxcount 1265 --txcount 1265 --rxploss 0 --txploss 0 \
        --rxjitter 0.019875 --txjitter 0 --rtt 0.001724 --rxmes 88.06 --txmes 88.06 \
        --maxrtt 0.03 --stdevrtt 0.004 --rxmaxjitter 0.04 --rxoctet 202400 --txoctet 202400
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
import time

try:
    import fcntl  # POSIX only; the add-on runs on Linux
except ImportError:  # pragma: no cover
    fcntl = None

# ha_client (HA push) lives with the webui; import it lazily/defensively so a
# broken import can never propagate out of a hangup handler.
sys.path.insert(0, "/usr/share/switchboard/webui")

# /data/state is the setgid, group-writable dir both the asterisk-user dialplan
# and the root poller can write (see switchboard-config ensure_state_dir).
PATH = os.environ.get("SWITCHBOARD_CALLQOS", "/data/state/callqos.jsonl")

# Legs the PBX ITSELF originates to play something at a phone: a wake-up
# delivery, an intercom page, a recorded announcement. They ARE recorded — the
# ledger should describe every leg the system carries, which is why they gained
# an h-extension — but they never raise a notification and never drive the
# "last call quality" sensor.
#
# Two reasons, both about who is listening. Nobody is on the line to act on a
# real-time popup about a three-second chime, so an alert there is pure noise.
# And these legs are one-directional BY DESIGN: the PBX talks and the handset
# mostly listens, so the one-way-audio detector — which exists to catch a
# BROKEN conversation — would fire on their normal shape. Human conversations
# (rooms, operator, directory, from-trunk) and the interactive voice menus
# (wakeup, automation, status) still alert exactly as before.
PLAYBACK_TAGS = frozenset({"wakeup-deliver", "page", "announce"})

# The stages [wakeup-deliver] sets, IN THE ORDER THE DIALPLAN SETS THEM.
# switchboard-config's render_wakeup_context() is the definition; this is a copy,
# and test_wakeup_delivery_verdict keeps the two identical. A stage added there
# and not here scores as a failed delivery — silently, at six in the morning.
WAKEUP_STAGES = ("answering", "scene", "greeting", "time", "extras", "repeat",
                 "complete")
# ...and the stage from which audio has demonstrably played. The dialplan sets
# `greeting` immediately before Playback(sw-wakeup-greeting), so reaching it and
# transmitting audio is the earliest proof that sound left the box towards a live
# handset. Everything after it is more of the same script.
WAKEUP_DELIVERED_FROM = "greeting"

# The same two facts for [switchboard-announce-play], which is a two-stage
# script: `playing` is set immediately before Playback(${SW_ANN_FILE}).
ANNOUNCE_STAGES = ("playing", "complete")
ANNOUNCE_DELIVERED_FROM = "playing"

# tag -> (every stage in order, the stage from which audio has played)
SCRIPTED_STAGES = {"wakeup-deliver": (WAKEUP_STAGES, WAKEUP_DELIVERED_FROM),
                   "announce": (ANNOUNCE_STAGES, ANNOUNCE_DELIVERED_FROM)}

# Transmitted RTP packets that count as audio somebody actually heard: 50
# packets is one second of ulaw at 20 ms per packet, the same rate `rtp_secs`
# below divides by.
#
# Deliberately a duration and not `> 0`. A handset picked up and dropped inside
# the codec's own startup can emit a stray packet or two, and the one thing this
# verdict must never do is launder the 2026-09-02 06:15:22 leg — answered,
# txcount 0, the sleeper heard silence — into a success. One second is also
# comfortably below both live early-hangups (59 and 161 packets, i.e. 1.2 s and
# 3.2 s), so it separates "heard the greeting start" from "heard nothing".
DELIVERED_MIN_TXCOUNT = 50

# Contexts that narrate a script, and the stages that mean the script delivered.
# The dialplan enters both ONLY after Answer(), so a non-empty `stage` on one of
# these legs is proof the call was picked up — which makes the pair (stage,
# txcount) a complete delivery verdict: somebody answered, and this much audio
# actually left the box.
#
# ★ v0.96.0 made this a SET, because `_stage != "complete"` makes any new
# terminal stage inert on arrival. v0.97.0 fixes what the set CONTAINED: it
# listed {complete, delivered, repeat}, where "delivered" is not a stage the
# dialplan has ever set and `time`/`extras` are. Live consequence, in the ledger
# right now: four wake-ups scored `undelivered` with `notify: true` — two that
# stopped at `extras` having transmitted 704 and 623 packets (14 and 12 seconds
# of the script), and two that stopped at `greeting` with 59 and 161. All four
# woke somebody; all four earned a DND-bypassing push at 6am saying they had not.
#
# So the set is DERIVED from the ladder rather than enumerated by hand, which is
# what let a real stage go missing and a fictional one take its place.
#
# ★ THE TWO CONTEXTS DRAW THIS LINE IN DIFFERENT PLACES, DELIBERATELY. An alarm
# clock's contract is "did it wake you", so anything from the greeting onward has
# met it. An announcement's contract is "did the message get across", so only a
# clip that played to the end has. The DELIVERY ledger asks a third question —
# "did this reach the handset at all" — and that one is `audio_reached` below.
SCRIPTED_TERMINAL = {
    "wakeup-deliver": frozenset(
        WAKEUP_STAGES[WAKEUP_STAGES.index(WAKEUP_DELIVERED_FROM):]),
    "announce": frozenset({"complete"}),
}

# ...and the one scripted context with a hard deadline. A wake-up call that did
# not wake anyone is a failure with a real-world cost; a page or an announcement
# that was cut short is not worth an alert. So this is the only playback tag
# permitted to break the PLAYBACK_TAGS silence.
ALARM_TAG = "wakeup-deliver"

# Scripted contexts that report their own delivery into the shared ledger, and
# the `kind` each files under there. Both have a reader waiting: the wake-up
# reconciler in wakeup/scheduler.py joins on the wake-up rows to decide whether
# to ring again, and the announce reconciler beside it joins on the announce rows
# to decide whether an announcement ever arrived. `page` is absent on purpose —
# nothing is waiting on a page, and a row nobody reads is just noise.
DELIVERY_KIND = {"wakeup-deliver": "wakeup", "announce": "announce"}
# Asterisk-readable runtime staged by switchboard-config (root-only options.json is
# not readable by the asterisk user the dialplan runs us as).
FEATURES = os.environ.get("SWITCHBOARD_FEATURES", "/run/switchboard/features.json")
MAX_RECORDS = 300

# "no RTCP" sentinels the CHANNEL(rtcp,*) function can emit, plus the empty string.
_NULLISH = {"", "unknown", "unavailable", "(null)", "nan"}

# Signed non-finite spellings that argparse would mistake for an option (leading
# dash) and abort on. Unsigned "nan"/"inf" parse fine (no dash) and _num() nulls
# them anyway; only the dash-prefixed forms need pre-blanking. Covers glibc and
# the MSVC-style spellings for good measure.
_BADTOK = {"-nan", "-inf", "-nan(ind)", "-inf(inf)", "-1.#ind", "-1.#inf", "-1.#qnan"}


# --------------------------------------------------------------------------- #
# Parsing — tolerate empty / sentinel / malformed without ever raising.
# --------------------------------------------------------------------------- #
def _num(v):
    if v is None:
        return None
    s = str(v).strip()
    if s.lower() in _NULLISH:
        return None
    try:
        f = float(s)
    except (TypeError, ValueError):
        return None
    # Guard against inf/nan poisoning the sensor / arithmetic.
    if f != f or f in (float("inf"), float("-inf")):
        return None
    return f


def _int(v):
    f = _num(v)
    return int(f) if f is not None else None


def _pct(loss, count):
    """Packet loss as a percentage; None if the counter is missing/zero."""
    if loss is None or count is None or count <= 0:
        return None
    return round(100.0 * loss / count, 3)


def _ms(sec):
    """CHANNEL(rtcp,*) reports jitter/rtt in SECONDS; present as milliseconds."""
    return None if sec is None else round(sec * 1000.0, 2)


# --------------------------------------------------------------------------- #
# Quality classification — the one knob worth tuning. Given the initiating leg
# sees BOTH directions (rxmes = audio it heard, txmes = audio the far end heard),
# we score on the WORSE direction and the WORSE loss, so a one-way problem (the
# real-world failure mode — e.g. the MES-59 WiFi-cordless call) can't hide behind
# a healthy reverse path.
# --------------------------------------------------------------------------- #
def rtt_sampling(rtt_ms, max_ms, stdev_ms):
    """How many RTCP rounds the RTT figures rest on: 'multi' | 'single' | 'none'.

    A one-round measurement is the dangerous case, because it does not LOOK like
    one. Live example: rtt=0.005538 with stdev=0.000000 and maxrtt equal to rtt
    reached the ledger beside a perfectly ordinary rxmes=82.5 -- statistically
    empty, but indistinguishable from a well-sampled leg by any field the record
    carried. Every mean, percentile and trend the ledger supports was averaging
    those in at full weight.

    Asterisk exposes no RTCP report count, and inventing a CHANNEL(rtcp,...) name
    that does not exist is exactly the v0.48.0 rxoctetcount mistake -- four
    WARNINGs per call and a field null in 100% of records. So this is DERIVED
    from what is already in hand: a spread of zero with max == mean means one
    sample (or none at all, if the mean is zero too)."""
    def _z(v):
        return v is None or abs(v) < 1e-9
    if _z(rtt_ms) and _z(max_ms) and _z(stdev_ms):
        return "none"
    if not _z(stdev_ms):
        return "multi"
    # stdev is zero: one sample, unless max disagrees with the mean (which would
    # mean real spread that stdev somehow missed -- treat that as multi, not as a
    # claim we cannot support).
    if _z(max_ms) or abs((max_ms or 0) - (rtt_ms or 0)) < 1e-9:
        return "single"
    return "multi"


def classify(worst_mes, worst_loss_pct, rtt_ms,
             rtt_mean_ms=None, rtt_max_ms=None, sampling=None):
    """Return (label, notify: bool, reasons: list[str]).

    Two separate jobs, deliberately kept apart:

      `notify` fires on the ALERT thresholds only — conservative, so a
      notification means "worth a look", not "spam on every WiFi hiccup":
        - MES ~88 ≈ MOS 4.4 (toll quality); 70 ≈ MOS 3.5; 60 ≈ MOS 3.0 (fair).
        - loss under ~1% is inaudible on G.711; 3%+ is audible clipping.
        - RTT under ~150 ms is unnoticed; 400 ms+ makes conversation stilted.

      `reasons` explains the LABEL. Through v0.76.0 it was built from the alert
      set alone, so any demotion below the alert line recorded nothing at all: a
      wake-up leg with 1.307% receive loss landed in the ledger as
      `quality: "good", reasons: [], notify: false` — the label said something
      was wrong and every field that could say WHAT was empty. Two live records
      showed exactly that shape. A demoted record must now always explain itself,
      while the alerting line stays where it was.

    RTT is scored on the DISTRIBUTION, not the last draw (v0.77.0). `rtt_ms` is
    `CHANNEL(rtcp,rtt)`, the final RTCP round only; over 55 measured legs its
    maximum was 163.62 ms, so the 400 ms alert below it could never fire, while
    `rtt_max_ms` in the same records reached 845.93 ms and `rtt_mean_ms` 169.48.
    Scoring the mean and the peak flags one call in that population — the right
    answer, and not the zero the old test was structurally guaranteed to give.
    `rtt_ms` remains the fallback for a caller that has no distribution to pass.

    `sampling` is accepted for symmetry with the record but is NOT a veto here.
    Zero completed RTCP rounds does not mean zero measurement: receive loss,
    receive jitter and the MES are computed from LOCAL counters, so a peer that
    never echoes an RTCP report (the VoIP.ms trunk does exactly this) still
    yields a genuinely gradeable leg. Forcing `unknown` on `sampling == "none"`
    was tried and reverted — it discarded real quality data on every trunk call.

    The no-measurement case is handled where it belongs, at the source: Asterisk
    leaves the MES field at one of two constants when it has nothing to report —
    0.0, which `_credible()` has always rejected, or 88.087887, which reads as a
    flawless call. Four live no-RTCP legs proved the split: one scored `unknown`
    and three scored `excellent`, decided purely by which constant happened to
    land in the field. `_credible()` now rejects both, so `worst_mes` is None and
    the honest `unknown` falls out of the ordinary ladder below.
    """
    alerts, reasons = [], []
    if worst_mes is not None and worst_mes < 70:
        alerts.append(f"MES {worst_mes:.0f} (~MOS {worst_mes / 20:.1f})")
    if worst_loss_pct is not None and worst_loss_pct > 3.0:
        alerts.append(f"loss {worst_loss_pct:.1f}%")
    # Prefer the distribution; fall back to the single draw only when no
    # distribution was supplied, so an old caller still gets the old check.
    if rtt_mean_ms is not None or rtt_max_ms is not None:
        if rtt_mean_ms is not None and rtt_mean_ms > 250:
            alerts.append(f"RTT mean {rtt_mean_ms:.0f}ms")
        if rtt_max_ms is not None and rtt_max_ms > 500:
            alerts.append(f"RTT peak {rtt_max_ms:.0f}ms")
    elif rtt_ms is not None and rtt_ms > 400:
        alerts.append(f"RTT {rtt_ms:.0f}ms")

    if worst_mes is None:
        label = "unknown"
    elif worst_mes >= 85 and (worst_loss_pct or 0) < 0.5:
        label = "excellent"
    elif worst_mes >= 78 and (worst_loss_pct or 0) < 1.5:
        label = "good"
    elif worst_mes >= 65 and (worst_loss_pct or 0) < 4.0:
        label = "fair"
    else:
        label = "poor"

    reasons = list(alerts)
    if label not in ("excellent", "unknown"):
        # Name whatever actually moved the label, if the alert set has not
        # already named it. These are explanations, never alerts.
        if worst_loss_pct is not None and worst_loss_pct >= 0.5 and not any(
                r.startswith("loss ") for r in reasons):
            reasons.append(f"loss {worst_loss_pct:.2f}%")
        if worst_mes is not None and worst_mes < 85 and not any(
                r.startswith("MES ") for r in reasons):
            reasons.append(f"MES {worst_mes:.0f} (~MOS {worst_mes / 20:.1f})")

    return label, bool(alerts), reasons


# --------------------------------------------------------------------------- #
# Derive the full metric set from the raw args.
# --------------------------------------------------------------------------- #
def delivery_failures(tag: str, stage: str, txcount: int) -> list:
    """Why this scripted playback leg did NOT deliver. Empty list means it did.

    ★ THE ONE PLACE THE RULE LIVES. This program scores the quality ledger from
    it AND writes the delivery ledger the wake-up reconciler reads (see
    record_delivery), so the two cannot disagree about the same leg. They already
    did — on 2026-09-08 06:12:22 the reconciler called a leg undelivered and
    re-rang the phone while the quality ledger, looking at the same numbers,
    could see 59 packets of greeting had reached it.

    Two independent facts, both required:

      stage    — the dialplan enters these contexts only after Answer(), so any
                 stage at all proves a pickup, and the LAST stage reached says
                 how far the script got. `greeting` onwards means a Playback ran.
      txcount  — how much audio actually left the box. A stage is set BEFORE the
                 Playback it labels, so reaching `greeting` on its own proves
                 only that Asterisk tried.

    A leg with no stage is not a scripted delivery at all (an ordinary room call
    sets none) and is returned as no failures — never dragged into this rule.
    """
    terminal = SCRIPTED_TERMINAL.get(tag or "")
    if not terminal or not stage:
        return []
    out = []
    if txcount == 0:
        out.append("answered but transmitted no audio")
    elif txcount < DELIVERED_MIN_TXCOUNT:
        out.append(f"only {txcount / 50.0:.1f}s of audio reached the handset")
    if stage not in terminal:
        out.append(f"delivery stopped at stage {stage!r}")
    return out


def audio_reached(tag: str, stage: str, txcount: int) -> bool:
    """Did this scripted leg get real audio out to the handset?

    A WEAKER question than delivery_failures, and a different one. That asks
    whether the script met its contract; this asks whether the phone answered and
    sound came out of it — which is what the delivery ledger is for, and the only
    thing the announce reconciler needs to know.

    They differ on a truncated announcement: a 10-second clip cut off at 8
    seconds did not meet its contract, but it plainly reached the handset, and
    filing it as "never delivered" beside an announcement that rang out
    unanswered would flatten the one distinction the reconciler exists to draw.
    The record carries `stage` and `txcount`, so the truncation stays visible.
    """
    stages_from = SCRIPTED_STAGES.get(tag or "")
    if not stages_from or not stage:
        return False
    stages, first_audio = stages_from
    if stage not in stages:
        return False              # a stage this build has never heard of
    return (stages.index(stage) >= stages.index(first_audio)
            and txcount >= DELIVERED_MIN_TXCOUNT)


def build_record(a) -> dict:
    rxcount, txcount = _int(a.rxcount), _int(a.txcount)
    rxploss, txploss = _int(a.rxploss), _int(a.txploss)
    rxmes, txmes = _num(a.rxmes), _num(a.txmes)
    rtt_ms = _ms(_num(a.rtt))
    loss_rx = _pct(rxploss, rxcount)
    loss_tx = _pct(txploss, txcount)
    jit_rx = _ms(_num(a.rxjitter))
    jit_tx = _ms(_num(a.txjitter))

    # When NO RTCP round completed, Asterisk reports rtt, rxjitter, rxmes and
    # txmes as 0.000000 together -- and 0.0 is a convincing number. _credible()
    # already nulls the MES pair, but a 0 ms RTT and 0 ms jitter read as a
    # flawless call rather than as no measurement, and were being forwarded
    # unqualified into every aggregate. Four fields exactly zero at once is a
    # combination no real call produces, so treat it as the sentinel it is.
    #
    # v0.77.0 HOISTED this above the scoring. It used to run AFTER classify(),
    # which is why classify() could only ever be handed rtt_ms -- the one RTT
    # field that is a single arbitrary draw. An audit measured the cost: across
    # 55 legs rtt_ms peaks at 163.62 ms, so the 400 ms threshold below it was
    # unreachable BY CONSTRUCTION, while rtt_max_ms in the very same records
    # reached 845.93 ms. Order of statements was the whole defect.
    rtt_max = _ms(_num(a.maxrtt))
    rtt_stdev = _ms(_num(a.stdevrtt))
    rtt_mean = _ms(_num(a.normdevrtt))
    rtt_min = _ms(_num(a.minrtt))
    _sampling = rtt_sampling(rtt_ms, rtt_max, rtt_stdev)
    if _sampling == "none":
        # Null the WHOLE RTT family, not just the headline figure. v0.60.0 nulled
        # rtt_ms and rx jitter but left mean/min/max/stdev at 0.0, and a live
        # record proved the gap: rtt_ms=null beside rtt_mean_ms=0.0 on the same
        # leg. A consumer averaging rtt_mean_ms saw a flawless 0 ms call, which is
        # exactly the convincing zero the fix was written to eliminate -- half a
        # fix here is arguably worse than none, because the nulled field implies
        # the others were checked.
        rtt_ms = rtt_max = rtt_stdev = rtt_mean = rtt_min = None
        if jit_rx == 0:
            jit_rx = None

    # A per-direction MES only drives the score if it is trustworthy. Asterisk
    # reports 0.0 for a direction it could not score (short call / RTCP not yet
    # converged) — never a genuine 0 MOS — and a COLLAPSED MES (<40 ≈ MOS 2.0)
    # alongside ~0% loss, only-packetization jitter, and a low RTT is a
    # re-INVITE/transfer glitch, not real audio (that MOS physically requires heavy
    # loss/jitter). Either way, drop the reading from the worst-of aggregation so it
    # can't fire a false "poor"; genuine degradation always brings real loss and/or
    # jitter (kept) and one-way audio is caught separately by packet counts below.
    # The RAW mes_rx/mes_tx are still recorded verbatim for transparency.
    # Asterisk's "I have nothing to report" MES constant. It is not a plausible
    # score that happens to be high — it is the same literal float on every leg
    # that completed no RTCP round (6 of 55 measured legs carried it, always
    # beside rtt=0.000000 or maxrtt==rtt with stdevrtt=0.000000). Requiring
    # non-'multi' sampling alongside it keeps a genuinely excellent well-sampled
    # call from being thrown away for landing near the same number.
    _MES_SENTINEL = 88.087887

    def _credible(mes, loss, jit):
        if mes is None or mes == 0:
            return None
        if _sampling != "multi" and abs(mes - _MES_SENTINEL) < 1e-4:
            return None
        incoherent = (mes < 40
                      and (loss is None or loss < 0.5)
                      and (jit is None or jit < 40)
                      and (rtt_ms is None or rtt_ms < 80))
        return None if incoherent else mes

    mes_vals = [m for m in (_credible(rxmes, loss_rx, jit_rx),
                            _credible(txmes, loss_tx, jit_tx)) if m is not None]
    worst_mes = min(mes_vals) if mes_vals else None
    loss_vals = [l for l in (loss_rx, loss_tx) if l is not None]
    worst_loss = max(loss_vals) if loss_vals else None

    label, notify, reasons = classify(worst_mes, worst_loss, rtt_ms,
                                      rtt_mean, rtt_max, _sampling)

    rxc, txc = rxcount or 0, txcount or 0  # counts may be None (absent RTCP field)

    # Duration: billsec, unless the monotonic packet counters say the leg ran far
    # longer — the operator's re-record loops reset the CDR, so billsec can cover
    # only the LAST segment (seen live: billsec 2 on ~75s of RTP). ulaw at 20ms
    # ptime streams 50 pkts/s, so max(rx, tx)/50 is the leg's true wall time; when
    # it exceeds double billsec (+5s slack so short calls never trip it) the RTP
    # evidence wins and the mangled value is preserved as billsec_raw.
    billsec = _int(a.billsec)
    rtp_secs = max(rxc, txc) / 50.0
    billsec_raw = None
    dur = billsec
    if billsec is not None and rtp_secs > 2 * billsec + 5:
        billsec_raw = billsec
        dur = round(rtp_secs)

    # One-way audio: one direction carried real traffic while the other was fully
    # dead. Worst-direction MES scoring alone MISSES this — the dead side reports
    # no MES, so min() ignores it and a dead-receive call scores "excellent". This
    # IS the failure the feature must catch, so flag it explicitly. "Dead" means
    # effectively no audio, not literally zero: a live G.711 leg streams ~50 pkts/s
    # even in silence (VAD is off), so a direction carrying only a handful of packets
    # across a multi-second call is dead too — a lone stray packet (rxcount=1, seen
    # live) must not read as healthy. Require ~1s (>50 pkts) on the LIVE side so a
    # tiny call-setup blip (both sides near-zero) still isn't a false alarm.
    DEAD_PKTS = 10  # < ~0.2s of audio over a whole call == effectively dead
    rx_dead = rxc < DEAD_PKTS
    tx_dead = txc < DEAD_PKTS
    # ...but never on a sub-5s leg (2 live false alarms: a caller abandoning during
    # the operator greeting — Answer -> Wait(1) keeps the transmit side legitimately
    # silent while rx accrues, hcause 16, billsec <= 1).
    #
    # "Long" means long by EITHER measure. Gating on billsec alone (v0.48.0) left a
    # hole precisely where this release knows billsec lies: a CDR reset can report
    # 2 s for a leg whose packet counters show 75 s (both seen live on 2026-08-08),
    # so a genuinely long one-way call with a mangled billsec was silently exempt
    # from the very check that exists to catch it. Taking the max closes that
    # without re-opening the false alarms: the two real abandoned legs measured
    # ~1.1 s and ~1.2 s by BOTH billsec and RTP, so neither reaches 5 either way.
    long_enough = max(billsec or 0, rtp_secs) >= 5
    one_way = (long_enough and (a.tag or "") not in PLAYBACK_TAGS
               and ((rxc > 50 and tx_dead) or (txc > 50 and rx_dead)))
    if one_way:
        reasons = [f"one-way audio ({'receive' if rx_dead else 'transmit'} dead)"] + reasons
        label, notify = "poor", True

    # ext: prefer the channel name's digit endpoint — the dialplan rewrites
    # CALLERID(num) to the household's public DID before an outbound Dial, so the
    # --cid the h-extension passes mis-attributes those legs (seen live: 30/95
    # ledger records). A non-digit endpoint (PJSIP/trunk-... inbound) keeps the
    # cid: there it IS the PSTN caller and the old behavior is correct.
    m = re.match(r"PJSIP/(\d{2,6})-", a.chan or "")
    ext = m.group(1) if m else (a.cid or "").strip()

    # Asterisk renders a native format list as "(ulaw)". Strip the wrapper so
    # the field holds a codec name and not a rendering of one. Fall back to the
    # read format if the channel gives us nothing — being slightly wrong beats
    # regressing a populated field to empty.
    _read_fmt = (a.readformat or "").strip()
    _codec = (a.codec or "").strip().strip("()") or _read_fmt

    # ★ THE WORST OUTCOME MUST NOT GET THE QUIETEST SCORE.
    #
    # Sep 2, 06:15:21. The cordless answered a wake-up call and the far end
    # dropped one second later, during the Wait that precedes the greeting. The
    # ledger recorded it as:
    #
    #   {"tag": "wakeup-deliver", "stage": "scene", "dur": 0,
    #    "rxcount": 34, "txcount": 0, "quality": "unknown", "notify": false}
    #
    # Asterisk transmitted ZERO audio packets: the sleeper picked up the phone
    # and heard nothing at all. That is the worst thing this feature can do, and
    # it scored `unknown` with `notify: false` — the least alarming verdict the
    # ledger can produce, because no rule read `stage` and MES-based scoring has
    # nothing to score when no audio was sent.
    #
    # Both halves of the verdict are already in the record. A stage means the leg
    # was answered; txcount says whether anything reached them.
    _stage = (a.stage or "").strip()
    undelivered = delivery_failures(a.tag or "", _stage, txc)

    if undelivered:
        _quality = "undelivered"
        _reasons = undelivered + [r for r in reasons if r not in undelivered]
        # An alarm clock that did not go off is worth saying out loud. Everything
        # else scripted stays silent — a truncated page is not an emergency.
        _notify = (a.tag or "") == ALARM_TAG
    elif a.nomedia:
        # ★ v0.96.0 — "no RTP" was FOUR different outcomes wearing one label, and
        # the only one worth paging on was the one that never paged.
        #
        # All 9 no-media legs in the live ledger read `quality: "no-media",
        # notify: false`. But an ANSWERED call that carried no audio is a real
        # fault — someone picked up and heard silence — while a call nobody
        # answered carried no audio by definition and is not a fault at all.
        # Filing both as "no-media" meant the bucket was mostly noise, so the
        # notify had to stay off, so the genuine case could never page.
        #
        # billsec and hcause both already reach here and both are already in the
        # record, so the split costs nothing and is auditable afterwards.
        _hc = _int(a.hcause)
        _bs = billsec or 0
        if _bs > 0:
            # Answered, and still no RTP. THE case worth catching.
            _quality, _reasons, _notify = (
                "no-media", ["answered but carried no RTP media"], True)
        elif _hc == 127:
            _quality, _reasons, _notify = (
                "abandoned", ["caller hung up during ringback"], False)
        elif _hc in (3, 34):
            # Channel could never be created / invalid extension. Deliberately
            # NOT a page: 2 of the 9 live cases are dials to ext 20, whose
            # non-registration is intentional, and 1 is a misdial that
            # Congestion() correctly rejected. A bucket of its own keeps a
            # genuine routing defect visible without paging on known-benign
            # behaviour.
            _quality, _reasons, _notify = (
                "unreachable", ["channel could not be created"], False)
        elif _hc == 16:
            _quality, _reasons, _notify = (
                "not-answered", ["rang out; nobody answered"], False)
        else:
            _quality, _reasons, _notify = (
                "no-media", ["leg carried no RTP media"], False)
    else:
        _quality, _reasons = label, reasons
        _notify = notify and (a.tag or "") not in PLAYBACK_TAGS

    rec = {
        # Schema version. A reader must be able to tell one shape from another
        # without inferring it from a missing key -- an audit found TWO shapes in
        # the /share mirror (20 lines of 11 fields, 30 of 32) and could only
        # separate them by counting keys, then reasonably concluded the missing
        # 21 fields were being discarded rather than merely unmirrored.
        #   v1  the first /share mirror: 11 of the ledger's fields
        #   v2  the full mirror (v0.62.0)
        #   v3  v0.77.0 -- jitter fields renamed for their real provenance,
        #       null-in-100% octet keys omitted, RTT scored on the distribution
        "v": 3,
        "ts": int(time.time()),
        "source": a.source,
        "tag": a.tag or "",
        "chan": a.chan or "",
        "ext": ext,
        "sound": (a.sound or "").strip(),
        # ★ The NEGOTIATED wire format. Through v0.76.0 this field carried
        # CHANNEL(audioreadformat) — Asterisk's internal read format, a
        # different quantity — and so named codecs the configuration forbids:
        # pjsip.conf sets disallow=all / allow=ulaw on both the room-endpoint
        # template and the trunk, yet 3 of 30 records said "slin", and two
        # assistant rows on the SAME handset 87 seconds apart disagreed with
        # each other. That is impossible on the wire; what it was really
        # reporting is that one leg transcoded for a record() AGI. Worth
        # knowing, so it is kept — under its own name, below.
        "codec": _codec, "read_format": _read_fmt,
        "dur": dur,
        "billsec_raw": billsec_raw,
        "hcause": _int(a.hcause),
        # "" for an ordinary call; for a scripted leg this is the LAST milestone
        # reached, so a wake-up cut off before the greeting is finally
        # distinguishable from one that ran to completion.
        "stage": (a.stage or "").strip(),
        "rxcount": rxcount, "txcount": txcount,
        "loss_rx_pct": loss_rx, "loss_tx_pct": loss_tx,
        # ★ DO NOT BUILD A RECEIVE-JITTER ALARM ON jitter_rx_last_ms.
        # On announce-tagged legs it is the degenerate constant 0.019875 s in
        # 7 of 7 observed records, across durations from 5 s to 72 s -- pinned a
        # hair under the 20 ms ulaw packet interval, i.e. the estimator is not
        # converging rather than reporting a real measurement. Wake-up legs sit
        # in the same narrow band (0.019000-0.019750). A threshold on this field
        # would read permanently green while measuring nothing, which is worse
        # than having no check at all. jitter_tx_last_ms DOES vary
        # (0.001000-0.008375) and is the usable direction.
        #
        # ★ jitter_rx_peak_local_ms, however, IS usable, and the old names were
        # steering implementers away from the one receive-jitter field that
        # measures something. It was `jitter_rx_max_ms`, which reads as the
        # maximum OF jitter_rx_ms -- and in 22 of 28 records it was SMALLER than
        # the field it appeared to bound (idx37: 19.88 vs 0.38, a 52x inversion).
        # They are not the same quantity: one is Asterisk's interarrival estimate
        # read once at hangup, the other its maxrxjitter, the peak of that
        # estimate sampled at every RTCP report instant. The peak behaves like a
        # real physical measurement -- 0.38 ms on the wired FXS gateway (ext 16)
        # against up to 58.25 ms on the WiFi cordless (ext 19) -- which is
        # exactly the contrast a receive-jitter check would want.
        #
        # v0.77.0 renamed all three so no name asserts a relationship that does
        # not hold. Nothing thresholds on jitter today; this note exists so that
        # stays a decision rather than an accident.
        "jitter_rx_last_ms": jit_rx, "jitter_tx_last_ms": jit_tx,
        "rtt_ms": rtt_ms,
        # Jitter-buffer / variation telemetry (piece 4): peak & spread reveal a
        # bumpy stream that a healthy AVERAGE would mask.
        "rtt_max_ms": rtt_max, "rtt_stdev_ms": rtt_stdev,
        # The MEAN, so a consumer alarming on "the call's RTT" sees the whole
        # call rather than its last RTCP round. rtt_ms stays as the last round.
        "rtt_mean_ms": rtt_mean, "rtt_min_ms": rtt_min,
        # How much sampling the RTT figures rest on. 'single' is the one that
        # matters: statistically empty but visually identical to a real reading.
        # Consumers computing any aggregate should drop anything but 'multi'.
        "rtt_samples": _sampling,
        "jitter_rx_peak_local_ms": _ms(_num(a.rxmaxjitter)),
        "mes_rx": round(rxmes, 1) if rxmes is not None else None,
        "mes_tx": round(txmes, 1) if txmes is not None else None,
        "mes_worst": round(worst_mes, 1) if worst_mes is not None else None,
        "mos_worst": round(worst_mes / 20.0, 2) if worst_mes is not None else None,
        "quality": _quality,
        # Recorded, never alerted — see PLAYBACK_TAGS. Stored as the honest
        # False so the ledger says plainly that no alert was raised.
        "notify": _notify,
        "reasons": _reasons,
    }
    # Octet counters: PJSIP in Asterisk 20.11.1 exposes no CHANNEL(rtcp,...) name
    # for them, so the dialplan stopped passing --rxoctet/--txoctet in v0.48.0 --
    # but the record kept emitting both keys, null in 100% of 30 records. A key
    # that is always null is worse than an absent one: it advertises a
    # measurement the system cannot make. Emit them only if a future Asterisk
    # actually supplies them. Same convention as delivery.record(): absent
    # optionals are OMITTED, so a reader can tell "not applicable" from
    # "measured as nothing".
    for _k, _v in (("rx_octets", _int(a.rxoctet)), ("tx_octets", _int(a.txoctet))):
        if _v is not None:
            rec[_k] = _v
    return rec


# --------------------------------------------------------------------------- #
# Durable ledger — append, cap to MAX_RECORDS, atomic + flock (same idiom as
# mwi_store, so the root poller and asterisk-user dialplan can both write).
# --------------------------------------------------------------------------- #
SHARE_OUTCOME_PATH = os.environ.get(
    "SWITCHBOARD_CALLQOS_OUTCOME", "/share/switchboard/callqos-outcomes.jsonl")
# An extension is 2-6 digits (config.yaml's schema: match(^[0-9]{2,6}$)). Anything
# longer in the `ext` field is a telephone number, not an extension.
MAX_EXT_DIGITS = 6
SHARE_OUTCOME_MAX_BYTES = 4 * 1024 * 1024


def _rotate_tail(path: str, max_bytes: int, keep_frac: float = 0.5) -> None:
    """Trim an append-only ledger to its newest records. Best-effort.

    v0.77.0 — this used to be `open(path, "w")` followed by `pass`, which
    truncates the file to ZERO BYTES. The comment above it read "Truncating keeps
    the newest records, which are the ones a reader wants" — the exact opposite
    of what the code did. At the cap the entire forensic history disappeared, and
    silently: an empty ledger and a quiet system look identical, which is the
    failure mode this whole file exists to prevent.

    Keeps the last `keep_frac` of the cap, cut at a line boundary so the first
    surviving record is not half a JSON object. Rewrites in place rather than
    renaming, so a reader holding the path keeps reading the same inode.
    """
    try:
        if os.path.getsize(path) <= max_bytes:
            return
        keep = max(1, int(max_bytes * keep_frac))
        with open(path, "rb") as fh:
            fh.seek(-keep, os.SEEK_END)
            tail = fh.read()
        # Everything before the first newline is half a record. Drop it: a
        # reader must never have to guess whether the first line is complete.
        nl = tail.find(b"\n")
        tail = tail[nl + 1:] if nl != -1 else b""
        with open(path, "wb") as fh:
            fh.write(tail)
    except OSError:
        pass                              # a trim must never break the write


def append_outcome(rec: dict) -> None:
    """Mirror a COMPACT outcome to /share, readable from outside the container.

    This process is launched by the dialplan as
    ``TrySystem(... --detach ... &)``. The trailing ``&`` makes the shell exit 0
    immediately, so the dialplan proves only that the process was LAUNCHED --
    never that it parsed its arguments, scored the call, or wrote anything. An
    audit found 13 of 13 log hits were invocation lines and ZERO were output
    from this program, before or after the release built to instrument this very
    pipeline. If callqos were failing -- a bad parse of a newly added flag, a
    store write error -- the failure would be completely silent.

    The full ledger lives in /data, which cannot be read from outside (container
    shell blocked, backups encrypted, add-on API 403). So the terminal step
    leaves a short, readable record of what it decided: enough to confirm it ran
    and to see the verdict, without duplicating the ledger.

    Best-effort: a visibility mirror must never break the ledger write."""
    # Mirror the FULL record, not a curated subset. The first version copied 11
    # of the ledger's 32 fields -- "enough to confirm it ran and see the verdict"
    # -- and that turned out to be the wrong shape for the job. /data cannot be
    # read from outside the container, so this file is the ONLY view any audit
    # gets, and on a surface like that absence reads as loss: an audit correctly
    # observed 11 fields here and reasonably concluded the other 21 were being
    # discarded before the record was written. They are not; they are in the
    # ledger it cannot see.
    #
    # A partial mirror of a durable record is not a smaller truth, it is a
    # different claim. At ~20 calls a day the full record costs a few hundred
    # bytes each against a 4 MB cap, so there is no reason to editorialise.
    out = dict(rec)
    # ★ ...with ONE exception, added v0.81.0. `ext` normally holds a two-digit
    # extension. On a trunk leg it holds a full telephone number instead — the
    # calling party's on an inbound call, the dialled digits on an outbound one —
    # because there is no extension to record. Measured on the live ledger: 45 of
    # 252 rows carried a complete number, 32 of them on internal `rooms` legs
    # where the number had leaked into the field from the caller-ID rewrite.
    #
    # /share is host-mounted, readable from outside the container, and captured
    # in add-on backups. The reasoning for mirroring the full record was that a
    # partial mirror is "not a smaller truth, it is a different claim" — argued
    # about field completeness for auditing, and never about disclosure. It does
    # not extend to other people's telephone numbers, most of which belong to
    # callers who never chose to be in this system at all.
    #
    # The last four digits are kept so a reader can still correlate two legs of
    # the same call; the ledger in /data, which cannot be read from outside,
    # keeps the number in full.
    # ★ v0.99.0 — LENGTH ALONE, NOT `.isdigit()`.
    #
    # The dialplan filters the caller-ID through `FILTER(0-9+*#,...)`, so `+`,
    # `*` and `#` all reach this field — the charset exists to pass them. A
    # number that arrives E.164-formatted is `"+16025551234"`, and
    # `"+16025551234".isdigit()` is FALSE, so the mask was skipped and the whole
    # number was written verbatim to the host-mounted, backup-captured mirror
    # this code exists to keep numbers out of. Proven by running both through
    # build_record + append_outcome: the bare form masked to `*******1234`, the
    # `+` form did not mask at all.
    #
    # The inbound caller-ID is also ATTACKER-CONTROLLED — the dialplan says so
    # in as many words where it filters it — so this was not merely waiting on
    # an upstream format change; a caller could choose the form that leaks.
    #
    # The sibling rule that masks the same value in the Asterisk log already
    # gates on length alone. Two halves of one privacy rule disagreed, and the
    # half that leaked was the durable one. Anything longer than an extension is
    # not an extension, whatever characters it is made of.
    _ext = str(out.get("ext") or "")
    if len(_ext) > MAX_EXT_DIGITS:
        out["ext"] = "*" * (len(_ext) - 4) + _ext[-4:]
        out["ext_redacted"] = True
    try:
        os.makedirs(os.path.dirname(SHARE_OUTCOME_PATH), exist_ok=True)
        _rotate_tail(SHARE_OUTCOME_PATH, SHARE_OUTCOME_MAX_BYTES)
        with open(SHARE_OUTCOME_PATH, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(out) + "\n")
    except OSError:
        pass


def append_record(rec: dict) -> None:
    d = os.path.dirname(PATH) or "."
    os.makedirs(d, exist_ok=True)
    lock_path = PATH + ".lock"
    fh = None
    try:
        if fcntl is not None:
            fh = open(lock_path, "a+")
            try:
                os.chmod(lock_path, 0o664)  # intentional: root services AND the asterisk-user AGIs share this file; group access is required
            except OSError:
                pass
            fcntl.flock(fh, fcntl.LOCK_EX)
        lines = []
        try:
            with open(PATH) as f:
                lines = [ln for ln in f.read().splitlines() if ln.strip()]
        except OSError:
            lines = []
        lines.append(json.dumps(rec, separators=(",", ":")))
        lines = lines[-MAX_RECORDS:]
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".callqos-", suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as f:
                f.write("\n".join(lines) + "\n")
            os.replace(tmp, PATH)
            try:
                os.chmod(PATH, 0o664)  # intentional: root services AND the asterisk-user AGIs share this file; group access is required
            except OSError:
                pass
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    finally:
        if fh is not None:
            try:
                fcntl.flock(fh, fcntl.LOCK_UN)
            finally:
                fh.close()


# --------------------------------------------------------------------------- #
# Home Assistant push — best-effort; a down HA must not matter.
# --------------------------------------------------------------------------- #
def _alerts_enabled() -> bool:
    """The poor-call NOTIFICATION honors the `call_quality_alerts` add-on option
    (default on). The sensor + JSONL ledger are passive and always run.

    Read it from /run/switchboard/features.json — NOT /data/options.json. The
    dialplan runs us as the asterisk user, which cannot read root-only
    /data/options.json; switchboard-config stages the flag into the
    asterisk-readable features.json each config run for exactly this reason.
    Unreadable / missing / malformed -> default on (fail toward informed)."""
    try:
        with open(FEATURES) as f:
            return bool(json.load(f).get("callqos", {}).get("alerts", True))
    except Exception:
        return True


def push_ha(rec: dict) -> None:
    try:
        import ha_client  # noqa: E402
    except Exception:
        return

    # Only the authoritative dialplan leg drives the headline sensor, so the
    # poller's slightly-stale far-leg snapshot can't flicker it.
    if (rec["source"] == "dialplan" and rec["mes_worst"] is not None
            and rec["tag"] not in PLAYBACK_TAGS):
        attrs = {
            "friendly_name": "Switchboard last call quality",
            "unit_of_measurement": "MES",
            "icon": "mdi:phone-check" if rec["quality"] in ("excellent", "good") else "mdi:phone-alert",
            "quality": rec["quality"],
            "mos": rec["mos_worst"],
            "extension": rec["ext"],
            "leg": rec["tag"],
            "codec": rec["codec"],
            "duration_s": rec["dur"],
            "loss_rx_pct": rec["loss_rx_pct"],
            "loss_tx_pct": rec["loss_tx_pct"],
            "jitter_rx_last_ms": rec["jitter_rx_last_ms"],
            "jitter_tx_last_ms": rec["jitter_tx_last_ms"],
            # The usable receive-jitter figure — see the ★ note in build_record.
            "jitter_rx_peak_local_ms": rec["jitter_rx_peak_local_ms"],
            "rtt_ms": rec["rtt_ms"],
            "rtt_max_ms": rec["rtt_max_ms"],
            "mes_rx": rec["mes_rx"],
            "mes_tx": rec["mes_tx"],
        }
        try:
            ha_client.set_state("sensor.switchboard_last_call", rec["mes_worst"], attrs)
        except Exception:
            pass

    # Proactive alert on a rough call. The id is keyed by channel AND the leg's
    # timestamp: Asterisk restarts its channel counter at boot, so
    # "PJSIP/12-00000003" recurs after every restart — keyed on the channel alone,
    # a later bad call would silently REPLACE an earlier unread alert about a
    # different call. The timestamp keeps distinct calls distinct while a repeat
    # report of the SAME leg still collapses onto one entry.
    if rec["notify"] and _alerts_enabled():
        who = rec["ext"] or "a phone"
        leg = f" ({rec['tag']})" if rec["tag"] else ""
        body = (
            f"Call quality was {rec['quality']} on {who}{leg}: "
            + ", ".join(rec["reasons"])
            + f". Duration {rec['dur']}s, codec {rec['codec'] or '?'}."
        )
        nid = (f"switchboard_callqos_{rec['ts']}_"
               + (rec["chan"] or who).replace("/", "_"))
        try:
            ha_client.notify(body, title="Switchboard call quality", notification_id=nid)
        except Exception:
            pass


def _parse_args(argv):
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("--source", default="dialplan")
    p.add_argument("--tag", default="")
    p.add_argument("--chan", default="")
    p.add_argument("--cid", default="")
    p.add_argument("--codec", default="")
    # Asterisk's internal read format. NOT the codec, though it was reported as
    # one until v0.77.0 — see the codec note in build_record().
    p.add_argument("--readformat", default="")
    # This leg never had an RTP session. Set by the dialplan's `nomedia` branch
    # so an abandoned call reaches the ledger as an honest fact rather than as
    # the absence of a row.
    p.add_argument("--nomedia", action="store_true")
    p.add_argument("--billsec", default="")
    p.add_argument("--hcause", default="")
    # How far a scripted leg (wake-up delivery, announce) got before hangup.
    # Empty for contexts that define no stages.
    p.add_argument("--stage", default="")
    # The announcement this leg was playing, by name (`ann-<ext>-<32 hex>`).
    # Empty for every other context. It is the join key between the
    # `originate-queued` record app.py writes when AMI accepts the Originate and
    # the record written from this hangup — see delivery.unresolved_announcements.
    p.add_argument("--sound", default="")
    # Asterisk's running MEAN and floor for RTT. --rtt is the LAST round only:
    # one live call reported rtt=0.007675 against maxrtt=0.146652, a 19x spread,
    # so publishing --rtt as "the call's RTT" was publishing one arbitrary draw.
    p.add_argument("--normdevrtt", default="")
    p.add_argument("--minrtt", default="")
    for f in ("rxcount", "txcount", "rxploss", "txploss", "rxjitter", "txjitter",
              "rtt", "rxmes", "txmes", "maxrtt", "stdevrtt", "rxmaxjitter",
              "rxoctet", "txoctet"):
        p.add_argument(f"--{f}", default="")
    # A leading-dash non-finite value (glibc prints 0.0/0.0 as "-nan", and "-inf"
    # is likewise possible for a metric computed on zero RTCP samples) looks like
    # an unknown OPTION to argparse, which then errors on the flag before it as
    # "expected one argument" and raises SystemExit — dropping the whole record for
    # exactly the degraded/one-way leg this feature exists to surface. Blank those
    # tokens first so the flag binds "" and _num() maps it to None as intended.
    argv = ["" if str(t).lower() in _BADTOK else t for t in argv]
    # Never choke on an unexpected token from the dialplan.
    args, _unknown = p.parse_known_args(argv)
    return args


def record_delivery(rec: dict) -> None:
    """Tell the wake-up reconciler that audio reached the handset.

    ★ THE OTHER HALF OF THE 6AM PUSH, and the reason this lives here rather than
    in a second script.

    scheduler._reconcile_rings() joins on a `spoken` record, written by the
    delivery AGI from the line AFTER Playback(sw-wakeup-greeting). That is the
    right milestone for a greeting that finishes — and it is unreachable for the
    sleeper this alarm clock works best on: woken BY the greeting, hangs up
    during it. Asterisk abandons the extension the instant the channel drops, so
    the AGI never runs, no `spoken` lands, and ninety seconds later the
    reconciler rings the phone a second time and then pushes a critical,
    DND-bypassing "your wake-up call did not go through" to a person who is
    already awake because it did. Live on 2026-09-08 at 06:12:22.

    The h-extension already knows the answer: 59 transmitted packets at stage
    `greeting`. So the leg reports its own delivery, from the same verdict the
    quality ledger is scored with — one decision, two ledgers, no way for them to
    contradict each other on the same call.

    Written for EVERY delivered wake-up leg, not only the early hangups. It costs
    one line and makes this an independent second witness to `spoken`: the AGI
    write has failed silently before (EACCES for two releases, /share root-owned),
    and on the alarm path two instruments beat one.

    Best-effort throughout. A telemetry write must never be the reason a hangup
    handler raises.
    """
    kind = DELIVERY_KIND.get(rec.get("tag") or "")
    if not kind:
        return
    if not audio_reached(rec.get("tag") or "", rec.get("stage") or "",
                         rec.get("txcount") or 0):
        return
    ext = str(rec.get("ext") or "")
    if not ext or rec.get("ext_redacted"):
        return
    try:
        import delivery                       # /usr/share/switchboard/webui
    except Exception:                         # noqa: BLE001
        return
    try:
        # The outcome name comes from `delivery`, the module the reconciler also
        # imports. A literal here and a literal there is a silent rename away
        # from a delivery that reports itself to nobody.
        delivery.record(ext, kind, delivery.AUDIO_DELIVERED,
                        stage=rec.get("stage") or None,
                        txcount=rec.get("txcount"),
                        # ...and the join key for the announce reconciler. Absent
                        # on a wake-up, which has no clip to name.
                        sound=rec.get("sound") or None)
    except Exception:                         # noqa: BLE001
        pass


def _detach() -> None:
    """Fork into a new session so channel teardown on hangup can't kill us mid-push.

    The dialplan backgrounds us with `&`, but Asterisk destroys the call channel
    the instant it hangs up, and that can signal our (still-running) process group
    before our multi-step HA push finishes — which is exactly why a poor call set
    the sensor (first HTTP call) but not the notification (second). setsid() moves
    us out of the channel's process group so we outlive it. Best-effort: no fork ->
    just run inline. Gated on `--detach` so unit tests (which call main() directly)
    never fork the test runner out from under themselves."""
    try:
        if os.fork() > 0:
            os._exit(0)  # parent returns at once -> TrySystem/& unblocks immediately
    except OSError:
        return
    try:
        os.setsid()
    except OSError:
        pass
    try:  # drop the channel's stdio so we hold nothing from it
        null = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            try:
                os.dup2(null, fd)
            except OSError:
                pass
    except OSError:
        pass


def main(argv=None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    if "--detach" in argv:
        _detach()  # only the detached child returns here
    try:
        a = _parse_args(argv)
        rec = build_record(a)
        append_record(rec)
        # Readable proof this program ran and what it decided -- the dialplan's
        # trailing '&' means launch is all it can ever prove.
        append_outcome(rec)
        record_delivery(rec)
        push_ha(rec)
    except (Exception, SystemExit):
        # A hangup handler must never fail loudly. Swallow and move on.
        # (SystemExit too: argparse.error() raises it, and it is BaseException,
        # not Exception — the _BADTOK sanitizer prevents it, this is the net.)
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
