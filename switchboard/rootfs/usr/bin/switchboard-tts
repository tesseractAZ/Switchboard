#!/usr/bin/python3
"""Switchboard offline text-to-speech — speak dynamic strings on the phone line.

The home-automation voice operator must say things that have no canned prompt and
that Asterisk's SayUnixTime/SayNumber can't produce: light names, on/off state,
the room/light lists. There's no cloud TTS on this box, so we use **espeak-ng**
(tiny, offline, musl-friendly) and turn its output into the 8 kHz mono every
phone here hears (G.711 µ-law, wired and SIP alike).

Since v0.122.0 that is the handset announcements' phone-band mastering (v0.121.0,
announce_asterisk): one ffmpeg process shapes the speech for the band and
resamples it, then the speech level is set and the peaks limited. If the
mastering cannot run, or fails, the reply is resampled exactly as before, with
the stdlib only (audioop, linear fallback) — the same approach switchboard-stt
uses going the other way.

    switchboard-tts "Kitchen Lights are on" /tmp/sw-tts-123

writes /tmp/sw-tts-123.wav (8 kHz, 16-bit, mono). The dialplan then plays it with
Playback(/tmp/sw-tts-123). Exit non-zero (and write nothing) if espeak-ng is
missing or fails, so the AGI can fall back to a canned prompt instead of silence.

Nothing written to stderr names the text. Since v0.122.0 the callers do not
capture it: it is theirs, the add-on journal, so a line written here reaches the
Log tab even when a hangup ends the AGI that ran this (Asterisk SIGHUPs the
AGI's own pid, and no AGI handles it). stdout is not theirs to share: it is the
AGI channel, and the callers send this program's to /dev/null.
"""

from __future__ import annotations

import array
import io
import os
import shutil
import stat
import subprocess
import sys
import time
import warnings
import wave

warnings.filterwarnings("ignore", category=DeprecationWarning)

OUT_RATE = 8000
ESPEAK_VOICE = os.environ.get("SW_TTS_VOICE", "en-us")
ESPEAK_WPM = os.environ.get("SW_TTS_WPM", "150")  # words/min — clear on narrowband

# The mastering is the handset announcements' own code (announce_asterisk), loaded
# from the web UI's directory, so a reply and an announcement are shaped by the
# same chain and cannot drift apart.
MASTER_DIR = "/usr/share/switchboard/webui"
# ffmpeg's limit for one reply. The callers allow the whole synthesis 20 s
# (agi_speech, the automation menu; the assistant 25 s) and espeak alone may take
# 15 s, so the announcements' 10 s would let a stalled ffmpeg turn a slow reply
# into a failed one. A reply masters in about 0.1 s on a Home Assistant host.
MASTER_TIMEOUT_S = 3
# After a run past MASTER_TIMEOUT_S, replies skip the mastering for this long, so
# a stalled ffmpeg costs one reply its wait, not every reply after it. Each reply
# is a process of its own, so the pause is the mtime of PAUSE_FILE.
MASTER_PAUSE_S = 600
PAUSE_FILE = "/tmp/switchboard-tts.master-paused"
# Created by the first reply that falls back, just before it writes its line to
# the journal, so the journal gets one line per add-on start (each start is a new
# container with an empty /tmp).
NOTED_FILE = "/tmp/switchboard-tts.unmastered-noted"


def log(msg: str) -> None:
    sys.stderr.write(f"[switchboard-tts] {msg}\n")


def _espeak_bin() -> str | None:
    for name in ("espeak-ng", "espeak"):
        path = shutil.which(name)
        if path:
            return path
    return None


def _linear_resample(data: bytes, in_rate: int, out_rate: int) -> bytes:
    """Mono 16-bit nearest/linear resampler — audioop-free fallback."""
    if in_rate == out_rate or not data:
        return data
    import array
    samples = array.array("h")
    samples.frombytes(data)
    n_in = len(samples)
    n_out = max(1, int(n_in * out_rate / in_rate))
    out = array.array("h", bytes(2 * n_out))
    for i in range(n_out):
        pos = i * in_rate / out_rate
        j = int(pos)
        if j + 1 < n_in:
            frac = pos - j
            out[i] = int(samples[j] * (1 - frac) + samples[j + 1] * frac)
        else:
            out[i] = samples[min(j, n_in - 1)]
    return out.tobytes()


def _resample_unmastered(data: bytes, ch: int, fr: int) -> bytes:
    """16-bit PCM -> 8 kHz mono, unmastered: every reply before v0.122.0, and any
    reply since that the mastering does not take."""
    try:
        import audioop
        if ch != 1:
            data = audioop.tomono(data, 2, 0.5, 0.5)
        if fr != OUT_RATE:
            data, _ = audioop.ratecv(data, 2, 1, fr, OUT_RATE, None)
    except Exception as exc:  # noqa: BLE001 — any audioop issue -> linear path
        log(f"audioop unavailable ({exc}); linear resample")
        if ch != 1:
            # crude downmix: take left channel
            a = array.array("h"); a.frombytes(data)
            data = array.array("h", a[0::ch]).tobytes()
        data = _linear_resample(data, fr, OUT_RATE)
    return data


def _paused() -> bool:
    """True within MASTER_PAUSE_S of a reply whose mastering ran past
    MASTER_TIMEOUT_S (PAUSE_FILE's mtime; a link or anything not a regular file
    counts as no pause)."""
    try:
        st = os.stat(PAUSE_FILE, follow_symlinks=False)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and 0 <= time.time() - st.st_mtime < MASTER_PAUSE_S


def _pause() -> None:
    """Start the pause (see _paused). Best effort: a pause that cannot be kept
    leaves each reply its own MASTER_TIMEOUT_S."""
    try:
        # O_NONBLOCK: a FIFO at PAUSE_FILE fails with ENXIO instead of blocking
        # until a reader opens it; only a regular file has its mtime moved.
        fd = os.open(PAUSE_FILE, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK,
                     0o644)
        try:
            if stat.S_ISREG(os.fstat(fd).st_mode):
                os.utime(fd)
        finally:
            os.close(fd)
    except OSError:
        pass


def _note_unmastered(reason: str) -> None:
    """Say, once per add-on start, that a reply was spoken without the mastering.
    `reason` is a fixed phrase, never the text. If NOTED_FILE cannot be made,
    every fallback says so rather than none."""
    once = True
    try:
        os.close(os.open(NOTED_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o644))
    except FileExistsError:
        return
    except OSError:
        once = False
    log(f"phone-band mastering failed ({reason}), so a reply was spoken unmastered"
        + ("; later fallbacks are not logged" if once else ""))


def _master(data: bytes, rate: int) -> "bytes | None":
    """espeak's mono 16-bit PCM at `rate` (native order, as wave reads it),
    mastered for the phone band, as 8 kHz 16-bit PCM; or None, and the reply takes _resample_unmastered. Never raises.

    Speech with nothing to master (silence, under 20 ms) and speech of the
    announcements' MASTER_MAX_SECONDS or more take the unmastered path without a
    log line, as an announcement does."""
    try:
        if _paused():
            _note_unmastered("paused after an ffmpeg timeout")
            return None
        if MASTER_DIR not in sys.path:
            sys.path.insert(0, MASTER_DIR)
        try:
            import announce_asterisk as aa
        except Exception:  # noqa: BLE001 — missing, or broken by an image change
            _note_unmastered("the mastering code could not be loaded")
            return None
        samples = array.array("h")
        samples.frombytes(data)  # wave's readframes gives native-order samples
        if (aa._nothing_to_master(samples, rate)
                or len(samples) >= aa.MASTER_MAX_SECONDS * rate):
            return None
        pcm = array.array("h", samples)
        if sys.byteorder == "big":
            pcm.byteswap()  # ffmpeg reads s16le
        out, reason = aa._master_speech(pcm.tobytes(), rate, len(samples),
                                        timeout=MASTER_TIMEOUT_S)
        if out is None:
            if reason == aa._TIMED_OUT:
                _pause()
            if reason != aa._TOO_LONG:
                _note_unmastered(reason)
            return None
        return out.tobytes()  # native order, as wave's writeframes expects
    except Exception as exc:  # noqa: BLE001 — a reply must not be lost to the mastering
        _note_unmastered(f"mastering error {type(exc).__name__}")
        return None


def synthesize(text: str, out_base: str) -> bool:
    text = (text or "").strip()
    if not text:
        return False
    espeak = _espeak_bin()
    if not espeak:
        log("espeak-ng not installed; cannot synthesize")
        return False
    try:
        proc = subprocess.run(
            # "--": never read the text as an option, even when it starts with "-".
            [espeak, "-v", ESPEAK_VOICE, "-s", str(ESPEAK_WPM), "--stdout", "--", text],
            capture_output=True, stdin=subprocess.DEVNULL, timeout=15,
        )
    except subprocess.TimeoutExpired:
        # Not `{exc}`: a TimeoutExpired renders its whole command line, and the
        # text being spoken is the last argument on it. This stderr reaches the
        # add-on journal through the AGI that ran it, and the assistant's replies
        # can quote what the caller said (2026-09-14). Each caller logs the text
        # itself, under its own policy.
        log("espeak timed out after 15 s")
        return False
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"espeak failed: {exc}")
        return False
    if proc.returncode != 0 or not proc.stdout:
        log(f"espeak returned {proc.returncode}, {len(proc.stdout)} bytes")
        return False

    # espeak-ng emits a RIFF wav (typically 22050 Hz, 16-bit, mono). Resample to
    # 8 kHz mono for the telephone path.
    try:
        with wave.open(io.BytesIO(proc.stdout), "rb") as w:
            ch, sw, fr = w.getnchannels(), w.getsampwidth(), w.getframerate()
            data = w.readframes(w.getnframes())
    except (wave.Error, EOFError, OSError) as exc:
        log(f"cannot parse espeak wav: {exc}")
        return False

    if sw != 2:  # we only handle 16-bit; bail rather than emit noise
        log(f"unexpected sample width {sw}")
        return False
    mastered = _master(data, fr) if ch == 1 else None  # espeak-ng writes mono
    data = mastered if mastered is not None else _resample_unmastered(data, ch, fr)

    out_path = out_base if out_base.endswith(".wav") else out_base + ".wav"
    tmp = out_path + ".part"
    try:
        with wave.open(tmp, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(OUT_RATE)
            w.writeframes(data)
        os.replace(tmp, out_path)
    except (OSError, wave.Error) as exc:
        log(f"cannot write {out_path}: {exc}")
        return False
    return True


def main() -> int:
    if len(sys.argv) < 3:
        log('usage: switchboard-tts "text to speak" /path/out (writes /path/out.wav)')
        return 2
    text = sys.argv[1]
    out_base = sys.argv[2]
    return 0 if synthesize(text, out_base) else 1


if __name__ == "__main__":
    raise SystemExit(main())
