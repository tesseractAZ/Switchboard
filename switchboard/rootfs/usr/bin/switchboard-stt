#!/usr/bin/python3
"""Switchboard operator — offline speech-to-text wrapper.

The one and only place the recognizer is invoked, behind a fixed contract so the
call-control layer (the AGI) stays 100% stdlib and engine-agnostic:

    switchboard-stt --in <recorded.wav>   ->   prints a room extension (or nothing)

Engine: whisper.cpp (built from source in the add-on image; musl-native, unlike
Vosk whose only Linux wheels are glibc manylinux). whisper.cpp wants 16 kHz mono
WAV; Asterisk records the 8 kHz telephone channel, so we resample here with the
stdlib (audioop, linear fallback) — no sox/ffmpeg dependency. Recognition is
biased toward the configured room names via whisper's --prompt, then the result
is resolved to an extension by the shared, unit-tested matcher.
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import tempfile
import warnings
import wave

# audioop (used for 8k->16k resampling) is deprecation-warned on py3.12 but is
# the right stdlib tool on the Alpine base; silence the warning so each call
# doesn't spam the Asterisk log.
warnings.filterwarnings("ignore", category=DeprecationWarning)

sys.path.insert(0, "/usr/share/switchboard/operator")
import match as matcher  # noqa: E402  (shared, unit-tested room matcher)
# Pure automation-intent gate. Best-effort: rooms mode still resolves rooms even
# if this can't import (it just won't short-circuit to the automation flow).
try:
    import lights_match  # noqa: E402
except Exception:  # noqa: BLE001
    lights_match = None

WHISPER_BIN = os.environ.get("SW_WHISPER_BIN", "/usr/bin/whisper-cli")
WHISPER_MODEL = os.environ.get("SW_WHISPER_MODEL", "/usr/share/whisper/model.bin")
OPERATOR_JSON = "/run/switchboard/operator.json"
# The staged voice-feature settings — the ONLY configuration channel that reaches
# this process. An AGI forks it as the asterisk user, so no s6 env export arrives,
# and /run/switchboard/options-effective.json (0600 root) cannot be read.
FEATURES = "/run/switchboard/features.json"

# Resident whisper-server (loopback HTTP). When up, it transcribes without
# reloading the 142 MB model per call. '0' disables it (pure whisper-cli).
WHISPER_SERVER = os.environ.get("SW_WHISPER_SERVER", "1") != "0"
WHISPER_SERVER_HOST = os.environ.get("SW_WHISPER_SERVER_HOST", "127.0.0.1")
WHISPER_SERVER_PORT = int(os.environ.get("SW_WHISPER_PORT", "8126") or "8126")
# Split budget so server-timeout + CLI-fallback can NEVER exceed the AGI's ~25s
# hard kill: a fast CONNECT failure (server down/loading) falls back to the CLI
# (~instant + 20s); a POST-connect READ hang returns '' instead (the AGI attempt
# loop re-records) and never stacks a 20s CLI run on top.
WHISPER_CONNECT_TIMEOUT = float(os.environ.get("SW_WHISPER_CONNECT_TIMEOUT", "2"))
# The old 8 expired MID-DECODE on 11/68 live operator requests (33% on the worst
# day), forcing re-record loops. 24 is ~1.5x the worst decode MEASURED IN
# PRODUCTION since: 16s for a full 10s recording (2026-08-12 18:17:33->18:17:49).
# That is real headroom but NOT the 3x originally claimed here — if a future
# measurement approaches ~20s, raise this rather than assume margin that is not
# there. A genuine hang still returns '' with no CLI stacked.
WHISPER_READ_TIMEOUT = float(os.environ.get("SW_WHISPER_READ_TIMEOUT", "24"))

# transcribe() dispatch sentinels (not transcripts).
_TRY_CLI = object()   # server unreachable at connect -> use whisper-cli
_GIVE_UP = object()   # server accepted then hung -> return '' (AGI re-records)


def log(msg: str) -> None:
    sys.stderr.write(f"[switchboard-stt] {msg}\n")


def transcripts_allowed() -> bool:
    """May the words this process recognised go to its stderr?

    ★ STDERR IS NOT A PRIVATE PLACE (2026-09-14). Every AGI that runs this
    forwards its stderr, and Asterisk's stderr is the add-on journal: served by
    the Supervisor to anyone with log access, kept about two days, and kept
    across a host reboot. The `heard=` lines below put every operator, wake-up,
    home-automation, status, announce, directory and assistant recognition there verbatim,
    whatever `assistant_transcripts` said — that option reached only the
    assistant's private ledger, while comments across the repo called the
    journal short-lived.

    So the words follow the option. FAILS CLOSED: only a policy that was read and
    says true lets them through, because the destination is the exposed one. The
    outcome and the length are logged either way, which keeps the line
    diagnostic.
    """
    try:
        with open(FEATURES, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return False
    section = data.get("assistant") if isinstance(data, dict) else None
    return isinstance(section, dict) and section.get("transcripts") is True


def said(text: str, words: bool) -> str:
    """What a log line may say about recognised `text`: the words, or only how
    many characters there were (the shape of assistant_log._redact). The ONLY
    way recognised text may reach stderr; test_privacy_invariants scans for it."""
    return repr(text) if words else f"<{len(text)} chars>"


def load_operator() -> dict:
    try:
        with open(OPERATOR_JSON) as fh:
            return json.load(fh)
    except (OSError, ValueError) as exc:
        log(f"cannot read {OPERATOR_JSON}: {exc}")
        return {"rooms": [], "synonyms": {}, "threshold": 0.6}


def _linear_resample(data: bytes, in_rate: int, out_rate: int) -> bytes:
    """Mono 16-bit linear resampler — fallback if audioop is unavailable."""
    import array
    if in_rate == out_rate:
        return data
    src = array.array("h")
    src.frombytes(data)
    ratio = out_rate / in_rate
    out_len = int(len(src) * ratio)
    out = array.array("h", bytes(2 * out_len))
    for i in range(out_len):
        pos = i / ratio
        j = int(pos)
        frac = pos - j
        a = src[j] if j < len(src) else 0
        b = src[j + 1] if j + 1 < len(src) else a
        out[i] = int(a + (b - a) * frac)
    return out.tobytes()


def to_16k_wav(src_path: str, dst_path: str) -> bool:
    """Read Asterisk's recorded WAV and write a 16 kHz mono 16-bit WAV for whisper."""
    try:
        with wave.open(src_path, "rb") as w:
            nch, sw, fr = w.getnchannels(), w.getsampwidth(), w.getframerate()
            data = w.readframes(w.getnframes())
    except (OSError, wave.Error) as exc:
        log(f"cannot read recording {src_path}: {exc}")
        return False
    if not data:
        return False
    try:
        import audioop  # deprecated in 3.13+, present on Alpine 3.21's py3.12
        if nch == 2:
            data = audioop.tomono(data, sw, 0.5, 0.5)
        if sw != 2:
            data = audioop.lin2lin(data, sw, 2)
        if fr != 16000:
            data, _ = audioop.ratecv(data, 2, 1, fr, 16000, None)
    except Exception as exc:  # noqa: BLE001  (any audioop issue -> linear path)
        log(f"audioop unavailable ({exc}); using linear resampler")
        data = _linear_resample(data, fr, 16000)
    with wave.open(dst_path, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(16000)
        w.writeframes(data)
    return True


_BRACKET = re.compile(r"\[[^\]]*\]|\([^)]*\)")  # [BLANK_AUDIO], (speaking), etc.


def _normalize(raw: str) -> str:
    """Strip whisper's [BLANK_AUDIO]/(noise) brackets + collapse whitespace.

    Applied to BOTH the server and CLI transcripts so the text feeding the
    matcher / timeparse / lights_match is byte-identical regardless of path."""
    return " ".join(_BRACKET.sub(" ", raw or "").split()).strip()


def _build_multipart(wav_bytes: bytes, prompt: str) -> tuple[str, bytes]:
    """A multipart/form-data body for whisper-server's /inference: the ready
    16 kHz mono WAV plus the same recognition params the CLI uses. Pure (no I/O)
    so it is unit-testable. Returns (boundary, body)."""
    boundary = "----swstt7f3a9c2e1b"
    crlf = b"\r\n"
    parts = []

    def field(name: str, value: str) -> None:
        parts.append(b"--" + boundary.encode() + crlf)
        parts.append(f'Content-Disposition: form-data; name="{name}"'.encode() + crlf + crlf)
        parts.append(value.encode() + crlf)

    parts.append(b"--" + boundary.encode() + crlf)
    parts.append(b'Content-Disposition: form-data; name="file"; filename="a.wav"' + crlf)
    parts.append(b"Content-Type: audio/wav" + crlf + crlf)
    parts.append(wav_bytes + crlf)
    field("response_format", "json")
    field("temperature", "0")
    field("language", "en")
    if prompt:
        field("prompt", prompt)   # whisper-server initial-prompt bias
    parts.append(b"--" + boundary.encode() + b"--" + crlf)
    return boundary, b"".join(parts)


def _transcribe_server(wav16: str, prompt: str):
    """POST the WAV to the resident whisper-server. Returns the normalized text
    (possibly ''), or a sentinel: _TRY_CLI on a CONNECT-phase failure (server
    down/still loading -> caller falls back to whisper-cli), _GIVE_UP on a
    POST-connect read hang (return '' so the AGI re-records, no stacked CLI)."""
    try:
        with open(wav16, "rb") as fh:
            wav_bytes = fh.read()
    except OSError:
        return _TRY_CLI
    boundary, body = _build_multipart(wav_bytes, prompt)
    conn = http.client.HTTPConnection(WHISPER_SERVER_HOST, WHISPER_SERVER_PORT,
                                      timeout=WHISPER_CONNECT_TIMEOUT)
    try:
        conn.connect()  # CONNECT phase: refused/timeout here == server not ready
    except (OSError, socket.timeout) as exc:
        log(f"whisper-server unreachable ({exc}); falling back to whisper-cli")
        conn.close()
        return _TRY_CLI
    try:
        conn.sock.settimeout(WHISPER_READ_TIMEOUT)  # POST-connect: read budget
        conn.request("POST", "/inference", body=body,
                     headers={"Content-Type": f"multipart/form-data; boundary={boundary}",
                              "Content-Length": str(len(body))})
        resp = conn.getresponse()
        status = resp.status
        data = resp.read()
    except (socket.timeout, OSError, http.client.HTTPException) as exc:
        # Once CONNECTED, NEVER stack a 20s whisper-cli run on top of the time
        # already spent post-connect — that could blow the AGI's ~25s hard kill.
        # A hung / reset (ConnectionResetError, RemoteDisconnected) / truncated
        # (IncompleteRead) server returns '' so the AGI's re-record loop handles
        # it. The CLI fallback is ONLY for a server unreachable at CONNECT (above,
        # ~instant, so the CLI keeps its full budget). A slow decode is NOT ruled
        # out as a cause here: production has measured 16s against the 24s budget,
        # so this path can legitimately be a decode that ran long.
        log(f"whisper-server post-connect failure ({exc}); returning empty (re-record)")
        return _GIVE_UP
    finally:
        conn.close()
    if status != 200:
        log(f"whisper-server HTTP {status}; returning empty (re-record)")
        return _GIVE_UP
    try:
        text = json.loads(data).get("text", "")
    except (ValueError, AttributeError):
        text = data.decode("utf-8", "replace")   # non-JSON body: use raw
    return _normalize(text)


def _transcribe_cli(wav16: str, prompt: str) -> str:
    """The original path: spawn whisper-cli (reloads the model each call). Kept
    verbatim as the always-available fallback."""
    cmd = [
        WHISPER_BIN, "-m", WHISPER_MODEL, "-f", wav16,
        "-l", "en", "-nt", "-bs", "1",
        "-t", str(min(4, os.cpu_count() or 2)),
    ]
    if prompt:
        cmd += ["--prompt", prompt]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except (subprocess.TimeoutExpired, OSError) as exc:
        log(f"whisper failed: {exc}")
        return ""
    return _normalize(proc.stdout)


def transcribe(wav16: str, prompt: str) -> str:
    """Recognize `wav16`. Prefer the resident whisper-server (no per-call model
    reload); fall back to whisper-cli on a connect-phase miss; return '' (no CLI)
    on a server hang so the caller's re-record loop handles it within budget."""
    if WHISPER_SERVER:
        result = _transcribe_server(wav16, prompt)
        if result is _GIVE_UP:
            return ""
        if result is not _TRY_CLI:
            return result
    return _transcribe_cli(wav16, prompt)


def _recording_to_text(infile: str, prompt: str) -> str:
    """Resample the recording to 16 kHz and transcribe it. Shared by both modes."""
    with tempfile.NamedTemporaryFile(suffix=".wav", dir="/run/switchboard/asr",
                                     delete=False) as tf:
        wav16 = tf.name
    try:
        if not to_16k_wav(infile, wav16):
            return ""
        return transcribe(wav16, prompt)
    finally:
        try:
            os.unlink(wav16)
        except OSError:
            pass


# Time vocabulary to bias whisper for the wake-up flow.
# The caller is offered "To set a new time, say it now. To cancel, say cancel."
# (sw-wakeup-change), and time_reply below accepts cancel/clear/remove/delete/
# never mind/stop/forget — but whisper needs a PRIOR for those words or it
# returns a sound-alike. Observed live 2026-08-21 05:58: a caller said "cancel"
# twice at the change prompt and got 'Campbell.' then 'Campful.', so nothing
# matched, both attempts burned, and the 06:00 wake-up they were trying to call
# off stayed set. This is the identical failure the lights menu already
# documents for "list" ('Left'/'Lift'); priming the vocabulary was the first
# fix. It is not enough on its own: on 2026-11-23 06:29, with this prompt sent,
# "cancel" came back as "Okay, I'm full." then 'Campful.' again, and the 06:30
# wake-up rang. time_reply's sound-alike tier is the second. Times still win —
# timeparse runs first.
_TIME_PROMPT = ("A time of day, for example: seven a.m., six thirty, "
                "quarter past seven, ten forty five, half past six, noon, midnight. "
                "Or say cancel to clear it.")

# ---- The wake-up reply: a time, cancel, a sound-alike of cancel, or nothing ----
#
# WHY CANCEL NEEDS MORE THAN THE WORD. Every call reaches whisper as G.711 at
# 8 kHz, so nothing above 4 kHz survives — where most of an /s/ lives. "Cancel"
# arrives with its middle consonant smeared or gone and its vowels intact, and
# whisper fills the gap with a word it knows: 'Campbell.', 'Campful.' (2026-08-21
# and 2026-11-23, live), "Okay, I'm full." (2026-11-23, live: the /k/ swallowed
# by "okay"), 'Pencil.' and 'Cancellate.' (synthetic voices through the same
# channel and recogniser, 2026-11-23). The prompt prime above does not stop it.
#
# THE COST IS LOPSIDED. A missed cancel rings a caller who is already awake. A
# FALSE cancel deletes the wake-up, and they oversleep. So the new tier is narrow
# and fenced:
#   * timeparse runs first, so nothing it reads as a time is ever a cancel;
#   * a sound-alike is a separate answer, CANCEL-LIKE, which the wake-up AGI acts
#     on only when a wake-up is set — the one time cancel was offered;
#   * it must be the WHOLE reply (at most two words once fillers are dropped);
#   * a "don't", "not", "keep" or "leave" anywhere stops any cancel;
#   * an echo of this prompt's own framing does nothing at all.
# The literal tier is the regex the wake-up flow has always used, unchanged.
_CANCEL_WORDS = re.compile(r"\b(cancel|clear|remove|delete|never mind|nevermind|stop|forget)\b")
# Filler a short reply may carry around the word. "no", "dont" and "not" are NOT
# filler: they carry meaning.
_CANCEL_FILLER = frozenset({"okay", "ok", "um", "uh", "so", "oh", "please", "yeah",
                            "hmm", "well", "the", "it", "just", "that", "my", "wake",
                            "up", "call", "alarm"})
# Anywhere in the reply, these stop a cancel: "I don't want to cancel",
# "never mind, keep it". Both directions of doubt end in a retry, never a delete.
_CANCEL_VETO = frozenset({"dont", "not", "didnt", "wont", "doesnt", "keep", "leave"})
# The prompt's own framing. whisper can hand a prompt back on a near-silent
# recording; read as a reply, the full prompt parses as 18:53 and its tail as a
# cancel. Any 4-word run of these does nothing. Each must stay a run of
# _TIME_PROMPT's words (test_wakeup_cancel holds it), so a prompt edit forces an
# update here.
_PROMPT_FRAMING = ("a time of day for example", "or say cancel to clear it")
# One word, or two run together ("Can sell", "Can't feel"), shaped like
# "cancel": a /k/ or /p/ onset, a vowel, a nasal, then the smeared middle — a
# fricative or a lip stop (Campbell's b), with an optional stop after the nasal
# (the p of Camp-, the t of Can't) — a vowel, and a final l (Console's e
# allowed). Built from the observed renderings, not from English: it accepts
# Campbell, Campful, Canful, Pencil, Council, Console, Can sell, Can't feel and
# rejects candle, castle, camel, canal, channel, cancer, Kansas, campus,
# careful, handful, gamble, tinsel, dental (test_wakeup_cancel lists them all).
# Over the 234,454 words of an English dictionary it accepts 25, every one a
# word nobody says to a wake-up prompt (cymbal, pinball, painful ...).
_CANCEL_SHAPE = re.compile(
    r"(?:ck|[ckqp])[aeiouy]{1,2}[nm]{1,2}[pbkt]?"
    r"(?:ph|sh|[szfvb]|c(?=[eiy])){1,2}[aeiouy]{1,2}l{1,2}e?")
# What is left of the word when "okay" has swallowed its /k/: "Okay, I'm full."
_CANCEL_TAIL = re.compile(r"(?:ph|sh|[szfvb]|c(?=[eiy])){1,2}[aeiouy]{1,2}l{1,2}")


def _reply_tokens(text: str) -> list[str]:
    """Lowercase letter-runs, apostrophes dropped (don't -> dont), O.K. -> ok."""
    t = (text or "").lower().replace("’", "'").replace("'", "")
    t = re.sub(r"\bo\.?\s?k\b\.?", " ok ", t)
    return [w for w in re.split(r"[^a-z]+", t) if w]


def _content(tokens: list[str]) -> list[str]:
    """`tokens` without filler, and without a word repeating the one before it
    ("Cancel, cancel." is one cancel)."""
    out: list[str] = []
    for w in tokens:
        if w in _CANCEL_FILLER or (out and out[-1] == w):
            continue
        out.append(w)
    return out


def _grams(words: list[str], n: int = 4) -> set:
    return {tuple(words[i:i + n]) for i in range(len(words) - n + 1)}


_ECHO = set().union(*(_grams(p.split()) for p in _PROMPT_FRAMING))


def _sounds_like_cancel(tokens: list[str]) -> bool:
    """Is the whole reply a sound-alike of "cancel"? Pure; see _CANCEL_SHAPE."""
    rest = _content(tokens)
    if not rest or len(rest) > 2:
        return False
    if len(rest) == 1:
        # Cancelled., Canceled., Cancellate., Cancellation please. — but only as
        # the whole reply: "Is it cancelled?" asks, it does not tell.
        return rest[0].startswith("cancel") or bool(_CANCEL_SHAPE.fullmatch(rest[0]))
    if _CANCEL_SHAPE.fullmatch(rest[0] + rest[1]):
        return True       # Can sell., Camp full.
    # "Okay, cancel" with the /k/ absorbed into "okay": "Okay, I'm full."
    i = tokens.index(rest[0])
    return (rest[0] == "im" and i > 0 and tokens[i - 1] in ("okay", "ok")
            and bool(_CANCEL_TAIL.fullmatch(rest[1])))


def time_reply(text: str, parse) -> tuple[str, str]:
    """The wake-up flow's decision on one transcript. Pure (no I/O, no logging):
    `parse` is timeparse.parse, passed in so tests can stub it.

    Returns (stdout, outcome). stdout is what the wake-up AGI reads: 'HH:MM',
    'CANCEL', 'CANCEL-LIKE', or '' (nothing). outcome is a constant label for
    the log line — time, cancel, cancel-like, echo, negated or none — and never
    a word from the transcript."""
    tokens = _reply_tokens(text)
    if _grams(tokens) & _ECHO:
        return "", "echo"
    hhmm = parse(text)
    if hhmm:
        return hhmm, "time"
    joined = " ".join(tokens)
    literal = bool(_CANCEL_WORDS.search(joined))
    alike = not literal and _sounds_like_cancel(tokens)
    if literal or alike:
        if (_CANCEL_VETO & set(tokens)) or "do not" in joined:
            return "", "negated"
        return ("CANCEL", "cancel") if literal else ("CANCEL-LIKE", "cancel-like")
    return "", "none"

# Above this match score a room result is treated as CONFIDENT and wins over the
# feature words; below it (but still >= the room threshold) the feature words get
# first refusal. match._score bumps a real match to >= 0.9 — exact fuzzy = 1.0,
# every-candidate-word-heard = 0.95, clipped word-prefix = 0.9 — while a pure
# character-overlap collision (a bare feature word vs an unrelated room name)
# tops out around 0.67, so 0.9 is a clean separator. See resolve_rooms_text.
ROOM_CONFIDENT = 0.9


def resolve_rooms_text(text: str, rooms: list, synonyms: dict | None = None,
                       threshold: float = 0.6) -> str:
    """Pure rooms-mode decision (importable for tests, no I/O).

    A single transcript decides the operator's action so it only runs whisper ONCE:

      * a wake-up request                  -> 'wakeup'
      * a clear automation/lights request  -> 'automation'
      * a CONFIDENT room name              -> that room's extension
      * another feature (clock / status / directory / announce / page)
                                           -> that feature token
      * a lower-confidence (misheard/clipped) room name -> its extension
      * anything else                      -> '' (no match)

    The dialplan routes each feature token to that feature's flow (see
    render_operator_context); a room extension is Dialed as before.

    Room vs feature is an intent-vs-entity collision, resolved by the match
    *score* rather than a fixed order — because neither pure order is right:

      * feature-first would let a bare feature word swallow a handset genuinely
        NAMED after it (a room called "Weather" → dial-a-status, never the room);
      * room-first would let match()'s fuzzy scorer misroute a bare feature word
        to an unrelated room that merely shares letters — e.g. "page" scores 0.60
        against a room named "Garage" (exactly the 0.6 room threshold, which it clears), so the
        caller who said "page" would reach the Garage phone, not the intercom.

    So: a CONFIDENT room match (exact name/synonym, full-word, or a clipped
    prefix — all score >= ROOM_CONFIDENT) wins outright; only then do the feature
    words get a look (they beat a merely-fuzzy room collision, which sits well
    below ROOM_CONFIDENT); and a genuine but lower-confidence room match still
    connects after that. The automation check stays conservative (lights_match)
    so an ordinary room name like "garage"/"office" still resolves to its ext."""
    if matcher.is_wakeup_request(text):
        return "wakeup"
    if lights_match is not None and lights_match.is_automation_request(text):
        return "automation"
    ext, score, _reason = matcher.match(text, rooms, synonyms or {}, threshold)
    if ext and score >= ROOM_CONFIDENT:
        return ext                 # exact/synonym/full-word/clipped-prefix room
    feat = matcher.feature_intent(text)
    if feat:
        return feat                # clock | status | directory | announce | page
    if ext:
        return ext                 # lower-confidence but real room (e.g. "kitchin")
    return ""


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--in", dest="infile", required=True)
    ap.add_argument("--mode", default="rooms", choices=["rooms", "time", "transcribe"])
    # Optional whisper --prompt bias (space-separated words) — used by the
    # home-automation flow to seed light/area vocabulary for better recognition.
    ap.add_argument("--bias", default="")
    args = ap.parse_args()
    words = transcripts_allowed()

    if args.mode == "transcribe":
        # Raw transcript only — no room/time resolution. The home-automation AGI
        # matches the text itself (area/light/intent) via lights_match.py. The
        # optional --bias seeds whisper's --prompt with the live light/area names.
        prompt = " ".join(args.bias.split())
        text = _recording_to_text(args.infile, prompt)
        log(f"transcribe heard={said(text, words)}")
        if text:
            print(text)
        return 0

    if args.mode == "time":
        # Recognize a spoken time -> "HH:MM" (24h) for the wake-up flow.
        sys.path.insert(0, "/usr/share/switchboard/wakeup")
        import timeparse  # noqa: E402
        text = _recording_to_text(args.infile, _TIME_PROMPT)
        out, outcome = time_reply(text, timeparse.parse)
        # One said()-gated line per outcome (test_privacy_invariants counts them).
        if outcome == "time":
            log(f"heard={said(text, words)} -> time={out}")
        elif outcome == "cancel":
            log(f"heard={said(text, words)} -> CANCEL")
        elif outcome == "cancel-like":
            log(f"heard={said(text, words)} -> CANCEL-LIKE")
        elif outcome == "negated":
            log(f"heard={said(text, words)} -> ignored (negated cancel)")
        elif outcome == "echo":
            log(f"heard={said(text, words)} -> ignored (prompt echo)")
        else:
            log(f"heard={said(text, words)} -> time=None")
        if out:
            print(out)
        return 0

    # rooms mode (the voice operator).
    op = load_operator()
    rooms = op.get("rooms") or []
    synonyms = op.get("synonyms") or {}
    threshold = float(op.get("threshold", 0.6))
    if not rooms:
        log("no rooms configured; nothing to match")
        return 0

    # Bias the recognizer toward the actual room vocabulary.
    vocab = [str(r.get("name", "")) for r in rooms]
    for extras in synonyms.values():
        vocab += list(extras)
    prompt = "Rooms: " + ", ".join(v for v in vocab if v) + "."

    text = _recording_to_text(args.infile, prompt)
    # One whisper pass decides automation-vs-room so the operator AGI doesn't have
    # to transcribe twice: a clear "lights"/"automation" prints the literal token
    # 'automation'; otherwise we resolve the room extension exactly as before.
    result = resolve_rooms_text(text, rooms, synonyms, threshold)
    if result == "automation":
        log(f"heard={said(text, words)} -> automation")
    else:
        log(f"heard={said(text, words)} -> ext={result or None}")
    if result:
        print(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
