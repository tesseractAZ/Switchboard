#!/usr/bin/env python3
"""Quiesce Switchboard's durable state just before the Supervisor snapshots it.

Every backup of this add-on runs HOT: an audit of 3975 Supervisor lines found 18
`Stopping app_` entries and not one of them was Switchboard, and 13 of 16 add-on
updates in the same window took no pre-update backup at all. So the call-quality
ledger and the durable Asterisk log are copied while they are being appended to,
with no flush and no fsync barrier.

Taking the add-on COLD for a backup was rejected deliberately: it would drop dial
tone -- including the 911 path -- for the ~15 s the image export takes, every
night. A dropped phone line is a worse failure than a torn trailing log line.

So this does the cheap, safe half instead: flush the page cache for the state
directory to disk so everything written up to this instant is durable in the
snapshot. A record still being written when the copy starts can be torn, but
every reader already tolerates that -- load_callqos_ts() and the ledger readers
skip malformed lines by design -- and the torn record is at most the newest one.

Never fails the backup: any error is logged and swallowed. A backup that runs is
worth far more than one blocked by a hook."""
import os
import sys

STATE_DIR = os.environ.get("SWITCHBOARD_STATE", "/data/state")
# /share now holds the readable mirrors this add-on writes -- the forensic
# Asterisk log, the heartbeat, the callqos outcomes, the delivery outcomes. They
# are mirrors rather than sources of truth (the authoritative ledger is under
# /data/state and is quiesced above), but the Supervisor archives the share
# folder at a DIFFERENT point in the backup than the app image, so without this
# they are the only Switchboard files copied with no flush at all. Flushing them
# costs a handful of fsyncs on files that are appended a few times an hour.
SHARE_DIR = os.environ.get("SWITCHBOARD_SHARE", "/share/switchboard")
# /share is mapped writable and is readable from OUTSIDE the container, unlike
# /data. That matters twice over: it is the only way to observe that these hooks
# ran at all (a hook runs via `docker exec`, whose stdout does NOT reach the
# add-on's log stream, so printing alone is unverifiable), and it gives an audit
# both edges of the backup window -- previously the Supervisor log showed the
# image export starting but nothing recorded when this add-on's own state
# stopped being copied, so a torn ledger line could not be attributed.
STAMP_PATH = os.environ.get("SWITCHBOARD_BACKUP_STAMP",
                            "/share/switchboard/backup-window.jsonl")


def _stamp(phase: str, synced: int = -1) -> None:
    """Append one backup-window record. Best-effort: never fails the backup."""
    import datetime
    import json
    rec = {"phase": phase,
           "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(
               timespec="seconds")}
    if synced >= 0:
        rec["synced_files"] = synced
    try:
        os.makedirs(os.path.dirname(STAMP_PATH), exist_ok=True)
        with open(STAMP_PATH, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(rec) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
    except OSError as exc:
        print(f"[switchboard-backup-pre] stamp: {exc}", flush=True)


def _self_check() -> None:
    """Assert this hook is where config.yaml says it is, and is executable.

    A hook the Supervisor cannot exec fails at BACKUP time, not at build time --
    and it fails silently, because a hook runs via `docker exec` whose stdout
    never reaches the add-on log. v0.58.0 shipped hooks whose firing was
    unobservable for exactly this reason, and whether they ever ran is now
    permanently unknowable. This makes the next such mistake loud instead."""
    for path in ("/usr/bin/switchboard-backup-pre",
                 "/usr/bin/switchboard-backup-post"):
        if not os.path.isfile(path):
            print(f"[switchboard-backup-pre] SELF-CHECK: {path} declared in "
                  "config.yaml but MISSING", flush=True)
        elif not os.access(path, os.X_OK):
            print(f"[switchboard-backup-pre] SELF-CHECK: {path} is not "
                  "executable — the Supervisor cannot run it", flush=True)


def _fsync_dir(path: str) -> int:
    """fsync every regular file in `path`, then the directory entry itself.

    The directory matters as much as the contents: an atomic-replace writer
    leaves the new name in the dir entry, which is a separate durability concern
    from the data blocks. Returns how many files were flushed."""
    synced = 0
    try:
        names = sorted(os.listdir(path))
    except OSError as exc:
        print(f"[switchboard-backup-pre] {path} unreadable ({exc}); nothing to "
              "flush", flush=True)
        return 0
    for name in names:
        fp = os.path.join(path, name)
        if not os.path.isfile(fp):
            continue
        try:
            fd = os.open(fp, os.O_RDONLY)
        except OSError:
            continue
        try:
            os.fsync(fd)
            synced += 1
        except OSError as exc:
            print(f"[switchboard-backup-pre] fsync {name}: {exc}", flush=True)
        finally:
            os.close(fd)
    try:
        dfd = os.open(path, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError as exc:
        print(f"[switchboard-backup-pre] fsync dir {path}: {exc}", flush=True)
    return synced


def main() -> int:
    _self_check()
    synced = 0
    try:
        names = sorted(os.listdir(STATE_DIR))
    except OSError as exc:
        print(f"[switchboard-backup-pre] state dir unreadable ({exc}); nothing to "
              "flush", flush=True)
        return 0
    for name in names:
        path = os.path.join(STATE_DIR, name)
        if not os.path.isfile(path):
            continue
        try:
            fd = os.open(path, os.O_RDONLY)
        except OSError:
            continue
        try:
            os.fsync(fd)
            synced += 1
        except OSError as exc:
            print(f"[switchboard-backup-pre] fsync {name}: {exc}", flush=True)
        finally:
            os.close(fd)
    # Also fsync the directory itself so renames/creations are durable, not just
    # file contents -- an atomic-replace writer leaves the new name in the dir
    # entry, which is a separate durability concern from the data blocks.
    try:
        dfd = os.open(STATE_DIR, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError as exc:
        print(f"[switchboard-backup-pre] fsync dir: {exc}", flush=True)
    shared = _fsync_dir(SHARE_DIR)
    synced += shared
    print(f"[switchboard-backup-pre] flushed {synced} file(s) "
          f"({STATE_DIR} + {shared} in {SHARE_DIR})", flush=True)
    _stamp("pre", synced)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # never block a backup
        print(f"[switchboard-backup-pre] non-fatal: {exc}", flush=True)
        sys.exit(0)
