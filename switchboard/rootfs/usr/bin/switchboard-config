#!/usr/bin/python3
"""Render Asterisk configuration for Switchboard from the add-on options.

The add-on options (/data/options.json) are the single source of truth. On every
start we regenerate /etc/asterisk/{pjsip,extensions,rtp,manager,logger}.conf so
the running PBX always matches the declared config.

Design notes
------------
* PJSIP only. chan_sip is removed in modern Asterisk; every endpoint and the
  optional trunk are res_pjsip.
* Analog FXS ports register *to* us, so each room is a PJSIP endpoint with a
  dynamic AOR and inbound auth.
* G.711 µ-law only, everywhere. Every endpoint (rooms + trunk) is pinned to
  ``allow = ulaw`` so no call ever transcodes — µ-law is the baseline the analog
  FXS ports, the cordless, the softphone, and the PSTN trunk all speak, and HD
  codecs carry no extra fidelity from an antique analog handset anyway.
* AMI is bound to 127.0.0.1 only and used by the Ingress UI for live status.
"""

from __future__ import annotations

import json
import os
import pwd
import stat
import re
import secrets
import string
from pathlib import Path

OPTIONS_PATH = Path("/data/options.json")
# Optional admin overlay, deep-merged OVER options.json (see load_options). It
# lives in the app_config map (host: /addon_configs/<slug>/) precisely so an
# administrator with shell access can change effective options when the
# Supervisor options API isn't reachable (HA 2026.x rejects long-lived tokens on
# the /api/hassio proxy). JSON, not YAML: the image has no YAML parser.
OVERLAY_PATH = Path("/config/options-overlay.json")
# The post-overlay options snapshot for the s6 run scripts (bashio::config reads
# options.json directly and would silently bypass the overlay; switchboard-opt
# reads this instead).
EFFECTIVE_PATH = Path("/run/switchboard/options-effective.json")
ASTERISK_ETC = Path("/etc/asterisk")
RUN_DIR = Path("/run/switchboard")
# Persistent JSON stores (wake-ups, MWI flags) that BOTH the root services AND
# asterisk-user processes write — see ensure_state_dir().
DATA_DIR = Path("/data")
STATE_DIR = DATA_DIR / "state"

# G.711 µ-law is the ONLY codec — every endpoint renders `allow = ulaw`, so no
# call transcodes. This is deliberate and not configurable (see module docstring).
CODEC_ALLOW = "ulaw"


def log(msg: str) -> None:
    print(f"[switchboard-config] {msg}", flush=True)


def _same_json_type(a, b) -> bool:
    """Do two JSON values share a type? bool is checked before int because
    ``isinstance(True, int)`` is True in Python and a bool must never satisfy an
    int-typed option (nor the reverse)."""
    if isinstance(a, bool) or isinstance(b, bool):
        return isinstance(a, bool) and isinstance(b, bool)
    for kind in (dict, list, str):
        if isinstance(a, kind) or isinstance(b, kind):
            return isinstance(a, kind) and isinstance(b, kind)
    if isinstance(a, (int, float)) or isinstance(b, (int, float)):
        # int vs float matters: a float reaches consumers that int() a string
        # (e.g. a port), so 8100.5 would crash-loop a service.
        return type(a) is type(b)
    return type(a) is type(b)


def _deep_merge(base: dict, overlay: dict, path: str = "", rejected: list = None) -> dict:
    """Deep-merge an overlay over base, TYPE-PRESERVING.

    dict-into-dict merges recurse (so {"trunk": {"inbound_ext": …}} refines the
    trunk block without wiping its credentials); other types replace wholesale.

    An overlay value whose JSON type differs from the value already in base is
    REJECTED (recorded in `rejected`, never applied). The overlay is a
    hand-edited file that bypasses the Supervisor's schema, so a typo like
    ``{"trunk": "sip.example.com"}`` (string where a dict belongs) would
    otherwise raise deep inside a renderer, fail the init oneshot, and take
    every service — Asterisk included — down with it. Keys absent from base have
    nothing to check against and are passed through; nothing reads them.
    """
    out = dict(base)
    for key, val in overlay.items():
        dotted = f"{path}{key}"
        cur = out.get(key, None)
        if isinstance(val, dict) and isinstance(cur, dict):
            out[key] = _deep_merge(cur, val, dotted + ".", rejected)
        elif key in out and cur is not None and not _same_json_type(val, cur):
            if rejected is not None:
                rejected.append(f"{dotted} (want {type(cur).__name__}, got {type(val).__name__})")
        else:
            out[key] = val
    return out


def _changed_paths(base: dict, merged: dict, prefix: str = "") -> list:
    """Dotted key paths whose value actually CHANGED, for the boot log. Logging
    the overlay's raw keys instead would claim overrides for no-ops (a
    re-statement of the current value, or an empty ``{"trunk": {}}``)."""
    paths = []
    for key, new in merged.items():
        old = base.get(key, None)
        dotted = f"{prefix}{key}"
        if isinstance(new, dict) and isinstance(old, dict):
            paths.extend(_changed_paths(old, new, dotted + "."))
        elif key not in base or old != new:
            paths.append(dotted)
    return paths


def load_options() -> dict:
    if not OPTIONS_PATH.exists():
        log(f"WARNING: {OPTIONS_PATH} missing; using empty defaults")
        opts: dict = {}
    else:
        try:
            with OPTIONS_PATH.open() as fh:
                opts = json.load(fh)
        except (OSError, ValueError) as exc:
            # A malformed options.json must not crash the init oneshot (which would
            # silently take the whole add-on down); degrade to empty defaults + log.
            log(f"ERROR: cannot read/parse {OPTIONS_PATH}: {exc}; using empty defaults")
            opts = {}
    # Admin overlay: deep-merged over the Supervisor-managed options. Absent =
    # no-op; malformed = LOUD + ignored (never fail the boot over an overlay);
    # active = every overridden key path is logged, because a value that the
    # Configuration UI shows but the overlay overrides is otherwise invisible.
    if OVERLAY_PATH.exists():
        try:
            with OVERLAY_PATH.open() as fh:
                overlay = json.load(fh)
            if not isinstance(overlay, dict):
                raise ValueError("overlay root must be a JSON object")
            if overlay:
                rejected: list = []
                merged = _deep_merge(opts, overlay, "", rejected)
                changed = _changed_paths(opts, merged)
                if changed:
                    log(f"options overlay ACTIVE ({OVERLAY_PATH}) — overriding: "
                        + ", ".join(sorted(changed)))
                else:
                    log(f"options overlay present ({OVERLAY_PATH}) but changes nothing")
                for item in rejected:
                    log(f"WARNING: options overlay REJECTED {item} — type mismatch "
                        f"with the saved option; that key is unchanged")
                opts = merged
        except Exception as exc:  # noqa: BLE001 — an overlay must NEVER fail the boot
            # Broad by design: this file is hand-edited over SSH precisely when
            # the Supervisor API is unavailable, and the whole add-on (Asterisk
            # included — every phone) hangs off this oneshot's exit code. Any
            # overlay problem degrades to "ignore the overlay", loudly.
            log(f"ERROR: options overlay {OVERLAY_PATH} unusable ({exc!r}); IGNORING it")
    return opts


def write_effective_options(opts: dict) -> None:
    """Persist the post-overlay options for the s6 run scripts (switchboard-opt).

    Root-only (0600): it carries the same secrets as options.json. Written
    atomically so a run script started mid-write never reads a torn file.

    Never raises: this runs inside the boot-critical init oneshot, and a failure
    to write a convenience snapshot must not take the PBX down. On failure the
    services fall back to reading options.json (see switchboard-opt), which
    loses only the overlay."""
    try:
        tmp = EFFECTIVE_PATH.with_suffix(".tmp")
        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(opts, fh)
        os.replace(tmp, EFFECTIVE_PATH)
    except (OSError, TypeError, ValueError) as exc:
        log(f"WARNING: could not write {EFFECTIVE_PATH} ({exc}); services will "
            f"read /data/options.json directly (an options overlay will NOT apply "
            f"to them this boot)")


# --------------------------------------------------------------------------- #
# Timezone — the talking clock / wake-up calls must speak LOCAL time, but the
# add-on container runs in UTC. Resolve a zone (explicit option > the Home
# Assistant timezone via the Supervisor > UTC) and point /etc/localtime at it,
# so Asterisk's SayUnixTime and every Python service read local time with no
# per-process TZ plumbing.
# --------------------------------------------------------------------------- #
def resolve_timezone(opts: dict) -> str:
    tz = str(opts.get("timezone", "") or "").strip()
    if tz:
        return tz
    token = os.environ.get("SUPERVISOR_TOKEN", "")
    if token:
        import urllib.request
        # `supervisor` is the Docker-internal DNS name (works for bridge-network
        # add-ons); 172.30.32.2 is the Supervisor's fixed IP, reachable from a
        # host_network add-on (where the `supervisor` name doesn't resolve). Try
        # both so auto-detect works regardless of the add-on's network mode.
        for host in ("http://supervisor", "http://172.30.32.2"):
            try:
                req = urllib.request.Request(
                    f"{host}/info", headers={"Authorization": f"Bearer {token}"}
                )
                data = json.loads(urllib.request.urlopen(req, timeout=5).read().decode())
                tz = ((data.get("data") or {}).get("timezone") or "").strip()
                if tz:
                    log(f"timezone: auto-detected {tz} from Home Assistant ({host})")
                    return tz
            except Exception as exc:  # network/permission/parse — try next, don't crash
                log(f"timezone: lookup via {host} failed ({exc})")
    return "UTC"


def apply_timezone(tz: str) -> str:
    """Point /etc/localtime at the resolved zone. Returns the zone actually
    applied (UTC if the requested one isn't in tzdata)."""
    zoneinfo = Path("/usr/share/zoneinfo") / tz
    if not zoneinfo.exists():
        log(f"timezone: {tz!r} not found in zoneinfo; staying on UTC")
        return "UTC"
    try:
        localtime = Path("/etc/localtime")
        if localtime.is_symlink() or localtime.exists():
            localtime.unlink()
        localtime.symlink_to(zoneinfo)
        Path("/etc/timezone").write_text(tz + "\n")
        log(f"timezone set to {tz}")
        return tz
    except OSError as exc:
        log(f"timezone: could not set {tz} ({exc}); staying on UTC")
        return "UTC"


def gen_secret(n: int = 24) -> str:
    alphabet = string.ascii_letters + string.digits
    return "".join(secrets.choice(alphabet) for _ in range(n))


def _int(value: object, default: int) -> int:
    """Coerce to int, falling back to a default rather than crashing on junk."""
    try:
        return int(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return default


_CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")


def _has_control(value: str) -> bool:
    """True if value has CR/LF or other control chars (config-injection risk)."""
    return bool(_CONTROL_RE.search(value))


def _scrub(value: str) -> str:
    """Strip control chars so a value can't break out of its .conf line/section."""
    return _CONTROL_RE.sub("", value)


def valid_rooms(rooms: list) -> list[dict]:
    """Validate/sanitize room entries once; both renderers consume the result.

    Skips (with a secret-safe log) rooms that are missing fields, have a
    non-numeric ext, duplicate an earlier ext, or carry control characters in
    the secret — so one bad entry can't inject config or shadow another room.
    Returns dicts with cleaned ext/name/secret.
    """
    out: list[dict] = []
    seen: set[str] = set()
    for room in rooms:
        ext = str(room.get("ext", "")).strip()
        name = str(room.get("name", ext))
        sec = str(room.get("secret", ""))
        if not ext or not sec.strip():
            log(f"skipping room ext={ext!r}: missing ext or secret")
            continue
        if not re.fullmatch(r"[0-9]{2,6}", ext):
            log(f"skipping room ext={ext!r}: ext must be 2-6 digits")
            continue
        if set(ext) == {"0"}:
            # An all-zero ext ("00"/"000") passes the digit check but is undialable:
            # the [rooms] match rule tests the dialed number against the room
            # allow-list with Asterisk's regex operator, whose captured "0…" reads
            # as FALSE, so the call never routes. Reject it loudly.
            log(f"skipping room ext={ext!r}: an all-zero extension is undialable")
            continue
        if ext in seen:
            log(f"skipping duplicate room ext={ext!r}")
            continue
        if _has_control(sec):
            log(f"skipping room ext={ext!r}: secret contains control characters")
            continue
        # A ';' starts a comment mid-line in pjsip.conf, so `password = a;b`
        # silently becomes `password = a` and registration auth fails with no
        # obvious cause; leading/trailing whitespace is likewise dropped by the
        # parser. Reject both loudly rather than ship a truncated secret.
        if ";" in sec or sec != sec.strip():
            log(f"skipping room ext={ext!r}: secret has ';' or leading/trailing "
                f"whitespace (Asterisk would silently truncate it)")
            continue
        seen.add(ext)
        # Display name goes into a quoted callerid and a comment. Drop control
        # chars (no section break-out), the quote char (no callerid quote break),
        # and ';' (which would start an Asterisk comment mid-line and truncate
        # the callerid). Keep everything else so legit names survive (e.g. "Café").
        clean_name = _scrub(name).replace('"', "").replace(";", "").strip() or ext
        out.append({"ext": ext, "name": clean_name, "secret": sec})
    return out


def write(path: Path, content: str, mode: int = 0o640) -> None:
    """Write a generated config file with tight permissions from the first byte.

    Several of these files carry secrets in the clear because Asterisk requires
    them there (SIP auth passwords in pjsip.conf, the AMI secret in manager.conf).
    Creating with 0640 via os.open — instead of write_text + chmod — means there is
    never a window where the default umask leaves the file world-readable. Group
    read goes to the asterisk group (Asterisk runs -U asterisk -G asterisk)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)  # intentional: 0640 root:asterisk — the asterisk group MUST read it (that is the point)
    with os.fdopen(fd, "w") as fh:
        fh.write(content)
    try:
        os.chmod(path, mode)  # O_CREAT mode only applies on create; pin on rewrite  # intentional: 0640 root:asterisk — the asterisk group MUST read it (that is the point)
        import shutil
        shutil.chown(path, group="asterisk")
    except (PermissionError, LookupError, KeyError, OSError):
        pass  # off-box (no asterisk group) — perms still applied where possible
    log(f"wrote {path} ({len(content)} bytes)")


# --------------------------------------------------------------------------- #
# pjsip.conf
# --------------------------------------------------------------------------- #
def render_pjsip(opts: dict) -> str:
    rooms = opts.get("rooms", []) or []
    trunk = opts.get("trunk", {}) or {}

    parts = [
        ";; GENERATED by switchboard-config — edits here are overwritten.",
        "",
        "[transport-udp]",
        "type = transport",
        "protocol = udp",
        "bind = 0.0.0.0:5060",
        # QoS: mark SIP signalling CS3. Only helps if the AP/router maps DSCP to
        # Wi-Fi WMM (most consumer gear does), and is zero-risk otherwise.
        "tos = cs3",
        "cos = 3",
        "",
        ";; ----- Endpoint template shared by all room phones -----",
        "[room-endpoint](!)",
        "type = endpoint",
        "context = rooms",
        "disallow = all",             # G.711 µ-law only — no HD/Opus, no transcode
        f"allow = {CODEC_ALLOW}",
        "direct_media = no",          # keep media through Asterisk (NAT-safe on LAN)
        "rtp_symmetric = yes",
        "force_rport = yes",
        "rewrite_contact = yes",      # ATAs on the LAN; trust the source port
        "dtmf_mode = rfc4733",
        # RTP watchdog: if a room's media stalls mid-call (Wi-Fi cordless drops off
        # the AP, an FXS port wedges) tear the channel down instead of leaving a
        # dead-air call up forever and leaking the RTP port. µ-law flows
        # continuously (no VAD/silence-suppression) so a stall is a real fault, not
        # quiet. 120s (conservative — no early-media concern on internal calls);
        # a held leg gets the longer hold grace (music-on-hold still counts as RTP).
        "rtp_timeout = 120",
        "rtp_timeout_hold = 300",
        # QoS: mark RTP audio EF so the Wi-Fi cordless's voice gets WMM priority
        # over bulk LAN traffic (zero-risk if the AP doesn't honour DSCP).
        "tos_audio = ef",
        "cos_audio = 5",
        "",
        "[room-aor](!)",
        "type = aor",
        "max_contacts = 1",
        "remove_existing = yes",
        "qualify_frequency = 60",
        "",
    ]

    for room in rooms:
        # rooms have already been validated/sanitized by valid_rooms() in main().
        ext = room["ext"]
        name = room["name"]
        sec = room["secret"]
        endpoint = [
            f"[{ext}](room-endpoint)",
            "type = endpoint",
            f"auth = {ext}-auth",
            f"aors = {ext}",
            f'callerid = "{name}" <{ext}>',
        ]
        # MWI ("you have a message" stutter tone) is delivered by sending an
        # unsolicited message-summary NOTIFY straight to the contact via
        # PJSIPNotify (see render_pjsip_notify / ami.set_mwi), so the endpoint
        # needs no mailboxes= / app_voicemail / res_mwi_external wiring.
        parts += [
            f";; Room {ext} — {name}",
            f"[{ext}](room-aor)",
            "type = aor",
            "",
            f"[{ext}-auth]",
            "type = auth",
            "auth_type = userpass",
            f"username = {ext}",
            f"password = {sec}",
            "",
            *endpoint,
            "",
        ]

    if trunk.get("enabled"):
        parts += render_trunk_pjsip(trunk)
        # Defence-in-depth (anti-toll-fraud): stamp __TRANSFER_CONTEXT on every
        # room endpoint too, so even a transfer initiated from a compromised /
        # replayed room registration resolves its target internal-only. set_var
        # affects ONLY transfer-target resolution, never normal dialplan matching
        # (a room dialling 9+number directly is unaffected). Inserted right after
        # the template's `context = rooms`; gated on trunk so non-trunk output
        # (and test_clean_config_unchanged) stays byte-identical.
        ti = parts.index("context = rooms")
        parts.insert(ti + 1, "set_var = __TRANSFER_CONTEXT=internal-xfer")

    return "\n".join(parts) + "\n"


def render_trunk_pjsip(trunk: dict) -> list[str]:
    host = _scrub(str(trunk.get("provider_host", "")).strip())
    port = _int(trunk.get("port", 5060) or 5060, 5060)
    user = _scrub(str(trunk.get("username", "")).strip())
    sec = str(trunk.get("secret", ""))
    from_user = _scrub(str(trunk.get("from_user", "") or user).strip())
    from_domain = _scrub(str(trunk.get("from_domain", "") or host).strip())
    do_register = bool(trunk.get("registns", True))

    if not host or not user:
        log("trunk enabled but provider_host/username missing — skipping trunk")
        return []
    # Fail closed on values that could inject extra PJSIP directives/sections.
    if _has_control(sec):
        log("trunk: secret contains control characters — skipping trunk")
        return []
    # Same truncation trap the room secrets guard against: a ';' starts a comment
    # in pjsip.conf and leading/trailing whitespace is dropped, so `password = a;b`
    # would silently become `password = a` and the trunk would fail to register
    # with no obvious cause. Reject loudly rather than ship a truncated secret.
    if sec and (";" in sec or sec != sec.strip()):
        log("trunk: secret has ';' or leading/trailing whitespace "
            "(Asterisk would silently truncate it) — skipping trunk")
        return []
    if not re.fullmatch(r"[A-Za-z0-9._:\-]+", host):
        log("trunk: invalid provider_host — skipping trunk")
        return []
    if not re.fullmatch(r"[A-Za-z0-9._@:\-]+", user):
        log("trunk: invalid username — skipping trunk")
        return []
    # from_user/from_domain feed pjsip.conf directives just like username/host,
    # so charset-validate them too. They default to the already-validated
    # user/host, so on a bad EXPLICIT value fall back to that known-good default
    # (keeps the trunk working) rather than emitting an unchecked token.
    if not re.fullmatch(r"[A-Za-z0-9._@:\-]+", from_user):
        log(f"trunk: invalid from_user {from_user!r}; using username instead")
        from_user = user
    if not re.fullmatch(r"[A-Za-z0-9._:\-]+", from_domain):
        log(f"trunk: invalid from_domain {from_domain!r}; using provider_host instead")
        from_domain = host

    lines = [
        ";; ----- SIP trunk (outside line) -----",
        "[trunk-auth]",
        "type = auth",
        "auth_type = userpass",
        f"username = {user}",
        f"password = {sec}",
        "",
        "[trunk-aor]",
        "type = aor",
        f"contact = sip:{host}:{port}",
        # Do NOT qualify the trunk's static contact. VoIP.ms does not reliably
        # answer OPTIONS keep-alives, so qualifying flaps the contact to
        # "Unavailable" — and PJSIP then refuses to route outbound calls to it,
        # so Dial(...@trunk) fails with 503 "Service Unavailable" even while the
        # registration (and thus inbound) stays perfectly healthy. 0 disables the
        # health check so the contact is always usable for outbound; inbound
        # liveness + the NAT keepalive are covered by the short re-REGISTER
        # cadence instead (see expiration in [trunk-reg]).
        "qualify_frequency = 0",
        "",
        "[trunk]",
        "type = endpoint",
        "context = from-trunk",
        # The outside line is the PSTN — always narrowband G.711. Pin the trunk
        # leg to µ-law so the provider can never negotiate a wideband codec and
        # force a transcode against the analog FXS phones (adds latency, no gain).
        # The room endpoints are µ-law-only too, so the whole path is one codec.
        "disallow = all",
        f"allow = {CODEC_ALLOW}",
        "outbound_auth = trunk-auth",
        "aors = trunk-aor",
        f"from_user = {from_user}",
        f"from_domain = {from_domain}",
        "direct_media = no",
        "rtp_symmetric = yes",
        "force_rport = yes",
        "rewrite_contact = yes",
        "dtmf_mode = rfc4733",
        "tos_audio = ef",             # QoS: EF priority for the PSTN leg's RTP
        "cos_audio = 5",
        # RTP watchdog on the NAT'd trunk: if the media stream stalls (provider
        # drops it, NAT pinhole closes mid-call), tear the channel down instead
        # of hanging forever and leaking the RTP port. 60s (NOT 30) so one-way
        # early media during the 30s inbound ring can't trip it before answer;
        # a longer grace while ON HOLD (music flows, but a held leg can idle).
        "rtp_timeout = 60",
        "rtp_timeout_hold = 300",
        # ANTI-TOLL-FRAUD: stamp __TRANSFER_CONTEXT on the outside-caller channel
        # at birth (double-underscore = inherited, survives the blind-transfer
        # masquerade), so any ##/*2 transfer this channel initiates resolves its
        # target in [internal-xfer] (internal-only), never in [rooms] with its
        # _9. outbound rule. And reject provider-side SIP REFER on the trunk so a
        # remote party can't REFER us into an outbound leg. (Room endpoints keep
        # allow_transfer=yes so the cordless/iPhone Transfer button still works.)
        "set_var = __TRANSFER_CONTEXT=internal-xfer",
        "allow_transfer = no",
        "",
        "[trunk-identify]",
        "type = identify",
        "endpoint = trunk",
        f"match = {host}",
        "",
    ]
    if do_register:
        lines += [
            "[trunk-reg]",
            "type = registration",
            "transport = transport-udp",
            "outbound_auth = trunk-auth",
            f"server_uri = sip:{host}:{port}",
            f"client_uri = sip:{user}@{from_domain}",
            "retry_interval = 60",
            # Asterisk's DEFAULT max_retries=10 is a trapdoor: once exceeded the
            # registration enters a TERMINAL "Rejected" state ("Maximum retries
            # reached ... stopping registration attempt") that nothing ever
            # retries — a WAN blip longer than ~10 minutes permanently kills
            # inbound until a manual re-register. This fired live 2026-08-09:
            # a 75-min outage left the DID dead 24h, silently. 10000 * 60s ≈ 7
            # days of retrying; rtpmon's trunk watchdog is the backstop beyond
            # that. fatal_retry_interval keeps retrying even on 4xx/5xx final
            # responses (a provider mid-recovery can serve 503s before healing).
            "max_retries = 10000",
            "fatal_retry_interval = 120",
            "forbidden_retry_interval = 300",
            # Re-REGISTER every ~2 minutes, NOT the Asterisk default 3600s. The
            # REGISTER is the ONLY outbound traffic that holds the router's UDP
            # NAT pinhole open (the trunk AOR deliberately has qualify off, see
            # [trunk-aor]). With hourly registers the pinhole idles out, the
            # provider's reachability OPTIONS pings to us get dropped, VoIP.ms
            # flags the sub-account "Unreachable", and INBOUND calls insta-fail
            # with "Channel not available / Failover due to 'Unreachable'"
            # WITHOUT the INVITE ever reaching us (nothing in our logs; the
            # evidence lives in the VoIP.ms CDR call_logs). 120s is VoIP.ms's
            # own NAT guidance and their accepted minimum.
            "expiration = 120",
            "",
        ]
    return lines


# --------------------------------------------------------------------------- #
# extensions.conf  (dial plan)
# --------------------------------------------------------------------------- #
def render_operator_context(joined: str, automation_on: bool = False,
                            mwi_on: bool = True, trunk_on: bool = False,
                            wakeup_on: bool = False, clock_route: bool = False,
                            clock_ext: str = "41", status_on: bool = False,
                            directory_on: bool = False, announce_on: bool = False,
                            page_route: bool = False, page_ext: str = "44") -> list[str]:
    """The [operator] context: dial 0 -> AGI voice operator -> validated Dial.

    The AGI only *sets* OP_RESULT/OP_TARGET; the dialplan does the Dial, and only
    to a known room ext (the ``joined`` allow-list), so a recognizer bug can
    never dial an arbitrary endpoint. The AGI plays prompts, records the caller,
    runs offline STT, and matches the speech to a room.

    When ``mwi_on``, dialing 0 also clears the caller's own message-waiting flag
    (the indicator means "call the operator", and they just did). When
    ``automation_on``, a spoken "automation" (OP_RESULT=automation) routes into
    the voice home-automation flow.
    """
    lines = [
        ";; ----- Voice operator (dial 0) -----",
        "[operator]",
        "exten = s,1,NoOp(Operator session start)",
        " same = n,Answer()",
    ]
    if mwi_on:
        # The MWI stutter-tone means "you have a message / call the operator".
        # Dialing 0 IS calling the operator, so the flag is logically superseded
        # the instant they dial 0. Clear it AFTER Answer() and background it (`&`)
        # so a wedged AMI can never delay the answered caller up to the AMI
        # timeout — a moment-later clear is identical UX with zero ring latency.
        # Room-callers ONLY: an OUTSIDE caller reaches the operator too (via a
        # transfer from the answering phone), and their CALLERID is the external
        # number — clearing MWI for it just errors and queues a pointless replay
        # ("Asterisk MWI update failed (replay later)" in the log). Gate on the
        # same room allow-list the operator Dial uses.
        lines += [
            f' same = n,ExecIf($["${{CALLERID(num)}}" : "^({joined})$"]?System(/usr/bin/switchboard-mwi clear ${{CALLERID(num)}} &))',
        ]
    lines += [
        " same = n,Set(CHANNEL(language)=en)",
        " same = n,Wait(1)",
        " same = n,AGI(switchboard-operator.agi)",
        " same = n,NoOp(operator result=${OP_RESULT} target=${OP_TARGET})",
    ]
    if wakeup_on:
        # A spoken "wake up call" hands off to the wake-up flow (same context as
        # dialing the wake-up code). Checked BEFORE connect/bye so it doesn't
        # disturb the dial path; [wakeup] is emitted under the same wakeup_on.
        lines += [
            " same = n,GotoIf($[\"${OP_RESULT}\" = \"wakeup\"]?wakeup,s,1)",
        ]
    if automation_on:
        # A spoken "automation" enters the lights flow. Checked BEFORE the
        # connect/bye logic so it doesn't disturb the existing dial path.
        lines += [
            " same = n,GotoIf($[\"${OP_RESULT}\" = \"automation\"]?automation,s,1)",
        ]
    # More feature hand-offs, all checked before the connect/bye dial path.
    # status/directory/announce have their own contexts (emitted whenever the
    # feature is on). clock/page are inline in [rooms] at their ext, so route
    # there only when that dial code was actually emitted (clock_route/page_route)
    # — else an OP_RESULT of clock/page just falls through to a polite goodbye
    # instead of a Goto to a missing extension.
    if clock_route:
        lines += [f" same = n,GotoIf($[\"${{OP_RESULT}}\" = \"clock\"]?rooms,{clock_ext},1)"]
    if status_on:
        lines += [" same = n,GotoIf($[\"${OP_RESULT}\" = \"status\"]?status,s,1)"]
    if directory_on:
        lines += [" same = n,GotoIf($[\"${OP_RESULT}\" = \"directory\"]?directory,s,1)"]
    if announce_on:
        lines += [" same = n,GotoIf($[\"${OP_RESULT}\" = \"announce\"]?announce,s,1)"]
    if page_route:
        lines += [f" same = n,GotoIf($[\"${{OP_RESULT}}\" = \"page\"]?rooms,{page_ext},1)"]
    lines += [
        " same = n,GotoIf($[\"${OP_RESULT}\" = \"connect\"]?:bye)",
        # Defense in depth: only dial a *known room* ext, even if the AGI misbehaves.
        f" same = n,GotoIf($[\"${{OP_TARGET}}\" : \"^({joined})$\"]?:bye)",
        # Engaged-line short-circuit: if the room is already on a call, say "busy"
        # at once instead of dialing it (the gateway would call-waiting-ring a busy
        # line instead of returning busy). DEVICE_STATE is the live FXS port state.
        " same = n,Set(DS=${DEVICE_STATE(PJSIP/${OP_TARGET})})",
        " same = n,GotoIf($[\"${DS}\" = \"UNAVAILABLE\" | \"${DS}\" = \"INVALID\"]?unavail)",
        " same = n,GotoIf($[\"${DS}\" != \"NOT_INUSE\"]?busy)",
        " same = n(connect),Playback(switchboard/sw-connecting)",
        " same = n,Dial(PJSIP/${OP_TARGET},30,rtT)",
        # Dial fell through (didn't answer): tell the caller WHY rather than a
        # bland goodbye. ${DIALSTATUS} = BUSY | NOANSWER | CHANUNAVAIL | CONGESTION.
        " same = n,Verbose(0,Operator dial ${OP_TARGET} -> ${DIALSTATUS})",
        " same = n,GotoIf($[\"${DIALSTATUS}\" = \"BUSY\"]?busy)",
        " same = n,GotoIf($[\"${DIALSTATUS}\" = \"NOANSWER\"]?noanswer)",
        " same = n,GotoIf($[\"${DIALSTATUS}\" = \"CHANUNAVAIL\"]?unavail)",
        " same = n,GotoIf($[\"${DIALSTATUS}\" = \"CONGESTION\"]?unavail)",
        " same = n,Goto(bye)",
        " same = n(busy),Playback(switchboard/sw-busy)",
        " same = n,Goto(endtone)",
        " same = n(noanswer),Playback(switchboard/sw-noanswer)",
        " same = n,Goto(endtone)",
        " same = n(unavail),Playback(switchboard/sw-unavailable)",
        " same = n,Goto(endtone)",
        # Also reached after a connected call ends (Dial returns): the end-of-call
        # tone tells the caller on an antique handset that the line is down.
        " same = n(bye),Playback(switchboard/sw-goodbye)",
        " same = n(endtone),Playback(switchboard/sw-endtone)",
        " same = n,Hangup()",
        "",
    ]
    if trunk_on:
        # Anti-toll-fraud: confine any ##/*2 transfer of an operator-connected
        # call to internal-only by stamping __TRANSFER_CONTEXT on the calling
        # channel just before 'T' arms on the operator Dial. Gated on trunk_on so
        # non-trunk output stays byte-identical.
        i = lines.index(" same = n,Dial(PJSIP/${OP_TARGET},30,rtT)")
        lines.insert(i, " same = n,Set(__TRANSFER_CONTEXT=internal-xfer)")
    lines += rtpqos_h("operator")
    return lines


def render_wakeup_context() -> list[str]:
    """The [wakeup] context (dial the code -> AGI sets/changes/cancels a wake-up,
    then the dialplan reads it back) and [wakeup-deliver] (the scheduler service
    originates the room INTO this to actually ring it at the chosen time)."""
    return [
        ";; ----- Wake-up calls -----",
        "[wakeup]",
        "exten = s,1,NoOp(Wake-up request from ${CHANNEL})",
        " same = n,Answer()",
        " same = n,Set(CHANNEL(language)=en)",
        " same = n,Wait(1)",
        " same = n,AGI(switchboard-wakeup.agi)",
        " same = n,NoOp(wakeup result=${WAKEUP_RESULT} epoch=${WAKEUP_EPOCH})",
        " same = n,GotoIf($[\"${WAKEUP_RESULT}\" = \"set\"]?setdone)",
        " same = n,GotoIf($[\"${WAKEUP_RESULT}\" = \"cancelled\"]?cancelled)",
        " same = n,Goto(none)",
        " same = n(setdone),Playback(switchboard/sw-wakeup-set)",
        " same = n,SayUnixTime(${WAKEUP_EPOCH},,IMp)",
        " same = n,Goto(bye)",
        " same = n(cancelled),Playback(switchboard/sw-wakeup-cancelled)",
        " same = n,Goto(bye)",
        " same = n(none),Playback(switchboard/sw-wakeup-none)",
        " same = n(bye),Playback(switchboard/sw-goodbye)",
        " same = n,Playback(switchboard/sw-endtone)",
        " same = n,Hangup()",
    ] + rtpqos_h("wakeup") + [
        "",
        "[wakeup-deliver]",
        # SW_STAGE records how far delivery actually got. Channel variables survive
        # into the h extension, so rtpqos_h reports the LAST stage reached. Without
        # it the ledger recorded only "ring queued=True" plus "answered": one
        # snoozed wake-up produced three attempts that died at dialplan steps 6, 5
        # and 9, and nothing distinguished a delivery cut off before the greeting
        # from one that ran to completion. A wake-up that half-played is a wake-up
        # that failed, and it looked identical to a success.
        "exten = s,1,NoOp(Wake-up delivery to ${CHANNEL})",
        " same = n,Set(SW_STAGE=answering)",
        " same = n,Answer()",
        " same = n,Set(CHANNEL(language)=en)",
        # Fire the SCENE on answer, before a word is spoken. The delivery AGI used
        # to run only after the greeting and the time, so hanging up during either
        # meant the scene never fired -- and hanging up is exactly what someone
        # does when a wake-up call has already woken them. Live: the scene fired
        # on 1 of 3 delivered wake-ups.
        #
        # The audio is DISMISSIBLE; the scene is a real-world effect and is
        # arguably the part that does the waking. Gating the least dismissible
        # action behind the most dismissible one had it backwards.
        " same = n,Set(SW_STAGE=scene)",
        " same = n,AGI(switchboard-wakeup-deliver.agi,scene)",
        " same = n,Wait(1)",
        " same = n,Set(SW_STAGE=greeting)",
        " same = n,Playback(switchboard/sw-wakeup-greeting)",
        " same = n,Set(SW_STAGE=time)",
        " same = n,SayUnixTime(,,IMp)",
        # Smart wake-up: fire the configured scene + speak weather / next calendar
        # event (all no-ops if unconfigured or HA is unreachable — the AGI degrades).
        # ...and the spoken extras (weather / calendar) stay here, after the time,
        # where they belong in the narration. The scene has already fired.
        " same = n,Set(SW_STAGE=extras)",
        " same = n,AGI(switchboard-wakeup-deliver.agi,speak)",
        " same = n,Wait(1)",
        " same = n,Set(SW_STAGE=repeat)",
        " same = n,Playback(switchboard/sw-wakeup-greeting)",
        " same = n,SayUnixTime(,,IMp)",
        " same = n,Set(SW_STAGE=complete)",
        " same = n,Hangup()",
    ] + rtpqos_h("wakeup-deliver") + [
        "",
    ]


def render_page_context() -> list[str]:
    """The [page] context: ami.page_all Originates each room INTO this, which
    drops the channel into the quiet ConfBridge intercom so the whole house
    hears (and can answer back on) the announcement."""
    return [
        ";; ----- Page intercom (conference target) -----",
        "[page]",
        "exten = s,1,NoOp(Page intercom)",
        " same = n,Answer()",
        " same = n,ConfBridge(switchboard-page,switchboard_bridge,switchboard_user)",
        " same = n,Hangup()",
    ] + rtpqos_h("page") + [
        "",
    ]


def render_automation_context() -> list[str]:
    """The [automation] context: runs the voice home-automation (lights) AGI.
    Reached either by dialing automation_ext or by saying "automation" to the
    operator (which sets OP_RESULT=automation and the operator Gotos here)."""
    return [
        ";; ----- Voice home automation (lights) -----",
        "[automation]",
        "exten = s,1,NoOp(Automation)",
        " same = n,Answer()",
        " same = n,Set(CHANNEL(language)=en)",
        " same = n,Wait(1)",
        " same = n,AGI(switchboard-automation.agi)",
        " same = n,Hangup()",
    ] + rtpqos_h("automation") + [
        "",
    ]


def render_assistant_context() -> list[str]:
    """The [assistant] context: runs the fully-local voice assistant AGI.

    Reached by dialing assistant_ext. Everything the AGI does stays on the Pi:
    the add-on's own whisper transcribes, Home Assistant's BUILT-IN conversation
    agent matches the intent, and the add-on's own piper voice speaks the reply.
    Default OFF -- the flow can only act on entities that have been exposed to
    Assist, so it is opt-in rather than something a stock install answers with."""
    return [
        ";; ----- Local voice assistant (Home Assistant conversation agent) -----",
        "[assistant]",
        "exten = s,1,NoOp(Assistant)",
        " same = n,Answer()",
        " same = n,Set(CHANNEL(language)=en)",
        " same = n,Wait(1)",
        " same = n,AGI(switchboard-assistant.agi)",
        " same = n,Hangup()",
    ] + rtpqos_h("assistant") + [
        "",
    ]


def render_directory_context(joined: str, trunk_on: bool = False) -> list[str]:
    """The [directory] context (dial 411): look a room up by voice — say a name,
    hear its extension, get connected. The AGI resolves the speech and sets
    DIR_TARGET/DIR_RESULT; the dialplan does the Dial, and ONLY to a known room
    ext (the ``joined`` allow-list) even if the AGI misbehaves. When the trunk is
    live, the connect leg is confined to internal-only transfers (anti-toll-fraud,
    consistent with [operator])."""
    lines = [
        ";; ----- Directory assistance (dial a room up by voice) -----",
        "[directory]",
        "exten = s,1,NoOp(Directory assistance)",
        " same = n,Answer()",
        " same = n,Set(CHANNEL(language)=en)",
        " same = n,Wait(1)",
        " same = n,AGI(switchboard-directory.agi)",
        " same = n,NoOp(directory result=${DIR_RESULT} target=${DIR_TARGET})",
        # Proceed only on an explicit connect result to a KNOWN room ext.
        " same = n,GotoIf($[\"${DIR_RESULT}\" = \"connect\"]?:bye)",
        f" same = n,GotoIf($[\"${{DIR_TARGET}}\" : \"^({joined})$\"]?:bye)",
    ]
    if trunk_on:
        lines.append(" same = n,Set(__TRANSFER_CONTEXT=internal-xfer)")
    lines += [
        # The AGI already spoke "Connecting you now"; go straight to the Dial.
        " same = n,Dial(PJSIP/${DIR_TARGET},30,rtT)",
        " same = n,Hangup()",
        " same = n(bye),Playback(switchboard/sw-goodbye)",
        " same = n,Playback(switchboard/sw-endtone)",
        " same = n,Hangup()",
        "",
    ]
    lines += rtpqos_h("directory")
    return lines


def render_status_context() -> list[str]:
    """The [status] context: the dial-a-status voice menu AGI — SAY "power",
    "weather" or "house" and hear live Home Assistant state spoken back.

    Voice only: there is no DTMF path. (This docstring used to offer "or press
    1/2/3"; the AGI has never read digits, so anyone taking that literally on a
    touch-tone phone got nothing.)"""
    return [
        ";; ----- Dial-a-status voice menu -----",
        "[status]",
        "exten = s,1,NoOp(Status menu)",
        " same = n,Answer()",
        " same = n,Set(CHANNEL(language)=en)",
        " same = n,Wait(1)",
        " same = n,AGI(switchboard-status.agi)",
        " same = n,Hangup()",
    ] + rtpqos_h("status") + [
        "",
    ]


def render_announce_play_context() -> list[str]:
    """[switchboard-announce-play]: the target of the HA-pushed announcement.

    An announcement used to be Originated straight to ``Application: Playback``,
    which never enters the dialplan — so it had no ``h`` extension, and
    switchboard-rtpqos was unreachable BY CONSTRUCTION. Two audit windows found
    the same thing: 23 then 18 announce playbacks and not one QoS record, so an
    announcement that was clipped, dropped mid-play or never delivered is
    indistinguishable in the record from one that played in full. That is the
    exact failure mode the cordless is prone to, since its WiFi radio parks
    between calls.

    Originating into this thin context instead yields a hangup cause, a billsec
    and a QoS record, at the cost of one dialplan hop. The tag stays "announce"
    (NOT a new one) so it lands in callqos's PLAYBACK_TAGS: recorded honestly,
    but it never notifies, never moves sensor.switchboard_last_call, and — via
    devhealth's load_callqos_ts filter — never confirms a call for last_call_mos.

    SW_ANN_FILE is charset-validated in ami.announce_to_ext before it is sent."""
    return [
        ";; ----- HA -> phone announce playback (Originate target) -----",
        "[switchboard-announce-play]",
        "exten = s,1,NoOp(HA announce playback)",
        " same = n,Set(SW_STAGE=playing)",
        " same = n,Playback(${SW_ANN_FILE})",
        " same = n,Set(SW_STAGE=complete)",
        " same = n,Hangup()",
    ] + rtpqos_h("announce") + [
        "",
    ]


def render_announce_context() -> list[str]:
    """The [announce] context: record a short message and play it out to the
    configured Home Assistant media players (via the announce AGI)."""
    return [
        ";; ----- Phone -> HA speaker announce -----",
        "[announce]",
        "exten = s,1,NoOp(Announce)",
        " same = n,Answer()",
        " same = n,Set(CHANNEL(language)=en)",
        " same = n,Wait(1)",
        " same = n,AGI(switchboard-announce.agi)",
        " same = n,Hangup()",
    ] + rtpqos_h("announce") + [
        "",
    ]


def _outbound_dial_body(num_expr: str, caller_id: str) -> list:
    """The shared priority-2..n body of an outbound rule: toll-fraud origin guard,
    caller-ID, transfer confinement, and the trunk Dial. ``num_expr`` is the
    dialplan expression for the number to send to the trunk (``${EXTEN}`` in
    direct mode, ``${EXTEN:<plen>}`` in prefix mode). Priority 1 (the NoOp that
    labels the call) is emitted by the caller so the pattern line reads clearly."""
    cid = f"Set(CALLERID(num)={caller_id})" if caller_id else "NoOp(no outbound CID)"
    return [
        # ANTI-TOLL-FRAUD origin guard (version-independent BACKSTOP): refuse
        # outbound origination from the TRUNK endpoint itself. If a transferred-in
        # outside caller's trunk channel ever masqueraded into [rooms] and reached
        # here, CHANNEL(endpoint)=="trunk" blocks it — WITHOUT relying on
        # TRANSFER_CONTEXT. (This catches the blind-## / masquerade case; the
        # attended-*2 path originates a Local channel with an EMPTY endpoint, so
        # this guard doesn't fire for it — that path is closed by the primary
        # defence, __TRANSFER_CONTEXT=internal-xfer, which has no outbound rule.)
        ' same = n,GotoIf($["${CHANNEL(endpoint)}" = "trunk"]?blocked)',
        f" same = n,{cid}",
        # Confine any onward ##/*2 transfer OF this outbound call to internal-only.
        " same = n,Set(__TRANSFER_CONTEXT=internal-xfer)",
        # 'rT' not 'rtT': 'T' lets our (internal) caller transfer via ##/*2, but
        # we drop 't' so the far-end PSTN callee can't invoke our feature codes.
        f" same = n,Dial(PJSIP/{num_expr}@trunk,60,rT)",
        " same = n,Hangup()",
        " same = n(blocked),Congestion(5)",
        " same = n,Hangup()",
    ]


def render_emergency_notices() -> list:
    """911 and 933, answered with a spoken notice — INDEPENDENT of the trunk.

    Two defects this closes, both live before v0.73.0.

    (1) These lived inside `render_outbound_rules`, which is called only when the
    trunk is enabled. On a trunk-less install -- the DEFAULT -- `exten = 911` did
    not exist at all, so an emergency dial fell through `_X.`, failed the room
    test and landed on Congestion: a fast busy indistinguishable from a wrong
    number. The spoken "use a mobile" notice, the entire reason this block
    exists, had never once played on such an install.

    (2) `933` -- the FCC's designated number for TESTING a 911 setup without
    engaging dispatch -- was matched only in the direct-dial branch. In prefix
    mode it fell to `_9.`, which strips the prefix and dials the remainder: a
    caller checking their emergency setup placed a real PSTN call to "33". That
    is the identical shape to the 911->"11" bug this file's own comment records
    fixing, left behind on the sibling number.

    Emitted unconditionally so the notice does not depend on a trunk it does not
    use, and BEFORE the outbound rules so it precedes `_9.` in the file as well
    as in Asterisk's specificity ordering.
    """
    out = []
    for num, what in (("911", "911 attempted"), ("933", "933 test")):
        out += [
            f"exten = {num},1,NoOp(EMERGENCY {what} — not carried)",
            " same = n,Answer()",
            # Tagged so an emergency attempt is findable in the call ledger. A
            # distinct tag, not `blocked`: a 911 dial on a PBX with no E911 is
            # the most important call kind on this system, and filing it beside
            # a 1-900 attempt makes it unfindable.
            " same = n,Set(SW_TAG=emergency)",
            " same = n,Playback(switchboard/sw-no-emergency)",
            " same = n,Congestion(5)",
            " same = n,Hangup()",
        ]
    return ["", ";; ----- Emergency numbers are NOT carried -----",
            ";; No E911 service is registered, so these are answered and",
            ";; explained rather than dialled. See render_emergency_notices().",
            ] + out + [""]


def render_outbound_rules(prefix: str, caller_id: str) -> list:
    """Outbound-via-trunk dialplan lines, emitted INSIDE the [rooms] context.

    These MUST live in [rooms] (where the phones dial from). Two modes:

    * PREFIX mode (``prefix`` non-empty, e.g. "9"): the literal-``prefix`` patterns
      (``_<prefix>011.`` / ``_<prefix>900.`` / ``_<prefix>.``) out-prioritise the
      catch-all ``_X.`` room pattern, so a prefixed number routes to the trunk
      while bare extensions still ring rooms. Toll-fraud blocks are more specific
      than the general ``_<prefix>.`` rule, so Asterisk denies them first.

    * DIRECT mode (``prefix`` == ""): no outside-line prefix, but a leading **1**
      is REQUIRED — outside numbers are NANP 11-digit ``_1NXXNXXXXXX`` (1 + area +
      number), dialed as-is. This is more specific than ``_X.`` for a full number
      yet never matches a 2–3-digit extension/feature code, so short internal
      targets still ring. Requiring the 1 (vs also allowing a bare 10-digit
      ``_NXXNXXXXXX``) is deliberate: a bare-10 pattern makes feature codes 41–46
      and any extension starting 2–9 look like the *start* of a phone number,
      which stalls their dialing on analog phones (the gateway must wait out the
      inter-digit timer). With 1-required, only extensions that start with 1
      (12–19) overlap the outbound pattern. 011 international and 1-900 premium
      are blocked (more specific, denied first). There is deliberately NO catch-all
      outbound rule, so a mis-dial — a bare 10-digit number, a 7-digit fragment, or
      911 (E911 unconfigured) — falls through ``_X.`` → "not a room" → Congestion,
      never the trunk.

    (Regression guard: when these lived after the feature contexts they landed in
    [automation], so [rooms] had no outbound rule — every outbound call fell
    through to ``_X.`` → "not a room" → Congestion = "Service Unavailable".)
    """
    if prefix == "":
        # Direct-dial: NANP 11-digit (1 + 10). Blocks first (more specific), then
        # the single outbound pattern. Number dialed as-is (${EXTEN}).
        return [
            "",
            "",
            ";; Emergency numbers are emitted unconditionally by\n            ;; render_emergency_notices() -- see there for why they are not\n            ;; gated on the trunk.",
            ";; ----- Blocked destinations (toll-fraud guard) — direct-dial -----",
            ";; International (011) and premium 1-900 are denied. More specific",
            ";; than the outbound pattern below, so matched first.",
            "exten = _011.,1,NoOp(Blocked international)",
            " same = n,Congestion(5)",
            " same = n,Hangup()",
            "exten = _1900NXXXXXX,1,NoOp(Blocked premium 1-900)",
            " same = n,Congestion(5)",
            " same = n,Hangup()",
            "",
            ";; ----- Outbound via SIP trunk — 1 + 10-digit NANP (leading 1 req.) -----",
            ";; More specific than _X. for a full number; never matches a 2-3 digit",
            ";; extension/feature code, so internal dialing is unaffected. A bare",
            ";; 10-digit number is NOT routed (add the 1) — that is what keeps the",
            ";; feature codes and extension 20 dialing instantly.",
            "exten = _1NXXNXXXXXX,1,NoOp(Outbound ${EXTEN})",
        ] + _outbound_dial_body("${EXTEN}", caller_id)

    # Prefix mode.
    plen = len(prefix)  # strip the whole prefix, not a hardcoded single char
    return [
        "",
        "",
        ";; ----- Emergency numbers, PREFIXED forms -----",
        ";; MUST precede the outbound pattern: _9. matches a prefixed emergency",
        ";; number and would dial the remainder out the trunk — a wrong call",
        ";; placed during an emergency. The BARE forms are emitted",
        ";; unconditionally by render_emergency_notices(); these are the",
        ";; dial-prefix variants. 933 is included because it is the FCC test",
        ";; number, and without this line it fell to _9. and dialled '33'.",
        f"exten = {prefix}911,1,NoOp(EMERGENCY {prefix}911 attempted — not carried)",
        " same = n,Answer()",
        " same = n,Set(SW_TAG=emergency)",
        " same = n,Playback(switchboard/sw-no-emergency)",
        " same = n,Congestion(5)",
        " same = n,Hangup()",
        f"exten = {prefix}933,1,NoOp(EMERGENCY {prefix}933 test — not carried)",
        " same = n,Answer()",
        " same = n,Set(SW_TAG=emergency)",
        " same = n,Playback(switchboard/sw-no-emergency)",
        " same = n,Congestion(5)",
        " same = n,Hangup()",
        "",
        ";; ----- Blocked destinations (toll-fraud guard) -----",
        ";; International (011) and premium-rate (900 / 1-900) are denied. These",
        ";; patterns are more specific than the general rule below, so Asterisk",
        ";; matches them first. Everything else still dials out normally.",
        f"exten = _{prefix}011.,1,NoOp(Blocked international)",
        " same = n,Congestion(5)",
        " same = n,Hangup()",
        f"exten = _{prefix}1900.,1,NoOp(Blocked premium 1-900)",
        " same = n,Congestion(5)",
        " same = n,Hangup()",
        f"exten = _{prefix}900.,1,NoOp(Blocked premium 900)",
        " same = n,Congestion(5)",
        " same = n,Hangup()",
        "",
        ";; ----- Outbound via SIP trunk (in [rooms] so the phones can dial it) -----",
        f"exten = _{prefix}.,1,NoOp(Outbound ${{EXTEN:{plen}}})",
    ] + _outbound_dial_body(f"${{EXTEN:{plen}}}", caller_id)


def render_internal_xfer_context(exts: list, operator_on: bool) -> list:
    """[internal-xfer] — the context that DTMF (##/*2) transfer targets resolve
    in (via __TRANSFER_CONTEXT). It contains ONLY internal destinations: the
    literal room extensions and, if enabled, dial-0 -> operator. It deliberately
    has NO ``_<prefix>.`` outbound rule and NO ``_X.`` catch-all, so an outside
    caller who was transferred in and keys ``## 9 1 900…`` matches nothing and
    the transfer fails cleanly — the toll trunk is simply unreachable from a
    transfer. Emitted only when the trunk is enabled (nothing to protect
    otherwise; keeps non-trunk output byte-identical)."""
    lines = [
        ";; ----- DTMF transfer targets: internal ONLY (anti-toll-fraud) -----",
        "[internal-xfer]",
    ]
    if operator_on:
        lines += [
            "exten = 0,1,NoOp(Transfer to operator)",
            " same = n,Goto(operator,s,1)",
        ]
    for e in exts:
        lines += [
            f"exten = {e},1,NoOp(Transfer to {e})",
            " same = n,Set(__TRANSFER_CONTEXT=internal-xfer)",  # keep chained xfers confined
            f" same = n,Dial(PJSIP/{e},30,rtT)",
            " same = n,Hangup()",
        ]
    lines.append("")
    return lines


# --------------------------------------------------------------------------- #
# Per-call RTP quality telemetry.
#
# Logs one ``[rtpqos]`` line per phone-originated call with the numbers you tune
# call quality on: rx/tx packet counts + loss, jitter and round-trip (seconds),
# the negotiated codec, duration, and Asterisk's Media Experience Score (rxmes/
# txmes, a 0-100 MOS-like metric — ~88 ≈ MOS 4.3).
#
# ★ Two hard-won facts (verified live over the Asterisk CLI):
#   1. chan_pjsip exposes RTP stats via CHANNEL(rtcp,<field>) — NOT the old chan_sip
#      CHANNEL(rtpqos,audio,<field>), which returns "unknown/unavailable".
#   2. The RTP instance is already torn down by the time a hangup HANDLER runs, so
#      it must be read in the ``h`` extension (which runs while the pbx — and the
#      RTP — is still alive). QOS_H is that h-extension, added to each call context;
#      it captures the channel that DIALED (the initiating phone / inbound trunk).
# --------------------------------------------------------------------------- #
def rtpqos_h(tag: str) -> list:
    """The `h` (hangup) extension for a call context: on hangup, Gosub the rtpqos
    logger while the RTP instance is still alive. Runs on the channel that executed
    the context — the initiating phone (or the inbound trunk).

    The tag passed here is the CONTEXT's name, which is not always the call's
    KIND. Several distinct call types are defined inside [rooms] — room-to-room
    dialling, outbound PSTN via the dial prefix, the operator, the talking clock,
    paging — and every one of them hangs up in [rooms], so every one was filed as
    `tag=rooms`. An audit found that none of the four records tagged "rooms" was
    actually a room-to-room call, which makes any per-type quality trend from
    that field wrong.

    So a context may override the kind by setting SW_TAG before the call
    proceeds; the context name remains the fallback, so a context that stamps
    nothing behaves exactly as before. FILTER keeps the value to plain letters
    and a dash: it reaches a shell argument."""
    return [f"exten = h,1,NoOp(rtpqos {tag})",
            f' same = n,Set(SW_KIND=${{IF($["${{SW_TAG}}" != ""]?'
            f'${{FILTER(a-z-,${{SW_TAG}})}}:{tag})}})',
            " same = n,Gosub(switchboard-rtpqos,s,1(${SW_KIND}))"]


def _q(field: str) -> str:
    return "${CHANNEL(rtcp," + field + ")}"


def render_rtpqos_context() -> list:
    # Push each hung-up leg to switchboard-callqos: the HA sensor + poor-call
    # notification + the durable JSONL ledger. ${ARG1} is the originating context
    # ("rooms"/"operator"/"directory"/"from-trunk"), passed by rtpqos_h's Gosub.
    # Backgrounded (&) so the h-exten returns immediately; TrySystem so a script
    # error can NEVER wedge the hangup. Every ${...} is double-quoted so an empty
    # / absent RTCP field lands as an empty arg (argparse-safe) and can't split.
    def q(field):
        return '"' + _q(field) + '"'
    callqos = (
        # --detach: the sink forks into its own session so channel teardown on
        # hangup can't kill it after the sensor push but before the notification.
        " same = n,TrySystem(/usr/bin/switchboard-callqos --detach --source dialplan"
        ' --tag "${ARG1}" --chan "${CHANNEL(name)}"'
        ' --cid "${FILTER(0-9+*#,${CALLERID(num)})}"'
        ' --codec "${CHANNEL(audioreadformat)}" --billsec "${CDR(billsec)}"'
        ' --hcause "${HANGUPCAUSE}" --rxcount "${RXC}" --txcount "${TXC}"'
        # How far a scripted leg got before hangup. Empty for contexts that set
        # no stage (a normal room call has no stages to reach).
        ' --stage "${FILTER(a-z,${SW_STAGE})}"'
        f' --rxploss {q("rxploss")} --txploss {q("txploss")}'
        f' --rxjitter {q("rxjitter")} --txjitter {q("txjitter")} --rtt {q("rtt")}'
        f' --rxmes {q("rxmes")} --txmes {q("txmes")}'
        # Extended fields the sink has always accepted but never received (null
        # in 100% of records until v0.48.0). local_maxjitter is Asterisk's
        # maxrxjitter: the max of the interarrival estimate sampled at RTCP
        # report instants — NOT a bound on --rxjitter, which is read once at
        # hangup, so it can legitimately be the smaller number.
        #
        # NO OCTET COUNTERS: v0.48.0 also passed --rxoctet/--txoctet as
        # CHANNEL(rtcp,rxoctetcount)/txoctetcount, but PJSIP in Asterisk
        # 20.11.1 does not expose those names — every call logged four
        # "Unrecognized argument 'rxoctetcount' for 'rtcp'" WARNINGs into the
        # durable log and both fields stayed null in 100% of records. Byte
        # volume is derivable from rxcount/txcount and the codec anyway, so
        # the flags are dropped rather than renamed. (The sink still accepts
        # them, for a future Asterisk that exposes the counters.)
        f' --maxrtt {q("maxrtt")} --stdevrtt {q("stdevrtt")}'
        # --rtt is the LAST RTCP round, not the mean, and the difference is not
        # academic: one live announce reported rtt=0.007675 against
        # maxrtt=0.146652 -- a 19x spread -- so a threshold alarm on "the call's
        # RTT" was reading a single arbitrary sample. normdevrtt is Asterisk's
        # running MEAN and minrtt the floor; together with max/stdev they let a
        # consumer see the distribution instead of one draw from it. Same RTCP
        # family as maxrtt/stdevrtt, which are already proven to resolve here.
        f' --normdevrtt {q("normdevrtt")} --minrtt {q("minrtt")}'
        f' --rxmaxjitter {q("local_maxjitter")} &)'
    )
    return [
        "",
        ";; ----- Per-call RTP quality telemetry (logged from each context's h-exten) -----",
        "[switchboard-rtpqos]",
        "exten = s,1,NoOp(RTP quality summary)",
        f" same = n,Set(RXC={_q('rxcount')})",
        f" same = n,Set(TXC={_q('txcount')})",
        # Skip a leg with no RTCP stats — no media, or a peer that sends no RTCP
        # (the VoIP.ms trunk). A one-way-audio leg (tx>0, rx=0) is still logged.
        ' same = n,GotoIf($[("${RXC}" = "" | "${RXC}" = "0") & ("${TXC}" = "" | "${TXC}" = "0")]?done)',
        # cid is attacker-controlled on inbound trunk calls (spoofable PSTN caller-ID);
        # FILTER to phone chars so it can't forge log fields or inject a line.
        " same = n,Verbose(0,[rtpqos] chan=${CHANNEL(name)} cid=${FILTER(0-9+*#,${CALLERID(num)})} "
        "codec=${CHANNEL(audioreadformat)} billsec=${CDR(billsec)} hcause=${HANGUPCAUSE} "
        f"rxcount=${{RXC}} txcount=${{TXC}} "
        f"rxploss={_q('rxploss')} txploss={_q('txploss')} "
        f"rxjitter={_q('rxjitter')} txjitter={_q('txjitter')} rtt={_q('rtt')} "
        f"rxmes={_q('rxmes')} txmes={_q('txmes')} tag=${{ARG1}} "
        "stage=${FILTER(a-z,${SW_STAGE})})",
        callqos,
        " same = n(done),Return()",
    ]


def render_extensions(opts: dict) -> str:
    rooms = opts.get("rooms", []) or []
    trunk = opts.get("trunk", {}) or {}
    # rooms are pre-validated/deduped by valid_rooms(); keep pjsip + dialplan in sync.
    exts = [r["ext"] for r in rooms]
    operator_on = bool((opts.get("operator") or {}).get("enabled", True))
    mwi_on = bool(opts.get("mwi_enabled", True))
    # Outbound dialing plan. Two modes:
    #   * PREFIX mode (default): dial <prefix><number>; the literal-prefix patterns
    #     out-prioritise the room catch-all so a bare extension still rings a room.
    #   * DIRECT mode: no prefix — outside numbers are recognised by LENGTH
    #     (10-/11-digit NANP), so you dial a phone number straight, like a cell.
    # Direct mode is enabled ONLY by the explicit `direct_dial` toggle. Blanking
    # dial_prefix is deliberately NOT the switch: the HA options form reverts a
    # cleared optional field to its default ("9"), so a blank prefix is unreliable
    # — it keeps the old "fall back to '9'" behaviour instead. `prefix == ""` is
    # the internal signal for direct mode, set only when direct_dial is true.
    direct_dial = bool(trunk.get("direct_dial", False))
    prefix_raw = str(trunk.get("dial_prefix", "9") or "9").strip()
    if direct_dial:
        prefix = ""  # direct-dial (length-based) mode
    elif re.fullmatch(r"[0-9*#]+", prefix_raw):
        prefix = prefix_raw
    else:
        prefix = "9"
        log(f"trunk: invalid dial_prefix {prefix_raw!r}; using '9'")
    if trunk.get("enabled"):
        log("trunk: outbound dialing = "
            + ("DIRECT (1 + 10-digit, no prefix)" if prefix == "" else f"prefix '{prefix}'"))
    caller_id_raw = str(trunk.get("outbound_caller_id", "") or "").strip()
    caller_id = caller_id_raw if re.fullmatch(r"[0-9+]*", caller_id_raw) else ""
    if caller_id != caller_id_raw:
        log("trunk: invalid outbound_caller_id (digits/+ only); ignoring")

    parts = [
        ";; GENERATED by switchboard-config — edits here are overwritten.",
        "",
        "[general]",
        "static = yes",
        "writeprotect = yes",
        "",
        "[globals]",
        "",
        ";; ----- Room-to-room calling -----",
        "[rooms]",
    ]

    if operator_on and exts:
        # Literal '0' out-prioritizes the _X. pattern below, so ordering is safe.
        parts += [
            "exten = 0,1,NoOp(Operator requested by ${CALLERID(num)})",
            " same = n,Goto(operator,s,1)",
            "",
        ]

    # Talking clock — dial the code, hear the local time. A literal extension
    # out-prioritizes the _X. room pattern. Skipped if it collides with a room.
    clock_on = bool(opts.get("clock_enabled", True))
    clock_ext = str(opts.get("clock_ext", "41") or "41").strip()
    clock_emitted = False  # did the inline [rooms] clock dial code actually get emitted?
    if clock_on and exts:
        if not re.fullmatch(r"[0-9]{2,6}", clock_ext):
            log(f"clock: invalid clock_ext {clock_ext!r}; talking clock disabled")
        elif clock_ext in exts:
            log(f"clock: clock_ext {clock_ext} collides with a room ext; talking clock disabled")
        else:
            # Old-style speaking clock that LOOPS until the caller hangs up:
            #   "At the sound of the tone, the time will be <HH MM SS>" <tone>
            # spoken in 24-hour (military) form including seconds. The H:M:S
            # readout is an AGI (switchboard-clock.agi -> clock_speak) rather
            # than SayUnixTime, whose 24h format is quirky (M says "o'clock" for
            # :00 and S support varies). The loop is in the dialplan, so a hangup
            # simply destroys the channel and ends it (the trailing Hangup is a
            # belt-and-braces for a clean fall-through that never happens).
            parts += [
                f"exten = {clock_ext},1,NoOp(Talking clock)",
                " same = n,Answer()",
                " same = n,Set(CHANNEL(language)=en)",
                " same = n,Wait(1)",
                " same = n(loop),Playback(switchboard/sw-at-sound-tone)",
                " same = n,AGI(switchboard-clock.agi)",
                " same = n,Playback(switchboard/sw-tone)",
                " same = n,Wait(2)",
                " same = n,Goto(loop)",
                " same = n,Hangup()",
                "",
            ]
            clock_emitted = True

    # Wake-up calls — dial the code to set/change/cancel by voice. Literal
    # extension; skipped if it collides with a room or the clock.
    wakeup_on = bool(opts.get("wakeup_enabled", True))
    wakeup_ext = str(opts.get("wakeup_ext", "42") or "42").strip()
    if wakeup_on and exts:
        if not re.fullmatch(r"[0-9]{2,6}", wakeup_ext):
            log(f"wakeup: invalid wakeup_ext {wakeup_ext!r}; dial code disabled")
        elif wakeup_ext in exts or (clock_on and wakeup_ext == clock_ext):
            log(f"wakeup: wakeup_ext {wakeup_ext} collides with a room/clock ext; dial code disabled")
        else:
            parts += [
                f"exten = {wakeup_ext},1,NoOp(Wake-up call)",
                " same = n,Goto(wakeup,s,1)",
                "",
            ]

    # The set of literal dial codes already claimed, so each new feature code is
    # checked against rooms, '0' (operator), the ENABLED clock/wakeup codes, AND any
    # earlier feature code — never silently shadowing or being shadowed. A disabled
    # clock/wakeup doesn't reserve its ext, so another feature may reuse it.
    reserved = set(exts) | {"0"}
    if clock_on:
        reserved.add(clock_ext)
    if wakeup_on:
        reserved.add(wakeup_ext)

    # Page intercom — a phone dialing this pages the whole house duplex (Page's
    # 'd' flag = everyone can talk back). Literal extension; skipped on collision.
    page_on = bool(opts.get("page_enabled", True))
    page_ext = str(opts.get("page_ext", "44") or "44").strip()
    page_emitted = False  # did the inline [rooms] page dial code actually get emitted?
    if page_on and exts:
        if not re.fullmatch(r"[0-9]{2,6}", page_ext):
            log(f"page: invalid page_ext {page_ext!r}; page dial code disabled")
        elif page_ext in reserved:
            log(f"page: page_ext {page_ext} collides with a reserved/room ext; page dial code disabled")
        else:
            # Ring every room duplex. Ringing the dialer's own (now busy) line is
            # harmless. Channels are PJSIP endpoints, joined with '&'.
            peers = "&".join(f"PJSIP/{e}" for e in exts)
            parts += [
                f"exten = {page_ext},1,NoOp(Page)",
                f' same = n,Set(PAGEPEERS={peers})',
                " same = n,Page(${PAGEPEERS},d)",
                " same = n,Hangup()",
                "",
            ]
            reserved.add(page_ext)
            page_emitted = True

    # Voice home automation — a phone dialing this enters the lights flow.
    # Literal extension; skipped on collision with rooms/0/clock/wakeup/page.
    automation_on = bool(opts.get("automation_enabled", True))
    automation_ext = str(opts.get("automation_ext", "43") or "43").strip()
    if automation_on and exts:
        if not re.fullmatch(r"[0-9]{2,6}", automation_ext):
            log(f"automation: invalid automation_ext {automation_ext!r}; dial code disabled")
        elif automation_ext in reserved:
            log(f"automation: automation_ext {automation_ext} collides with a reserved/room ext; dial code disabled")
        else:
            parts += [
                f"exten = {automation_ext},1,NoOp(Automation)",
                " same = n,Goto(automation,s,1)",
                "",
            ]
            reserved.add(automation_ext)

    # Local voice assistant — a phone dialing this talks to Home Assistant's
    # built-in conversation agent. Default OFF; same collision rules as the rest.
    assistant_on = bool(opts.get("assistant_enabled", False))
    assistant_ext = str(opts.get("assistant_ext", "47") or "47").strip()
    assistant_emitted = False
    if assistant_on and exts:
        if not re.fullmatch(r"[0-9]{2,6}", assistant_ext):
            log(f"assistant: invalid assistant_ext {assistant_ext!r}; dial code disabled")
        elif assistant_ext in reserved:
            log(f"assistant: assistant_ext {assistant_ext} collides with a reserved/room ext; dial code disabled")
        else:
            parts += [
                f"exten = {assistant_ext},1,NoOp(Assistant)",
                " same = n,Goto(assistant,s,1)",
                "",
            ]
            reserved.add(assistant_ext)
            assistant_emitted = True

    # Dial-a-status voice menu — a phone dialing this hears a menu and can ask for
    # live power / weather / house status. Literal ext; skipped on collision.
    status_on = bool(opts.get("status_enabled", True))
    status_ext = str(opts.get("status_ext", "45") or "45").strip()
    if status_on and exts:
        if not re.fullmatch(r"[0-9]{2,6}", status_ext):
            log(f"status: invalid status_ext {status_ext!r}; dial code disabled")
        elif status_ext in reserved:
            log(f"status: status_ext {status_ext} collides with a reserved/room ext; dial code disabled")
        else:
            parts += [
                f"exten = {status_ext},1,NoOp(Status menu)",
                " same = n,Goto(status,s,1)",
                "",
            ]
            reserved.add(status_ext)

    # Phone -> HA speaker announce — dialing this records a short message and plays
    # it out to the configured media players. Literal ext; skipped on collision.
    announce_on = bool(opts.get("announce_enabled", True))
    announce_ext = str(opts.get("announce_ext", "46") or "46").strip()
    if announce_on and exts:
        if not re.fullmatch(r"[0-9]{2,6}", announce_ext):
            log(f"announce: invalid announce_ext {announce_ext!r}; dial code disabled")
        elif announce_ext in reserved:
            log(f"announce: announce_ext {announce_ext} collides with a reserved/room ext; dial code disabled")
        else:
            parts += [
                f"exten = {announce_ext},1,NoOp(Announce)",
                " same = n,Goto(announce,s,1)",
                "",
            ]
            reserved.add(announce_ext)

    # Directory assistance — dial the code, say a room name, hear its extension,
    # and get connected (411-style, fully internal). Literal ext; skipped on
    # collision. Default 411 (3 digits) never collides with the 2-digit rooms /
    # feature codes.
    directory_on = bool(opts.get("directory_enabled", True))
    directory_ext = str(opts.get("directory_ext", "411") or "411").strip()
    if directory_on and exts:
        if not re.fullmatch(r"[0-9]{2,6}", directory_ext):
            log(f"directory: invalid directory_ext {directory_ext!r}; dial code disabled")
        elif directory_ext in reserved:
            log(f"directory: directory_ext {directory_ext} collides with a reserved/room ext; dial code disabled")
        else:
            parts += [
                f"exten = {directory_ext},1,NoOp(Directory assistance)",
                " same = n,Goto(directory,s,1)",
                "",
            ]
            reserved.add(directory_ext)

    if exts:
        joined = "|".join(exts)
        # When the trunk is live, confine any ##/*2 transfer of a room call to
        # internal-only (anti-toll-fraud) by stamping __TRANSFER_CONTEXT on the
        # calling channel just before 'T' arms. The `dial` label moves onto the
        # Set; with the trunk disabled the line is byte-identical to before.
        if trunk.get("enabled"):
            room_dial = [
                " same = n(dial),Set(__TRANSFER_CONTEXT=internal-xfer)",
                " same = n,Dial(PJSIP/${EXTEN},30,rtT)",
            ]
        else:
            room_dial = [" same = n(dial),Dial(PJSIP/${EXTEN},30,rtT)"]
        parts += [
            "exten = _X.,1,NoOp(Room call to ${EXTEN})",
            # This IS a room-to-room call; say so explicitly rather than letting
            # it inherit the context name that four other call kinds share.
            " same = n,Set(SW_TAG=room)",
            f" same = n,GotoIf($[\"${{EXTEN}}\" : \"^({joined})$\"]?dial:invalid)",
        ] + room_dial + [
            " same = n,Hangup()",
            # Generated congestion tone (no prompt sound file required).
            " same = n(invalid),Congestion(5)",
            " same = n,Hangup()",
            "",
        ]
        # Emergency notices FIRST, and unconditionally: they must not depend on
        # a trunk they never use, and they must sit above _9. in the file.
        parts += render_emergency_notices()
        # Outbound-via-trunk rules belong in [rooms] (alongside the room pattern)
        # so the phones can actually reach them; _<prefix>. out-prioritises _X.
        if trunk.get("enabled"):
            parts += render_outbound_rules(prefix, caller_id)
        # RTP-quality h-extension for [rooms]: captures the initiating phone's leg
        # on room-to-room and outbound calls (they hang up while in [rooms]).
        parts += rtpqos_h("rooms")

    if operator_on and exts:
        parts += render_operator_context("|".join(exts), automation_on, mwi_on,
                                         trunk_on=bool(trunk.get("enabled")),
                                         wakeup_on=wakeup_on,
                                         clock_route=clock_emitted, clock_ext=clock_ext,
                                         status_on=status_on, directory_on=directory_on,
                                         announce_on=announce_on,
                                         page_route=page_emitted, page_ext=page_ext)

    # Internal-only DTMF transfer-target context (anti-toll-fraud). Emitted only
    # when the trunk is live and rooms exist — the sole case where an outside
    # caller could be transferred in AND an outbound _9. rule exists to abuse.
    if trunk.get("enabled") and exts:
        parts += render_internal_xfer_context(exts, operator_on)

    # The [wakeup]/[wakeup-deliver] contexts exist whenever wake-ups are on, even
    # if the dial code collided (the scheduler still delivers into wakeup-deliver).
    if wakeup_on and exts:
        parts += render_wakeup_context()

    # The [page] context exists whenever paging is on even if its dial code
    # collided — ami.page_all Originates each room INTO it to start the intercom.
    if page_on and exts:
        parts += render_page_context()

    # The [automation] context exists whenever automation is on even if its dial
    # code collided — the operator routes a spoken "automation" Goto(automation,s,1).
    if automation_on and exts:
        parts += render_automation_context()

    # The [assistant] context. Unlike [automation] there is no spoken route into
    # it, so it is only emitted when its dial code actually landed.
    if assistant_emitted:
        parts += render_assistant_context()

    # Dial-a-status menu + phone->speaker announce contexts.
    if status_on and exts:
        parts += render_status_context()
    if announce_on and exts:
        parts += render_announce_context()
    # The HA-pushed announcement (POST /api/announce -> ami.announce_to_ext) is a
    # SEPARATE feature from the phone->HA [announce] menu above and is not gated on
    # announce_enabled, so emit its Originate target whenever there are extensions.
    # Inert unless something originates into it.
    if exts:
        parts += render_announce_play_context()
    # Directory assistance context (voice room lookup + connect).
    if directory_on and exts:
        parts += render_directory_context(joined, trunk_on=bool(trunk.get("enabled")))

    # Inbound from the trunk gets its OWN [from-trunk] context. (Outbound rules are
    # emitted up in [rooms] via render_outbound_rules — they must not live here, or
    # they'd land in this inbound context and never match a phone's dialed number.)
    if trunk.get("enabled") and exts:
        # Where an incoming call rings: a comma-separated list of configured room
        # exts (trunk.inbound_ext, e.g. "19,20" = cordless + iPhone), a single ext
        # ("19"), or empty = every room. Each listed ext must pass the same
        # validation as rooms and be a known room; a bad token is dropped + logged
        # so a typo never silently drops the call, and a fully-invalid list falls
        # back to ringing the whole house.
        ring_exts: list[str] = []
        for tok in str(trunk.get("inbound_ext", "") or "").split(","):
            tok = tok.strip()
            if not tok:
                continue
            if not re.fullmatch(r"[0-9]{2,6}", tok):
                log(f"trunk: inbound_ext entry {tok!r} is not a valid ext; dropping")
                continue
            if tok not in exts:
                log(f"trunk: inbound_ext entry {tok!r} is not a room ext; dropping")
                continue
            if tok not in ring_exts:  # preserve order, drop dups
                ring_exts.append(tok)
        if not ring_exts:  # blank or every token invalid -> ring the whole house
            ring_exts = list(exts)
        explicit = ring_exts != list(exts)
        dial_target = "&".join(f"PJSIP/{e}" for e in ring_exts)
        where = ("ring " + ",".join(ring_exts)) if explicit else "ring every room"
        # Dial flags are 'r' only (local ringback). We deliberately do NOT pass
        # 't'/'T' on an inbound trunk call: those arm Asterisk's in-call DTMF
        # transfer codes (##/*2). 'T' would arm them for the *outside* caller — a
        # toll-fraud / dialplan-injection path (an inbound caller could ## then
        # dial a '9' outbound number) — and 't' let the answering cordless
        # accidentally ##-transfer the caller into the operator mid-call (the
        # reported "doesn't fully connect" bug). SIP phones still transfer
        # intentionally via their own Transfer button (SIP REFER, handled
        # natively by chan_pjsip, independent of these flags).
        #
        # NOTE: an endpoint with no registered contact (e.g. the iPhone softphone
        # before it's set up) logs a harmless "invalid URI ... No route to
        # destination" for its own leg while the reachable phones still ring; it
        # self-resolves once that phone registers. We intentionally do NOT gate
        # the ring group on DEVICE_STATE: with qualify on the room AORs, it can't
        # tell "never registered" from "registered but a qualify OPTIONS ping just
        # lapsed" (both read UNAVAILABLE), so gating would risk dropping a
        # momentarily-unreachable primary handset from an inbound call.
        parts += [
            # Distinctive ring for OUTSIDE calls: a pre-dial subroutine tags the
            # INVITE to the answering handset with an Alert-Info header, so the
            # WP826 cordless plays a different ring TONE for an inbound trunk call
            # than for a room-to-room call. Analog FXS handsets ignore the header
            # (their ring cadence is fixed at the gateway) — harmless. b(...) is a
            # pre-dial GoSub option, NOT a t/T DTMF-transfer flag, so it doesn't
            # re-open the inbound toll-fraud path the r-only flags deliberately close.
            ";; ----- Distinctive-ring pre-dial for outside calls -----",
            "[sw-alert]",
            # Alert-Info with a plain-text tag `info=outsideline` (NOT Bellcore-drN,
            # which only selects a ring CADENCE, not a distinct tone — tested on this
            # handset, it does not work). The WP826 carries ONE distinctive-ring match
            # table at P1488/P1489 ("outsideline" -> ring 1001 = the uploaded
            # office_ring.wav), written via tools/wp826.mjs.
            #
            # ★ THE CORDLESS MUST REGISTER ON WP826 ACCOUNT 1 — VERIFIED BY EAR
            # 2026-08-23. The match rule has no effect on the other account slots:
            # the phone just rings its normal tone and nothing you change in the
            # rule makes any difference. Account 1 identity codes are the scattered
            # legacy set: P34 auth password, P35 SIP user ID, P36 auth ID, P47
            # server, P270 account name, P271 account active, P3 display name, P40
            # local SIP port.
            #
            # TRAP that hid this for two test rounds: the rule's ring must DIFFER
            # from the account's OWN default ring, or every call — inside and out —
            # plays the same tone and the two are audibly identical REGARDLESS of
            # whether the rule fires. A listening test CANNOT discriminate while the
            # default equals the exception, so "no change observed" is NOT evidence
            # the rule is dead. Account 1 leaves its ring unset and falls back to the
            # device default P104=2 (a plain ring), keeping the rule's 1001 distinct.
            #
            # The ';' is escaped (\;) so the dialplan parser keeps it as a literal
            # header byte, not a comment. Analog FXS handsets ignore it (harmless).
            r"exten = s,1,Set(PJSIP_HEADER(add,Alert-Info)=<http://127.0.0.1>\;info=outsideline)",
            " same = n,Return()",
            "",
            ";; ----- Inbound from the trunk -----",
            # An adaptive jitter buffer on the trunk channel de-jitters the
            # public-internet RTP from VoIP.ms before it reaches the answering
            # cordless/FXS handset (the LAN legs are low-jitter and need none).
            "[from-trunk]",
            f"exten = _X.,1,NoOp(Inbound call ${{EXTEN}} -> {where})",
            " same = n,Set(JITTERBUFFER(adaptive)=default)",
            f" same = n,Dial({dial_target},30,rb(sw-alert^s^1))",
            " same = n,Hangup()",
            "exten = s,1,NoOp(Inbound call, no DID)",
            " same = n,Set(JITTERBUFFER(adaptive)=default)",
            f" same = n,Dial({dial_target},30,rb(sw-alert^s^1))",
            " same = n,Hangup()",
        ] + rtpqos_h("from-trunk") + [
            "",
        ]

    parts += render_rtpqos_context()
    return "\n".join(parts) + "\n"


# --------------------------------------------------------------------------- #
# confbridge.conf  (intercom conference profiles for the page-all feature)
# --------------------------------------------------------------------------- #
def render_confbridge() -> str:
    """Minimal, quiet ConfBridge profiles for the house page intercom.

    The [page] context joins every ringing room into this bridge. We want a
    barge-in intercom, not a meeting: no music-on-hold, no join/leave beeps or
    name prompts, no "you are the only person" announcement — just open audio.
    """
    return "\n".join([
        ";; GENERATED by switchboard-config — edits here are overwritten.",
        "",
        "[switchboard_bridge]",
        "type = bridge",
        "max_members = 0",            # unlimited; the whole house can join
        "record_conference = no",
        "",
        "[switchboard_user]",
        "type = user",
        "quiet = yes",                # suppress system prompts/tones to the user
        "announce_join_leave = no",   # no join/leave name announcements
        "announce_only_user = no",    # no "you are the only person" spam
        "music_on_hold_when_empty = no",
        "wait_marked = no",
        "end_marked = no",
        "dtmf_passthrough = yes",
        "",
    ]) + "\n"


# --------------------------------------------------------------------------- #
# modules.conf  (load the right MWI/intercom modules)
# --------------------------------------------------------------------------- #
def render_modules(opts: dict) -> str:
    """Generate modules.conf so the features' modules are definitely loaded.

    Everything autoloads, but we explicitly load the three modules the new
    features rely on so a missing one is obvious in the log rather than a silent
    "unknown command": **res_pjsip_notify** (the PJSIPNotify AMI action that
    sends the message-waiting NOTIFY — the FXS stutter tone), and
    **app_confbridge** / **app_page** (the page-all intercom). A failed explicit
    load is non-fatal. NOTE: res_mwi_external (MWIUpdate) is NOT built into the
    Alpine Asterisk package, which is why MWI goes via PJSIPNotify instead.
    """
    lines = [
        ";; GENERATED by switchboard-config — edits here are overwritten.",
        "[modules]",
        "autoload = yes",
        "",
        ";; No local sound card in the container: the ALSA/console channel drivers",
        ";; just spam 'cannot find card 0' / 'Unknown PCM sysdefault' ~50 lines at",
        ";; every startup. All audio here is PJSIP/RTP, so skip them. (noload of a",
        ";; module that isn't built is silently ignored, unlike load.)",
        "noload = chan_alsa.so",
        "noload = chan_console.so",
        "",
        ";; No local call-detail-records consumer: cdr_csv appends to Master.csv on",
        ";; the SD card synchronously per call for records nothing reads. (VoIP.ms",
        ";; keeps the authoritative CDR provider-side.) Skip the dead disk write.",
        "noload = cdr_csv.so",
        "",
        ";; SIP security events (ChallengeSent + SuccessfulAuth on every ~60s",
        ";; re-registration, across the whole fleet) are ~97% of the log volume and",
        ";; cap the add-on log's retention at ~11h — crowding out the operational",
        ";; events that actually matter for a post-mortem. Registration state is",
        ";; already tracked DURABLY by switchboard-rtpmon (linkhealth.jsonl) and a",
        ";; failed phone shows as unregistered there, so dropping the redundant",
        ";; per-attempt security log costs nothing and extends retention to ~weeks.",
        "noload = res_security_log.so",
        "",
        ";; Legacy/unused protocol stacks from the distro sample configs. This is a",
        ";; PJSIP-only system on host networking, so every stray listener sits",
        ";; directly on the LAN: chan_iax2 binds udp/4569, chan_unistim udp/5000,",
        ";; pbx_dundi udp/4520 — none has ever carried a call here. pbx_ael and",
        ";; pbx_lua only load the package's demo dialplans (whose sample contexts",
        ";; and mailbox-1234 hints also spam the boot log); the entire dialplan is",
        ";; generated into extensions.conf.",
        ";; Modules that decline to load anyway and cost an ERROR/WARNING line",
        ";; each on EVERY boot of the durable log (/data/state/asterisk.log).",
        ";; They were noloaded by the shipped static modules.conf, which this",
        ";; generator OVERWRITES — so that silencing was silently lost. Doing it",
        ";; here restores it and removes ~6 lines per boot from a forensic log",
        ";; whose whole value is signal density: there is no local SQLite CDR/CEL",
        ";; consumer, no DAHDI hardware on a Pi, and the ADSI screen-phone stack",
        ";; is deprecated in Asterisk 20 (it warns loudly, then does nothing).",
        "noload = cdr_sqlite3_custom.so",
        "noload = cel_sqlite3_custom.so",
        "noload = chan_dahdi.so",
        "noload = res_adsi.so",
        "noload = app_adsiprog.so",
        "noload = app_getcpeid.so",
        ";; HEP (Homer) capture agents. res_hep itself is disabled, so both",
        ";; agents decline on every boot with a WARNING + an ERROR apiece —",
        ";; four lines to report that a packet-capture protocol we do not run",
        ";; is not running. (res_http_media_cache is deliberately NOT noloaded:",
        ";; its decline is a genuine dependency signal, not a choice of ours.)",
        "noload = res_hep_rtcp.so",
        "noload = res_hep_pjsip.so",
        "",
        "noload = chan_iax2.so",
        "noload = chan_unistim.so",
        "noload = pbx_dundi.so",
        "noload = pbx_ael.so",
        "noload = pbx_lua.so",
        "",
        ";; Voicemail is not part of this system — MWI is delivered by PJSIPNotify",
        ";; (see render_pjsip_notify) and no dialplan line calls VoiceMail(). The",
        ";; stock voicemail family otherwise loads the package's sample",
        ";; voicemail.conf and logs 'Couldn't find mailbox 1234' + a duplicate-app",
        ";; warning at every boot. (noload of a variant that isn't built is",
        ";; silently ignored.)",
        "noload = app_voicemail.so",
        "noload = app_voicemail_imap.so",
        "noload = app_voicemail_odbc.so",
        "noload = app_minivm.so",
        "",
        ";; Message-waiting NOTIFY (stutter tone) + page-all intercom.",
        "load = res_pjsip_notify.so",
        "load = app_confbridge.so",
        "load = app_page.so",
        "",
    ]
    return "\n".join(lines) + "\n"


# --------------------------------------------------------------------------- #
# pjsip_notify.conf  (message-waiting NOTIFY templates for the MWI feature)
# --------------------------------------------------------------------------- #
def render_pjsip_notify() -> str:
    """NOTIFY templates the PJSIPNotify AMI action sends to a room's contact.

    A ``message-summary`` event with ``Messages-Waiting: yes`` is the standard
    unsolicited-MWI NOTIFY; the Grandstream renders it as a stutter dial tone
    (with its "MWI -> stutter" port setting on). "no" clears it. ami.set_mwi
    picks the on/off template by name.
    """
    return "\n".join([
        ";; GENERATED by switchboard-config — edits here are overwritten.",
        "",
        "[switchboard-mwi-on]",
        "Event=message-summary",
        "Content-type=application/simple-message-summary",
        "Content=Messages-Waiting: yes",
        "Content+=Voice-Message: 1/0 (0/0)",
        "",
        "[switchboard-mwi-off]",
        "Event=message-summary",
        "Content-type=application/simple-message-summary",
        "Content=Messages-Waiting: no",
        "Content+=Voice-Message: 0/0 (0/0)",
        "",
    ]) + "\n"


# --------------------------------------------------------------------------- #
# rtp.conf
# --------------------------------------------------------------------------- #
def render_rtp(opts: dict) -> str:
    start = _int(opts.get("rtp_start", 10000) or 10000, 10000)
    end = _int(opts.get("rtp_end", 10200) or 10200, 10200)
    if end <= start:
        log(f"rtp_end ({end}) <= rtp_start ({start}); using {start}-{start + 200}")
        end = start + 200
    return (
        ";; GENERATED by switchboard-config\n"
        "[general]\n"
        f"rtpstart = {start}\n"
        f"rtpend = {end}\n"
    )


# --------------------------------------------------------------------------- #
# manager.conf  (AMI for the Ingress UI, localhost only)
# --------------------------------------------------------------------------- #
def render_manager(ami_user: str, ami_secret: str) -> str:
    return (
        ";; GENERATED by switchboard-config\n"
        "[general]\n"
        "enabled = yes\n"
        "bindaddr = 127.0.0.1\n"
        "port = 5038\n"
        # Asterisk defaults displayconnects=yes, which logs a "Manager 'x' logged
        # on/off" PAIR for every AMI session. The pollers open a short-lived
        # session each cycle, so those pairs were 82.4% of the add-on log in one
        # audit window and 89.4% (3076 of 3438 lines) in the next -- four of every
        # five lines carrying no information, diluting real events ~6x. Two audits
        # each hinged on single lines buried in that churn, and the log the
        # operator actually reads is the one being drowned. AMI is loopback-only
        # with a random per-boot secret, and every session is our own poller, so
        # the connect/disconnect record has no forensic value here; a genuine
        # auth failure logs separately and is unaffected.
        "displayconnects = no\n"
        "\n"
        f"[{ami_user}]\n"
        f"secret = {ami_secret}\n"
        "read = system,call,log,verbose,command,agent,user,config,dtmf,reporting,cdr,dialplan\n"
        # The UI runs PJSIPShowEndpoints / PJSIPShowContacts / CoreShowChannels
        # (gated on these *write* classes) and the per-room "test ring" button
        # (AMI Originate, which needs 'originate'; running it with an Application
        # also needs 'system'). The web app constrains Originate to ringing a
        # *known room ext* with a fixed Playback — never Dial — so it can't place
        # an outside call; AMI itself stays loopback-only with a random secret.
        # 'message' is needed for res_mwi_external's MWIUpdate (message-waiting).
        # 'command' (CLI/RCE) is the ONLY class still deliberately withheld.
        "write = system,call,log,verbose,agent,user,config,dtmf,reporting,cdr,dialplan,originate,aoc,security,message\n"
        "permit = 127.0.0.1/255.255.255.255\n"
    )


# --------------------------------------------------------------------------- #
# logger.conf
# --------------------------------------------------------------------------- #
def render_logger(opts: dict) -> str:
    level = str(opts.get("log_level", "info") or "info").strip()
    base = "notice,warning,error"
    if level in ("debug", "trace"):
        base += ",debug,verbose"
    elif level == "info":
        base += ",verbose"
    # console → the add-on's journald/log endpoint (the live view). PLUS a durable
    # copy on the persistent /data volume: the container's journald log is
    # RAM-backed and rotates in hours, and the host journal is wiped by a reboot —
    # so operational forensics (registration flaps, trunk timeouts, RTP
    # "Network unreachable", any WARNING/ERROR) would otherwise not survive the
    # very event you want to investigate. The file is scoped to notice,warning,error
    # (NO verbose/debug, and with res_security_log noloaded no per-REGISTER security
    # flood), so it grows glacially — the review found ~0 errors in 11h — meaning
    # negligible SD wear and no rotation needed for months. It lives in /data/state
    # (already asterisk-owned + persistent; created by ensure_state_dir()).
    # Channels MUST live under [logfiles] — Asterisk's logger reads ONLY that
    # section (ast_variable_browse(cfg, "logfiles")). With them under [general]
    # Asterisk configured ZERO channels and the durable file never existed;
    # console output survived only via logger.c's empty-channel stdout fallback
    # (unformatted, block-buffered, severity prefixes lost). Found live 2026-08.
    return (
        ";; GENERATED by switchboard-config\n"
        "[general]\n"
        "\n"
        "[logfiles]\n"
        f"console => {base}\n"
        "/data/state/asterisk.log => notice,warning,error\n"
        # The readable twin. Same severities PLUS verbose, because the container
        # log stamps NOTICE/WARNING/ERROR but NOT ast_verbose -- the dialplan
        # trace that shows what a call actually did. A file channel stamps every
        # line, and /share can be read from the host side, unlike /data.
        "/share/switchboard/asterisk.log => notice,warning,error,verbose\n"
    )


def render_features() -> str:
    """features.conf — in-call DTMF transfer codes, for the analog (FXS) phones.

    SIP phones (the cordless and the iPhone softphone) transfer with their own
    on-screen Transfer button (SIP REFER, handled natively by chan_pjsip — no
    config needed). The plain analog phones have no transfer button, so they use
    these in-call DTMF feature codes:
      - blind transfer:    ## then the destination ext, then hang up
      - attended transfer: *2 then the destination ext; talk, then hang up to join
    The 't'/'T' one-touch flags that arm these are set per-Dial by trust, never
    for a PSTN party: room-to-room and operator Dials carry 'tT' (both ends are
    internal); the OUTBOUND trunk Dial carries only 'T' (our caller may transfer,
    the far PSTN callee may not); the INBOUND trunk Dial carries neither (an
    outside caller must not reach our feature codes, and it stops the answering
    cordless from accidentally ##-transferring an inbound caller mid-call).
    parkext/pickup etc. are intentionally omitted (no parking lot configured).
    """
    return "\n".join([
        ";; GENERATED by switchboard-config — edits here are overwritten.",
        "[general]",
        "[featuremap]",
        "blindxfer => ##",
        "atxfer => *2",
        "",
    ])


SHARE_DIR = Path("/share/switchboard")
SHARE_LOG = SHARE_DIR / "asterisk.log"
# Verbose is affordable here only because v0.56.0 turned off displayconnects: the
# AMI logon/logoff pairs were 89.4% of the log. Cap anyway -- Asterisk never
# rotates a logfiles channel, and an unbounded forensic log is its own outage.
SHARE_LOG_MAX_BYTES = 32 * 1024 * 1024


def ensure_share_log_dir() -> None:
    """Create /share/switchboard, asterisk-writable, for the READABLE copy of the
    Asterisk log -- and trim it if it has grown past the cap.

    /data/state/asterisk.log already exists as the durable forensic log, and it is
    the right place for it: /data survives even if /share is unmounted. But it
    cannot be READ. The container shell is blocked by protection mode, backups are
    encrypted (SecureTar), and the add-on API returns 403 on every path -- so the
    log written specifically for post-incident forensics is unreachable at exactly
    the moment it is wanted. An audit called this "the single highest-value unlock".

    /share is mapped writable and readable from the host side, so a second channel
    here is the whole fix. It also carries `verbose`, which the /data one omits:
    NOTICE/WARNING/ERROR reach the container log already stamped, but ast_verbose
    output -- the `-- Executing [...]` dialplan trace, i.e. the actual call flow --
    does not, and 0 of 3438 container-log lines in one audit window carried a
    timestamp at all. A file channel stamps every line, so the call flow finally
    becomes correlatable with host.log and the Supervisor.

    Asterisk runs as -U asterisk, so it must own the directory to open the file.
    Best-effort throughout: a logging convenience must never block a PBX start."""
    try:
        SHARE_DIR.mkdir(parents=True, exist_ok=True)
        # v0.74.0 — SETGID + GROUP-WRITABLE. Two processes append here: the
        # scheduler as root and the AGI as `asterisk`. Whichever creates a file
        # decides whether the other can write it, and root created them 0644 —
        # so the AGI's `answered` record failed with EACCES on every wake-up,
        # silently, and the reconciler read that as "nobody answered".
        #
        # 02775: setgid so new files inherit the directory's group rather than
        # the creator's, and group-write so both users can append. Existing files
        # are migrated below — this runs as root at init, which is the only place
        # that can repair a file root already owns.
        try:
            # ADD setgid + group-write to whatever mode the directory already
            # has, rather than asserting a literal 0o2775. The change this needs
            # to make is "the second writer is not locked out and new files
            # inherit the group" — not "this directory is world-readable", which
            # is already true and is the entire purpose of /share (see the
            # docstring above). Asserting the broader claim also trips
            # py/overly-permissive-file, which this repo has dismissed as
            # won't-fix seven times in this same file for exactly this reason.
            os.chmod(SHARE_DIR, SHARE_DIR.stat().st_mode | stat.S_ISGID | stat.S_IWGRP)
            _ast = pwd.getpwnam("asterisk")
            os.chown(SHARE_DIR, _ast.pw_uid, _ast.pw_gid)
            for _f in SHARE_DIR.iterdir():
                if _f.is_file():
                    # ADD group-write to the existing mode rather than asserting
                    # a literal one: the fix is "the other writer is not locked
                    # out", not "these files are world-readable" — that part is
                    # already true and is the point of /share.
                    os.chmod(_f, _f.stat().st_mode | stat.S_IWGRP)
                    os.chown(_f, _ast.pw_uid, _ast.pw_gid)
        except (OSError, KeyError) as exc:
            log(f"share dir: could not normalise ownership ({exc}); "
                f"the AGI may be unable to append to the ledgers")
        try:
            if SHARE_LOG.exists() and SHARE_LOG.stat().st_size > SHARE_LOG_MAX_BYTES:
                # Truncate rather than delete: keep the inode so a running Asterisk
                # (on a config reload rather than a cold start) keeps writing.
                with open(SHARE_LOG, "w", encoding="utf-8"):
                    pass
                log(f"trimmed {SHARE_LOG} (was over {SHARE_LOG_MAX_BYTES // (1024*1024)} MB)")
        except OSError as exc:
            log(f"WARN could not trim {SHARE_LOG}: {exc}")
        import shutil as _sh
        try:
            _sh.chown(str(SHARE_DIR), user="asterisk", group="asterisk")
        except (LookupError, KeyError, PermissionError, OSError) as exc:
            log(f"WARN could not chown {SHARE_DIR}: {exc}")
        if SHARE_LOG.exists():
            try:
                _sh.chown(str(SHARE_LOG), user="asterisk", group="asterisk")
            except (LookupError, KeyError, PermissionError, OSError):
                pass
        log(f"share log dir ready: {SHARE_DIR}")
    except OSError as exc:
        # /share not mapped, read-only, or full -- Asterisk will log its own
        # failure to open the channel and carry on with the /data one.
        log(f"WARN share log dir unavailable ({exc}); /data/state/asterisk.log only")


def ensure_state_dir() -> None:
    """Create /data/state, owned by the asterisk user, for the runtime JSON stores.

    The wake-up store (wakeup/store.py) and the MWI store (webui/mwi_store.py) are
    written by BOTH the root services (wakeup-scheduler, webui) AND asterisk-user
    processes — the dial-42 wake-up AGI and the dialplan's
    ``System(/usr/bin/switchboard-mwi clear ...)``. Asterisk runs as ``-U asterisk``,
    so those processes must be able to create the flock ``.lock`` and atomic-rename
    temp files NEXT TO the JSON (an os.replace needs write on the containing dir).

    These stores used to live directly in ``/data``, which only root can write — so
    every voice wake-up crashed with ``EPERM`` on ``/data/wakeups.json.lock`` (the
    dial-42 flow fell straight through with NO recording prompt) and the dial-0 MWI
    auto-clear crashed on ``/data/mwi.json.lock``. A dedicated asterisk-owned subdir
    fixes both while leaving the sensitive ``/data/options.json`` root-only. Root
    services keep writing here (root overrides the mode); asterisk owns the dir so
    its os.replace can swap a file the root service last wrote, and vice-versa.

    Runs in the init oneshot as root, BEFORE Asterisk starts. Best-effort migrates a
    pre-existing /data/{wakeups,mwi}.json so a pending wake-up/flag survives the move.
    """
    import shutil
    names = ("wakeups.json", "mwi.json")
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        # Migrate any pre-existing store from the old root-only /data location.
        for name in names:
            old, new = DATA_DIR / name, STATE_DIR / name
            if old.exists() and not new.exists():
                try:
                    old.replace(new)  # same filesystem under /data
                except OSError as exc:
                    log(f"WARNING: could not migrate {name} into state dir: {exc}")
        # Pre-create the JSON + flock files so they exist group-writable BEFORE any
        # service opens them. The lock is opened in append mode (needs write on the
        # FILE), and an atomic write leaves the JSON owned by whichever user wrote
        # last — so without a shared group both the root services and the asterisk
        # user would lock each other out. setgid on the dir makes new temp/lock files
        # inherit the asterisk group; 0664 keeps them group-writable.
        for name in names:
            p = STATE_DIR / name
            if not p.exists():
                p.write_text("{}")
            lock = STATE_DIR / (name + ".lock")
            if not lock.exists():
                lock.write_text("")
        # chmod FIRST (always works as root) so an absent asterisk user off-box can't
        # leave the modes unset; then hand the dir + files to the asterisk user.
        os.chmod(STATE_DIR, 0o2775)  # setgid → children inherit the asterisk group  # intentional: shared state dir; the asterisk user needs it (setgid keeps the group)
        for f in STATE_DIR.iterdir():
            try:
                os.chmod(f, 0o664)  # intentional: root services AND the asterisk-user AGIs share this file; group access is required
            except OSError:
                pass
        try:
            shutil.chown(STATE_DIR, user="asterisk", group="asterisk")
            for f in STATE_DIR.iterdir():
                shutil.chown(f, user="asterisk", group="asterisk")
        except (LookupError, KeyError, PermissionError, OSError) as exc:
            log(f"WARNING: could not chown state dir to asterisk: {exc}")
    except (PermissionError, LookupError, KeyError, OSError) as exc:
        # The init oneshot is root, so this normally succeeds; warn (don't crash)
        # if something is off — the rest of the config still renders.
        log(f"WARNING: could not prepare asterisk-writable state dir: {exc}")
    # Surface a silent setup failure LOUDLY: if the dir isn't group-writable, the
    # asterisk-user wake-up AGI + MWI-clear will EACCES again exactly as before, and
    # the only other signal would be a single buried WARNING. Rare (init is root,
    # /data is always mounted, and this re-runs idempotently every boot), but worth
    # an ERROR line so it can't masquerade as a healthy boot.
    try:
        mode = STATE_DIR.stat().st_mode
        if not (STATE_DIR.is_dir() and (mode & 0o020)):
            log(f"ERROR: /data/state not group-writable (mode {oct(mode)}); dial-42 "
                "wake-up + dial-0 MWI-clear may fail with permission denied")
    except OSError:
        log("ERROR: /data/state missing after setup; dial-42 wake-up + dial-0 "
            "MWI-clear may fail with permission denied")


def write_operator_runtime(opts: dict) -> None:
    """Stage the shared voice runtime (rooms map), when a consumer is enabled.

    Writes a sanitized rooms map the STT wrapper reads — so the recognizer shares
    the generator's already-validated room list (single source of truth) instead
    of re-parsing raw options.json. Synonyms come from the optional
    ``operator_synonyms`` option.

    Both the voice operator (dial 0) AND directory assistance (dial 411) resolve
    room names against this file, so it must be staged when EITHER is on — gating
    it on ``operator.enabled`` alone would leave dial-411 with an empty directory
    ("Directory is unavailable") whenever the operator is turned off, the same
    feature-independence trap ``ensure_voice_dirs`` was extracted to avoid.
    """
    operator_on = bool((opts.get("operator") or {}).get("enabled", True))
    directory_on = bool(opts.get("directory_enabled", True))
    if not (operator_on or directory_on):
        return

    synonyms: dict[str, list[str]] = {}
    for entry in (opts.get("operator_synonyms") or []):
        ext = str(entry.get("ext", "")).strip()
        phrases = [str(p).strip() for p in (entry.get("phrases") or []) if str(p).strip()]
        if ext and phrases:
            synonyms.setdefault(ext, []).extend(phrases)

    payload = {
        # opts["rooms"] is already valid_rooms()-validated by main().
        "rooms": [{"ext": r["ext"], "name": r["name"]} for r in (opts.get("rooms") or [])],
        "synonyms": synonyms,
        "threshold": 0.6,
    }
    op_path = RUN_DIR / "operator.json"
    op_path.write_text(json.dumps(payload))
    try:
        import shutil
        shutil.chown(op_path, user="asterisk", group="asterisk")
        os.chmod(op_path, 0o640)  # intentional: 0640 root:asterisk — the asterisk group MUST read it (that is the point)
    except (PermissionError, LookupError, KeyError, OSError) as exc:
        # The init oneshot runs as root before Asterisk starts, so this normally
        # succeeds; warn (don't crash) if the asterisk user isn't present yet.
        log(f"WARNING: could not set asterisk ownership on operator runtime: {exc}")
    log(f"operator: staged {len(payload['rooms'])} room(s) for voice recognition")


def ensure_voice_dirs() -> None:
    """Create the asterisk-writable ASR record dir + announcement-audio dir under
    /run (tmpfs). These are needed by the wake-up, status, automation AND announce
    AGIs — all toggleable INDEPENDENTLY of the voice operator — so they must exist
    regardless of ``operator.enabled`` (they used to live in write_operator_runtime,
    which early-returns when the operator is off, silently breaking dial-46/45)."""
    import shutil
    asr_dir = RUN_DIR / "asr"
    announce_dir = RUN_DIR / "announce"
    try:
        asr_dir.mkdir(parents=True, exist_ok=True)
        announce_dir.mkdir(parents=True, exist_ok=True)
        shutil.chown(asr_dir, user="asterisk", group="asterisk")
        os.chmod(asr_dir, 0o750)  # intentional: shared state dir; the asterisk user needs it (setgid keeps the group)
        shutil.chown(announce_dir, user="asterisk", group="asterisk")
        os.chmod(announce_dir, 0o755)  # intentional: shared state dir; the asterisk user needs it (setgid keeps the group)
    except (PermissionError, LookupError, KeyError, OSError) as exc:
        log(f"WARNING: could not prepare asterisk voice dirs: {exc}")


_EID_RE = re.compile(r"^[a-z_]+\.[a-z0-9_]+$")


def _clean_eid(val: str, domains: tuple = ()) -> str:
    """A well-formed entity_id — optionally restricted to the given domain(s) — or
    '' (drops anything malformed / wrong-domain before it's staged for an AGI, so a
    mistyped `homeassistant.restart` or `shell_command.x` can never reach HA)."""
    s = str(val or "").strip()
    if not _EID_RE.match(s):
        return ""
    if domains and s.split(".", 1)[0] not in domains:
        return ""
    return s


def _wakeup_scene_map(opts: dict) -> dict:
    """`wakeup_scenes` rows → {ext: scene}, validated against the room list."""
    known = {str(r.get("ext")) for r in (opts.get("rooms") or []) if r.get("ext")}
    out = {}
    for row in (opts.get("wakeup_scenes") or []):
        if not isinstance(row, dict):
            continue
        ext = str(row.get("ext", "") or "").strip()
        scene = _clean_eid(row.get("scene", ""), ("scene",))
        if not ext or not scene:
            continue
        if known and ext not in known:
            log(f"wakeup_scenes: ext {ext!r} is not a configured room; dropping")
            continue
        out[ext] = scene
    return out


def check_gateway_ports(opts: dict) -> list:
    """Gateway ports that are NOT configured rooms. Returns the offending list.

    `gateway_ports` names the FXS extensions the health monitors treat as "the
    wired gateway". Nothing validated it against the actual rooms, so the 1xx
    numbering the docs themselves suggest (rooms 101/102 with the default
    gateway_ports 11-18) leaves the two health features quietly inert: gateway
    health sees zero of its ports in the fleet and stays "ok" forever, and
    wired link health has nothing to take a median of and reads "unknown".
    Both look healthy, which is the worst possible failure for a monitor."""
    room_exts = {str(r.get("ext", "")).strip() for r in (opts.get("rooms") or [])}
    raw = str(opts.get("gateway_ports", "") or "")
    ports = [e.strip() for e in raw.split(",") if e.strip()]
    return [p for p in ports if p not in room_exts]


def write_features_runtime(opts: dict) -> None:
    """Stage the HA-integrated voice-feature settings (smart wake-up + announce)
    for the AGIs, which run as the asterisk user and CANNOT read root-only
    /data/options.json. Written to /run/switchboard/features.json (tmpfs,
    asterisk-readable). Entity ids are validated here as defence in depth."""
    players = [e for e in (_clean_eid(p, ("media_player",)) for p in (opts.get("announce_players") or [])) if e]
    payload = {
        "wakeup": {
            "scene": _clean_eid(opts.get("wakeup_scene", ""), ("scene",)),
            # Per-room scenes: {ext: scene_entity}. Only rows naming a REAL room
            # and a valid scene id survive, so a stale ext can't strand a scene
            # that never fires (and an invalid entity can't reach HA).
            "scenes": _wakeup_scene_map(opts),
            "weather": bool(opts.get("wakeup_weather", True)),
            "calendar": _clean_eid(opts.get("wakeup_calendar", ""), ("calendar",)),
        },
        "announce": {
            "players": players,
        },
        # switchboard-callqos runs from the dialplan h-extension AS the asterisk
        # user, so it reads the poor-call alert opt-out here (root-only
        # /data/options.json is unreadable to it — the whole reason this file exists).
        "callqos": {
            "alerts": bool(opts.get("call_quality_alerts", True)),
        },
        # Dial-a-status "power" entities. These used to be hardcoded to THIS
        # author's EcoFlow sensor ids with a comment claiming they were
        # overridable here — they were not: nothing ever passed an override, so
        # on any other install the branch silently read entities that do not
        # exist. Now they are options, staged like everything else the AGIs need.
        "status": {
            "power": {
                "grid": _clean_eid(opts.get("status_power_grid", ""),
                                   ("input_boolean", "binary_sensor", "sensor", "switch")),
                "battery": _clean_eid(opts.get("status_power_battery", ""), ("sensor",)),
                "runway": _clean_eid(opts.get("status_power_runway", ""), ("sensor",)),
                "solar": _clean_eid(opts.get("status_power_solar", ""), ("sensor",)),
            },
        },
    }
    fp = RUN_DIR / "features.json"
    fp.write_text(json.dumps(payload))
    try:
        import shutil
        shutil.chown(fp, user="asterisk", group="asterisk")
        os.chmod(fp, 0o640)  # intentional: 0640 root:asterisk — the asterisk group MUST read it (that is the point)
    except (PermissionError, LookupError, KeyError, OSError) as exc:
        log(f"WARNING: could not set asterisk ownership on features runtime: {exc}")
    w = payload["wakeup"]
    log(f"features: wake-up(scene={'set' if w['scene'] else 'none'}, weather={w['weather']}, "
        f"calendar={'set' if w['calendar'] else 'none'}), announce({len(players)} player(s))")


def main() -> None:
    opts = load_options()
    # Snapshot the effective (post-overlay, pre-sanitize) options for the s6 run
    # scripts before anything mutates opts — bashio reads options.json directly
    # and would bypass the overlay, so switchboard-opt reads this instead.
    effective = dict(opts)
    # Validate/sanitize/dedupe rooms once; both renderers consume the cleaned list.
    opts["rooms"] = valid_rooms(opts.get("rooms", []) or [])
    if not opts["rooms"]:
        log("WARNING: no valid rooms configured — no phones will register")
    stray = check_gateway_ports(opts)
    if stray:
        log(f"WARNING: gateway_ports lists {', '.join(stray)}, which are not configured "
            "rooms — gateway health and wired link health cover only real room "
            "extensions, so they will under-report (or read 'unknown') until this matches")
    ASTERISK_ETC.mkdir(parents=True, exist_ok=True)
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    write_effective_options(effective)
    # Make /data/state asterisk-writable BEFORE Asterisk starts, so the dial-42
    # wake-up AGI and the dialplan's MWI-clear (both run as the asterisk user) can
    # write their JSON stores instead of crashing with EPERM.
    ensure_state_dir()
    ensure_share_log_dir()
    # Set the container's local time before Asterisk/console start, so the
    # talking clock and console clock read local time.
    tz = apply_timezone(resolve_timezone(opts))
    (RUN_DIR / "tz").write_text(tz + "\n")
    ensure_voice_dirs()          # ASR + announce dirs (needed even if operator off)
    write_operator_runtime(opts)
    write_features_runtime(opts)

    ami_user = "switchboard"
    ami_secret = gen_secret()

    write(ASTERISK_ETC / "pjsip.conf", render_pjsip(opts))
    write(ASTERISK_ETC / "extensions.conf", render_extensions(opts))
    write(ASTERISK_ETC / "confbridge.conf", render_confbridge())
    write(ASTERISK_ETC / "modules.conf", render_modules(opts))
    write(ASTERISK_ETC / "pjsip_notify.conf", render_pjsip_notify())
    write(ASTERISK_ETC / "rtp.conf", render_rtp(opts))
    write(ASTERISK_ETC / "manager.conf", render_manager(ami_user, ami_secret))
    write(ASTERISK_ETC / "logger.conf", render_logger(opts))
    write(ASTERISK_ETC / "features.conf", render_features())

    # The AMI secret must exist on file for dialplan-System()-spawned consumers
    # (switchboard-mwi) to authenticate; it lives in tmpfs (/run, RAM-backed), is
    # regenerated on every boot, and AMI itself binds 127.0.0.1 only. Created 0640
    # atomically (os.open) so no default-umask window ever exposes it; asterisk
    # group gets read via the group chown below.
    env_path = RUN_DIR / "ami.env"
    fd = os.open(str(env_path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)  # intentional: 0640 root:asterisk — the asterisk group MUST read it (that is the point)
    with os.fdopen(fd, "w") as fh:
        fh.write(f"AMI_USER={ami_user}\nAMI_SECRET={ami_secret}\n")
    try:
        import shutil
        os.chmod(env_path, 0o640)  # intentional: 0640 root:asterisk — the asterisk group MUST read it (that is the point)
        shutil.chown(env_path, group="asterisk")
    except (PermissionError, LookupError, KeyError, OSError):
        pass
    log(f"wrote {env_path}")

    n_rooms = len(opts.get("rooms", []) or [])
    trunk_on = bool((opts.get("trunk") or {}).get("enabled"))
    log("codecs: u-law only (no transcoding)")
    log(f"done: {n_rooms} room(s), trunk={'on' if trunk_on else 'off'}")


if __name__ == "__main__":
    main()
