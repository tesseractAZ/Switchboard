#!/usr/bin/python3
"""Switchboard assistant — a fully-local phone -> Home Assistant voice path.

Reached from the [assistant] dialplan context (dial the assistant code). The
whole loop is:

    greet -> record an utterance -> transcribe -> ask Home Assistant -> speak

Nothing on that path leaves the Pi. The recording is transcribed by the
add-on's own whisper server (``switchboard-stt``), the text is handed to Home
Assistant's BUILT-IN intent matcher (``conversation.home_assistant`` via
``ha_client.converse``), and the reply is synthesized by the add-on's own espeak-ng
voice (``switchboard-tts``). No cloud STT, no cloud TTS, no cloud agent -- an
internet outage does not disturb it.

This is deliberately NOT a Wyoming "voice satellite". A satellite streams raw
audio to Home Assistant and lets HA own the whole pipeline; that would put a
second STT and a second TTS in the path when Switchboard already has both, and
it would need a persistent stream per call. Sending TEXT to HA and speaking the
text it returns reuses what is already installed and keeps each call a couple of
short local HTTP round-trips.

Scope note: each utterance is a fresh one-shot request, and threading a
conversation_id would NOT change that. Measured against this Home Assistant
2026-09-05: `continue_conversation` comes back FALSE on every ambiguous
utterance tried ("what is the temperature", "turn on the lights", "is the light
on", "what is the humidity"), and a second turn sent WITH the returned
conversation_id is matched as a fresh independent sentence rather than as a
continuation. The built-in agent is a one-shot sentence matcher, not a dialogue
manager -- it never asks "which light?", it just fails. So the phone flow
re-prompts and treats every utterance as a complete command, which is the only
shape this agent supports.

Channel-safe by construction: the top-level handler swallows every exception so
the channel never wedges, and a TTS, STT or HA failure degrades to a canned
spoken apology + graceful hangup -- the caller is never left in silence.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time

# Foundation modules: ha_client (HA Core API, incl. the local conversation agent)
# and assistant_log (the durable per-turn ledger — see its module docstring for
# why this does NOT go through Asterisk's logger).
sys.path.insert(0, "/usr/share/switchboard/webui")
try:
    import ha_client  # noqa: E402
except Exception:  # noqa: BLE001  (degrade gracefully if the client won't import)
    ha_client = None
try:
    import assistant_log  # noqa: E402
except Exception:  # noqa: BLE001  (telemetry must never stop the assistant)
    assistant_log = None

# Staged by switchboard-config for processes running as the asterisk user. This
# is the ONLY configuration channel that reaches an AGI: Asterisk forks it, not
# s6, so an env export from a run script cannot reach here, and
# /run/switchboard/options-effective.json is 0600 root-only.
FEATURES = "/run/switchboard/features.json"

STT = "/usr/bin/switchboard-stt"
TTS = "/usr/bin/switchboard-tts"
ASR_DIR = "/run/switchboard/asr"
RECORD_MS = 8000        # a sentence-length command needs longer than a room name
SILENCE_S = 3
MAX_TURNS = 5           # hard cap so a stuck line cannot hold the channel open
MAX_EMPTY = 2           # consecutive silent/unrecognized turns before goodbye

# Canned prompts shipped with the add-on (used for the greeting + apology so the
# flow still has *some* voice even if TTS is broken).
PROMPT_BEEP = "switchboard/sw-beep"
PROMPT_ONEMOMENT = "switchboard/sw-onemoment"
PROMPT_GOODBYE = "switchboard/sw-goodbye"          # best-effort; may be absent

# Spoken words that end the call. Matched as whole words against the transcript
# so "turn off the hall light" does not hang up on the word "off".
GOODBYE_WORDS = frozenset({
    "goodbye", "bye", "cancel", "nevermind", "quit", "exit", "stop",
    "hangup", "disconnect", "thanks", "thank", "done",
})

# Command vocabulary fed to whisper as a decoding bias alongside the live entity
# and area names. Without these the recognizer has no prior for the words the
# prompt actually invites, and short utterances ("off", "list") are the ones it
# gets wrong most often.
BIAS_VERBS = (
    "turn on, turn off, set, open, close, lock, unlock, start, stop, "
    "what is, how, temperature, lights, scene, goodbye, cancel, never mind"
)

_tts_seq = 0  # monotonically increasing so each utterance gets a unique file


# --------------------------------------------------------------------------- #
# AGI plumbing (same shape as the operator / automation / wakeup AGIs)
# --------------------------------------------------------------------------- #
def read_env() -> dict:
    env: dict[str, str] = {}
    while True:
        line = sys.stdin.readline()
        if not line or not line.strip():
            break
        if ":" in line:
            k, v = line.split(":", 1)
            env[k.strip()] = v.strip()
    return env


def load_features() -> dict:
    """The staged /run/switchboard/features.json, or {} — same shape and same
    failure behaviour as agi_speech.load_features(). Copied rather than imported
    because this AGI is deliberately self-contained (it does not import
    agi_speech at all) and one dict read is not worth taking that dependency."""
    try:
        with open(FEATURES, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def call_id(env: dict) -> dict:
    """The join key back to callqos.jsonl, from the AGI environment.

    `read_env()`'s return value used to be discarded on the very next line, which
    threw away the only identifiers this process ever sees. Without them a row in
    the assistant ledger could not be lined up against the call-quality row for
    the same call, so "the assistant gave a wrong answer" and "the audio was
    poor" stayed unrelated facts about the same sixty seconds.
    """
    chan = env.get("agi_channel", "")
    m = re.match(r"PJSIP/(\d{2,6})-", chan)
    return {"chan": chan or None,
            "call": env.get("agi_uniqueid") or None,
            "ext": (m.group(1) if m else None)}


def agi(command: str) -> str:
    sys.stdout.write(command + "\n")
    sys.stdout.flush()
    return sys.stdin.readline().strip()


def stream(soundfile: str) -> None:
    agi(f'STREAM FILE {soundfile} ""')


def log(msg: str) -> None:
    sys.stderr.write(f"[assistant] {msg}\n")


# --------------------------------------------------------------------------- #
# Speech: dynamic via switchboard-tts -> Playback; canned fallback otherwise.
# --------------------------------------------------------------------------- #
def say(text: str) -> bool:
    """Synthesize `text` with switchboard-tts and Playback it. Returns True on
    success. On any failure the caller should fall back to a canned prompt --
    this function never raises."""
    global _tts_seq
    _tts_seq += 1
    base = f"/tmp/sw-asst-{os.getpid()}-{_tts_seq}"
    wav = base + ".wav"
    try:
        proc = subprocess.run([TTS, text, base], capture_output=True,
                              text=True, timeout=25)
        if proc.returncode != 0 or not os.path.exists(wav):
            log(f"tts failed rc={proc.returncode} for {text!r}: {(proc.stderr or '').strip()}")
            return False
        # Playback wants the path WITHOUT extension.
        agi(f"EXEC Playback {base}")
        return True
    except (subprocess.TimeoutExpired, OSError) as exc:
        log(f"tts error for {text!r}: {exc}")
        return False
    finally:
        try:
            os.unlink(wav)
        except OSError:
            pass


def say_or(text: str, fallback_prompt: str) -> bool:
    """Speak dynamic `text`; if TTS fails, play a canned prompt so there's never
    dead air. Returns True if the DYNAMIC text was spoken.

    v0.80.0 — this returned None, so a caller could not tell whether the person
    on the phone heard the assistant's actual answer or a canned beep in its
    place. That distinction is the difference between "answered correctly" and
    "said something unrelated", and the ledger has to be able to record it.
    """
    if say(text):
        return True
    stream(fallback_prompt)
    return False


def apologize_and_bye() -> None:
    """Graceful degradation: one spoken (or canned) apology, then return so the
    dialplan hangs up."""
    if not say("Sorry, the assistant is unavailable right now. Goodbye."):
        stream(PROMPT_GOODBYE)


# --------------------------------------------------------------------------- #
# Recording + recognition
# --------------------------------------------------------------------------- #
def _record_result(raw: str) -> dict:
    """Decode Asterisk's RECORD FILE reply.

    It answers ``200 result=<0|-1|digit> (timeout|hangup|dtmf) endpos=<samples>``,
    and this AGI used to throw the whole string away. That one line carries the
    two facts most needed to explain an empty turn: how much audio was actually
    captured, and whether the recording ended because the caller stopped talking,
    hung up, or pressed a key. Without it, a caller who hung up mid-sentence and a
    caller who said nothing are the same event — and they are not.

    endpos is a sample count at the channel rate (8 kHz here), so /8 is
    milliseconds.
    """
    out = {}
    m = re.search(r"endpos=(\d+)", raw or "")
    if m:
        out["rec_ms"] = int(m.group(1)) // 8
    for word in ("hangup", "dtmf", "timeout"):
        if f"({word})" in (raw or ""):
            out["rec_end"] = word
            break
    return out


def listen(tag: str, attempt: int, bias: str = "") -> tuple:
    """Record one utterance. Returns (text, meta) — '' and a REASON on nothing.

    The meta dict exists because five distinct failures used to collapse into the
    same empty string and be counted identically: a spawn error, a timeout, a
    whisper-server hang, an STT error, and genuine silence. A ledger that only
    recorded "empty" would reproduce exactly the blindness it was built to fix,
    so every one of them now carries its own `stt` reason.
    """
    rec = f"{ASR_DIR}/asst-{os.getpid()}-{tag}-{attempt}"
    stream(PROMPT_BEEP)
    meta = _record_result(agi(f'RECORD FILE {rec} wav "" {RECORD_MS} s={SILENCE_S}'))
    wav = rec + ".wav"
    try:
        # Measured BEFORE the unlink below, which is where the only after-the-fact
        # evidence of what RECORD actually captured used to be destroyed. The
        # operator AGI has always kept this; the assistant never did.
        meta["wav_bytes"] = os.path.getsize(wav)
    except OSError:
        meta["wav_bytes"] = 0
    text = ""
    cmd = [STT, "--in", wav, "--mode", "transcribe"]
    if bias:
        cmd += ["--bias", bias]
    # Start STT before the "one moment" prompt so inference overlaps its playback
    # (the child only touches the WAV + loopback whisper-server, not the channel).
    t0 = time.monotonic()
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                stdin=subprocess.DEVNULL, text=True)
    except OSError as exc:
        log(f"stt spawn error: {exc}")
        meta["stt"] = "spawn-error"
        meta["stt_err"] = str(exc)[:200]
        proc = None
    stream(PROMPT_ONEMOMENT)
    try:
        if proc is not None:
            so, se = proc.communicate(timeout=30)
            text = (so or "").strip()
            if se:
                sys.stderr.write(se)
                # Whisper's own account of what it did, kept only when the turn
                # produced nothing — that is when it is the whole explanation.
                if not text:
                    meta["stt_err"] = se.strip()[:200]
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            # ...and collect what it managed to say before the kill. Both handlers
            # used to drop the child's stderr entirely, losing whisper's
            # explanation of the failure at precisely the moment it mattered.
            #
            # `except Exception`, not `except OSError`: this SECOND communicate()
            # can itself raise TimeoutExpired — a killed child whose pipe has not
            # closed yet is exactly the state we are in — and OSError does not
            # catch that. It would then propagate out of listen(), out of main(),
            # and end a live call from inside the cleanup path of an error that
            # was already being handled.
            _, se = proc.communicate()
            if se:
                meta["stt_err"] = se.strip()[:200]
        except Exception:  # noqa: BLE001  (cleanup must never end the call)
            pass
        log("stt timeout")
        meta["stt"] = "timeout"
    except OSError as exc:
        if proc is not None:
            try:
                proc.kill()
                _, se = proc.communicate()
                if se:
                    meta["stt_err"] = se.strip()[:200]
            except Exception:  # noqa: BLE001  (same hazard as above)
                pass
        log(f"stt error: {exc}")
        meta["stt"] = "error"
        meta.setdefault("stt_err", str(exc)[:200])
    finally:
        meta["stt_ms"] = int((time.monotonic() - t0) * 1000)
        try:
            os.unlink(wav)
        except OSError:
            pass
    if not text and "stt" not in meta:
        # Nothing went wrong and nothing was said. That IS a distinct outcome and
        # the only one of the five that means the recogniser is healthy.
        meta["stt"] = "silence"
    return text, meta


# --------------------------------------------------------------------------- #
# Pure helpers (unit-tested without a channel)
# --------------------------------------------------------------------------- #
def normalize(text: str) -> str:
    """Lowercase and strip punctuation so word matching is stable. Whisper
    punctuates ('Goodbye.') and a naive `in` test would miss it."""
    return "".join(c if (c.isalnum() or c.isspace()) else " " for c in (text or "").lower())


# Multi-word endings folded to a single terminator token before matching.
# Needed because normalize() splits on whitespace and whisper transcribes these
# as separate words -- "never mind" would otherwise be two filler words with no
# terminator among them, and so not a goodbye at all.
GOODBYE_PHRASES = (
    ("never mind", "nevermind"),
    ("that s all", "goodbye"),
    ("that is all", "goodbye"),
    ("that s it", "goodbye"),
    ("that is it", "goodbye"),
)

# A bare decline. These are NOT goodbye words — a goodbye word ends the call
# whenever it appears in an otherwise-filler utterance, and "no" appears inside
# real commands ("no, the kitchen one"). They end the call only when the whole
# utterance is a decline, which the rule in is_goodbye() enforces.
DECLINE_WORDS = {"no", "nope", "nah"}


def is_goodbye(text: str) -> bool:
    """True when the caller asked to end the call.

    Whole-UTTERANCE matching, not substring: "stop the music" and "cancel my
    seven a m wake up" both contain a goodbye word but are real commands, so a
    goodbye is recognized only when SOME word is a terminator AND EVERY word is
    either a terminator or filler around one. "that's all, thanks" therefore
    ends the call while "turn on the kitchen light, thanks" does not."""
    flat = " ".join(normalize(text).split())
    for phrase, token in GOODBYE_PHRASES:
        flat = flat.replace(phrase, token)
    words = flat.split()
    if not words:
        return False
    # Filler is what may SURROUND a goodbye word without changing the meaning.
    # Nothing here may also be a goodbye word: a word in both sets would satisfy
    # the `any` clause on its own and turn a filler-only utterance into a hangup.
    filler = {"that", "s", "m", "it", "all", "ok", "okay", "you", "please", "no",
              "im", "i", "am", "for", "now", "mind", "never", "much", "a", "lot",
              # "no i'm good" — filler alone can never end a call (the `any`
              # clause needs a goodbye or a decline word), so widening this set
              # only ever makes an existing terminator reachable through more
              # natural phrasing.
              # ...but NOT a goodbye word. "done" was added here in a first
              # draft and is already a terminator, which is precisely the
              # collision the paragraph above forbids.
              "good", "were", "we", "re", "fine"}
    if (any(w in GOODBYE_WORDS for w in words)
            and all(w in GOODBYE_WORDS or w in filler for w in words)):
        return True
    # ★ A BARE DECLINE ENDS THE CALL. The assistant asks "Anything else?" and the
    # natural answer is "no" — which until v0.82.0 was sent to Home Assistant,
    # matched nothing, and came back "Sorry, I couldn't understand that." Measured
    # on a live call on 2026-09-06: turn 4 of 5 was the caller saying "no" and
    # being told the assistant did not understand, then having to say "no thank
    # you, goodbye" to get out.
    #
    # The whole-utterance rule is what keeps this safe. A decline hangs up only
    # when every other word is filler, so "no" and "nope" end the call while
    # "no, turn on the kitchen light" is still a command — which is exactly why
    # these are kept out of GOODBYE_WORDS, where any one of them would end a call
    # from inside a sentence.
    return (any(w in DECLINE_WORDS for w in words)
            and all(w in DECLINE_WORDS or w in filler for w in words))


def build_bias(by_area: dict) -> str:
    """Seed whisper with the names it is most likely to hear.

    The bias is a PRIOR, not a whitelist -- an unlisted word can still be
    transcribed, it is just less likely. So including the live area and light
    names costs nothing and materially improves short commands. Degrades to the
    verb list alone when Home Assistant is unreachable."""
    names: list[str] = []
    for area, lights in (by_area or {}).items():
        if area:
            names.append(str(area))
        for light in lights or []:
            name = (light or {}).get("name")
            if name:
                names.append(str(name))
    # De-duplicate while preserving order so the prompt reads naturally.
    seen: set[str] = set()
    uniq = [n for n in names if not (n.lower() in seen or seen.add(n.lower()))]
    return ", ".join(uniq + [BIAS_VERBS]) if uniq else BIAS_VERBS


def reply_text(speech: str | None, response_type: str | None) -> str:
    """What to speak for one HA answer.

    HA returns speech for BOTH success and 'error' response types -- an
    unmatched command comes back as a perfectly good sentence ('Sorry, I am not
    aware of any device called ...'). So speech wins whenever it exists, and the
    fallback is only for the transport failing outright."""
    if speech:
        return speech
    if response_type:
        return "Sorry, I didn't understand that."
    return "Sorry, I couldn't reach Home Assistant."


# --------------------------------------------------------------------------- #
# Flow
# --------------------------------------------------------------------------- #
def main() -> None:
    env = read_env()
    ident = call_id(env)
    # Transcripts are recorded by default and can be turned off without a code
    # change. When off, every timing, outcome and reason still lands — only the
    # words are withheld. See assistant_log._redact: a privacy switch that also
    # blinded the operator would simply get left on.
    feats = load_features()
    transcripts = bool((feats.get("assistant") or {}).get("transcripts", True))

    def note(outcome, **f):
        """One ledger row, written NOW rather than buffered for the end.

        Asterisk sends SIGHUP on caller hangup, nothing here installs a handler,
        and AGISIGHUP is never set in the dialplan — so this process is killed
        outright with no `finally` and no `atexit`. Anything held in memory to be
        flushed later is lost on exactly the calls that ended badly.
        """
        if assistant_log is None:
            return
        try:
            assistant_log.record(outcome, transcripts=transcripts, **ident, **f)
        except Exception as exc:  # noqa: BLE001  (telemetry never ends a call)
            log(f"could not write the assistant ledger: {exc}")

    agi("ANSWER")
    call_t0 = time.monotonic()

    if ha_client is None or not ha_client.available():
        log("home assistant unavailable")
        note("ha-unavailable", turns_used=0)
        apologize_and_bye()
        return

    try:
        bias = build_bias(ha_client.lights_by_area())
    except Exception as exc:  # noqa: BLE001  (a bias failure must not end the call)
        log(f"bias build failed: {exc}")
        note("bias-failed", detail=str(exc)[:200])
        bias = BIAS_VERBS

    say_or("Home assistant. What would you like?", PROMPT_BEEP)

    empty = 0
    for turn in range(1, MAX_TURNS + 1):
        turn_t0 = time.monotonic()
        text, meta = listen("ask", turn, bias)
        if not text:
            empty += 1
            # `meta["stt"]` is the whole point: silence, timeout, spawn-error and
            # error all reach this branch and used to be counted identically.
            note("no-speech", turn=turn, reason=meta.pop("stt", None),
                 turn_ms=int((time.monotonic() - turn_t0) * 1000), **meta)
            if empty >= MAX_EMPTY:
                note("ended-unheard", turn=turn, turns_used=turn,
                     call_ms=int((time.monotonic() - call_t0) * 1000))
                say_or("I didn't catch that. Goodbye.", PROMPT_GOODBYE)
                return
            say_or("Sorry, I didn't hear anything. Please say that again.", PROMPT_BEEP)
            continue

        meta.pop("stt", None)
        if is_goodbye(text):
            # Distinct from the loop-exhaustion goodbye below. Both used to emit
            # the identical say_or("Goodbye.") and record nothing, so a caller who
            # rang off politely and one who used up five turns without being
            # understood were the same event in every log.
            note("goodbye", turn=turn, heard=text, turns_used=turn,
                 call_ms=int((time.monotonic() - call_t0) * 1000), **meta)
            say_or("Goodbye.", PROMPT_GOODBYE)
            return

        empty = 0
        log(f"turn {turn}: {text!r}")
        c_t0 = time.monotonic()
        speech, response_type = ha_client.converse(text)
        converse_ms = int((time.monotonic() - c_t0) * 1000)
        # ★ BOUND, not passed inline. reply_text(...) used to be evaluated as a
        # call argument and never stored, so the half of "what the assistant heard
        # and said" that tells you whether it answered correctly existed nowhere.
        reply = reply_text(speech, response_type)
        s_t0 = time.monotonic()
        spoke = say_or(reply, PROMPT_GOODBYE)
        note("answered", turn=turn, heard=text, reply=reply,
             response_type=response_type or None, converse_ms=converse_ms,
             tts_ms=int((time.monotonic() - s_t0) * 1000),
             turn_ms=int((time.monotonic() - turn_t0) * 1000),
             tts_fallback=(True if spoke is False else None), **meta)

        if turn < MAX_TURNS:
            say("Anything else?")

    note("ended-max-turns", turns_used=MAX_TURNS,
         call_ms=int((time.monotonic() - call_t0) * 1000))
    say_or("Goodbye.", PROMPT_GOODBYE)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # noqa: BLE001  (never wedge the channel)
        sys.stderr.write(f"[assistant] fatal: {exc}\n")
        # A crash is the one outcome that most needs a durable record and the one
        # least likely to leave any other trace: this stderr line goes to the
        # RAM-backed container log and nowhere else.
        try:
            if assistant_log is not None:
                assistant_log.record("fatal", detail=f"{type(exc).__name__}: {exc}"[:200])
        except Exception:  # noqa: BLE001
            pass
        try:
            apologize_and_bye()
        except Exception:
            pass
