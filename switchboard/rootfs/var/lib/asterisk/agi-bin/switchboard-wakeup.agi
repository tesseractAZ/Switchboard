#!/usr/bin/python3
"""Switchboard wake-up — AGI call controller (dial the wake-up code, or routed
from the operator).

Rotary-safe voice flow, same shape as the operator AGI: greet, record a short
utterance, shell out to ``switchboard-stt --mode time`` for offline recognition,
then SET / CHANGE / CANCEL the caller's wake-up. The AGI only records the request
in the store and sets channel vars (WAKEUP_RESULT, WAKEUP_EPOCH); the *dialplan*
reads the confirmation back (Playback + SayUnixTime). The scheduler service rings
the room at the chosen time. WAKEUP_RESULT is set, cancelled, kept (a wake-up
was already set and nothing was understood, so it is read back as still set) or
none.

The caller's room ext is taken from the channel name (PJSIP/<ext>-...), so it
works regardless of caller-ID config.
"""

from __future__ import annotations

import contextlib
import os
import re
import subprocess
import sys
import wave

sys.path.insert(0, "/usr/share/switchboard/wakeup")
import store  # noqa: E402

# The delivery ledger, which the wake-up reconciler reads to learn that a ringing
# room snoozed itself. Inserted AFTER `import store`, so a module in webui/ can
# never be the `store` this AGI writes wake-ups into.
sys.path.insert(0, "/usr/share/switchboard/webui")
try:
    import delivery  # noqa: E402
except Exception:  # noqa: BLE001  (a missing ledger must never stop a wake-up being set)
    delivery = None

# Which recording each prompt plays, built-in or custom (v0.120.0).
sys.path.insert(0, "/usr/share/switchboard/prompts")
try:
    from prompt_ref import prompt  # noqa: E402  (one answer for every prompt played)
except Exception:  # noqa: BLE001  (the built-in prompts, if the resolver cannot load)
    def prompt(name: str) -> str:
        return "switchboard/" + name

STT = "/usr/bin/switchboard-stt"
ASR_DIR = "/run/switchboard/asr"
MAX_ATTEMPTS = 2
RECORD_MS = 7000
SILENCE_S = 3
# switchboard-stt's answer for a reply that SOUNDS like "cancel" without being
# the word ("Campful.", "Okay, I'm full." — see time_reply there). It cancels
# only where cancel was just offered, which is when a wake-up is set; anywhere
# else it is a miss. An AGI that predates it compares == "CANCEL" and so treats
# it as a miss too.
CANCEL_LIKE = "CANCEL-LIKE"
# RECORD's leading-silence remainder, as in switchboard-operator.agi: with s=N,
# res_agi rewinds N-1 s once N s of silence have passed, so a recording in which
# nothing crossed the threshold keeps only the last 1.02 s WHATEVER N is.
SILENT_REMAINDER_S = (0.95, 1.1)


def read_env() -> dict:
    env: dict[str, str] = {}
    while True:
        line = sys.stdin.readline()
        if not line or not line.strip():
            break
        if ":" in line:
            k, v = line.split(":", 1)
            env[k.strip()] = v.strip()
    return env


def agi(command: str) -> str:
    sys.stdout.write(command + "\n")
    sys.stdout.flush()
    return sys.stdin.readline().strip()


def stream(soundfile: str) -> None:
    agi(f'STREAM FILE {soundfile} ""')


def set_var(name: str, value: str) -> None:
    agi(f'SET VARIABLE {name} "{value}"')


def channel_ext(channel: str) -> str:
    """PJSIP/11-0000000a -> 11. Empty for anything that is not a room.

    ★ v0.99.0 — THE DIGIT TEST IS THE POINT. This was a byte-for-byte copy of
    the DISPLAY helper in webui/ami.py, whose own docstring says it yields
    "trunk" for PJSIP/trunk-... . That is right for a listing and wrong here:
    "trunk" is truthy, so the caller's `if not ext` bail was skipped and an
    OUTSIDE caller — transferred to the operator by the handset that answered,
    then asking for a wake-up — could store one under the key `trunk` and be
    told aloud, by SayUnixTime, that it was set. It can never ring
    (ami.originate_wakeup digit-guards the channel it dials), so the spoken
    confirmation was simply false; and until the fix beside it in
    scheduler.tick(), the undeliverable entry re-fired every twenty seconds
    for as long as the add-on ran.

    Every other consumer of agi_channel in this tree already requires digits —
    operator/agi_speech.py tests `.isdigit()`, and both the assistant AGI and
    switchboard-callqos match `PJSIP/(<digits>)-`. This was the one that did not.
    """
    if "/" not in channel:
        return ""
    tail = channel.split("/", 1)[1].split(";", 1)[0]
    ext = tail.rsplit("-", 1)[0] if "-" in tail else tail
    return ext if ext.isdigit() else ""


def _rec_summary(reply: str, wav: str) -> str:
    """The `bytes=B secs=S end=E [no-speech]` part of the rec breadcrumb.

    Twin of agi_speech.rec_summary and of switchboard-operator.agi's
    _rec_summary (this AGI imports nothing from operator/);
    test_operator_agi.py holds all three to the same output. `secs` comes from
    the WAV header, else from the size (8 kHz 16-bit mono: 16000 B/s behind a
    44-byte header). `end` is the bracketed word in Asterisk's RECORD reply,
    whichever it is: "timeout" for both the silence cutoff and the RECORD_MS cap
    (secs tells them apart), "hangup", "dtmf", or a failure such as "waitfor" or
    "writefile". A reply without one (an empty read) logs no `end`. `no-speech`
    marks a file that is only the silence remainder: nothing crossed the silence
    threshold, which a silent caller and a muted or dead microphone produce
    alike. Only the silence cutoff leaves that remainder, so no reply but
    "timeout" earns the flag, whatever the size."""
    # Letters only: Asterisk's own reason word, never free text in the journal.
    m = re.search(r"\(([a-z]+)\)", reply or "")
    end = m.group(1) if m else ""
    tail = f" end={end}" if end else ""
    try:
        size = os.path.getsize(wav)
    except OSError:
        return "bytes=-1" + tail          # RECORD wrote nothing
    secs = None
    try:
        with wave.open(wav, "rb") as w:
            if w.getframerate() > 0 and w.getnframes() > 0:
                secs = w.getnframes() / w.getframerate()
    except Exception:  # noqa: BLE001  (a breadcrumb must never end the call)
        pass           # a short or odd header: the size below still answers
    if secs is None:
        secs = max(size - 44, 0) / 16000
    out = f"bytes={size} secs={secs:.2f}{tail}"
    lo, hi = SILENT_REMAINDER_S
    if end == "timeout" and lo <= secs <= hi:
        out += " no-speech"
    return out


def recognize(attempt: int) -> str:
    """Record one utterance; return an 'HH:MM', 'CANCEL', 'CANCEL-LIKE' (a
    sound-alike of cancel, see CANCEL_LIKE), or '' (nothing)."""
    rec = f"{ASR_DIR}/wake-{os.getpid()}-{attempt}"
    stream(prompt("sw-beep"))
    reply = agi(f'RECORD FILE {rec} wav "" {RECORD_MS} s={SILENCE_S}')
    wav = rec + ".wav"
    # The WAV is deleted after transcription, so this line is the only evidence
    # afterwards of how long a recording was and why it ended (sizes, never
    # words). On 2026-11-23 two misses left nothing to say whether the caller
    # was cut off or spoke the whole word.
    sys.stderr.write(f"[wakeup] rec attempt={attempt} {_rec_summary(reply, wav)}\n")
    out = ""
    # Start STT before the "one moment" prompt so inference overlaps its playback
    # (the child only touches the WAV + loopback whisper-server, not the AGI channel).
    try:
        proc = subprocess.Popen([STT, "--in", wav, "--mode", "time"],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                stdin=subprocess.DEVNULL, text=True)
    except OSError as exc:
        sys.stderr.write(f"[wakeup] stt spawn error: {exc}\n")
        proc = None
    stream(prompt("sw-onemoment"))
    try:
        if proc is not None:
            so, se = proc.communicate(timeout=25)
            out = (so or "").strip()
            if se:
                sys.stderr.write(se)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.communicate()
        except OSError:
            pass
        sys.stderr.write("[wakeup] stt timeout\n")
    except OSError as exc:
        if proc is not None:
            try:
                proc.kill()
                proc.communicate()
            except OSError:
                pass
        sys.stderr.write(f"[wakeup] stt error: {exc}\n")
    finally:
        try:
            os.unlink(wav)
        except OSError:
            pass
    return out


def record_change(ext: str, entry: dict | None = None,
                  removed: bool | None = None) -> None:
    """Record a set (`entry`) or cancel (`removed`) made from THIS phone.

    ★ 2026-09-14. This row is how the wake-up reconciler learns that a ringing
    room snoozed itself. Ext 19 dialled 42 during three rings that morning and set
    a later time each time, and was rung again and sent three critical pushes
    saying nobody had picked up. The store could not have told the reconciler: a
    set leaves the same entry whoever made it, and a cancel leaves none.

    Written after the store write succeeds and before the dialplan reads the
    result back, so somebody who hangs up on the confirmation is still recorded.

    ★ stdout IS THE AGI PROTOCOL. delivery.record() reports a failed write with
    print(), and on this process's stdout that line would reach Asterisk as a
    command, and the NEXT reply this script reads would be the answer to it
    rather than to its own SET VARIABLE. So its output goes to stderr here.

    Best-effort: a wake-up must never fail to be set because its telemetry could
    not be written.
    """
    if delivery is None:
        return
    try:
        with contextlib.redirect_stdout(sys.stderr):
            delivery.record_wakeup_change(ext, delivery.SOURCE_PHONE,
                                          entry=entry, removed=removed)
    except Exception as exc:  # noqa: BLE001
        sys.stderr.write(f"[wakeup] could not record the change for ext {ext}: {exc}\n")


def main() -> None:
    env = read_env()
    ext = channel_ext(env.get("agi_channel", ""))
    if not ext:
        # Can't identify the room -> nothing to schedule against.
        set_var("WAKEUP_RESULT", "none")
        return

    # A store READ hiccup must not skip the recording prompt — degrade to the
    # "ask for a time" path and still let the caller speak (the set below will
    # surface any real write failure), rather than silently dropping the call with
    # no pause for input.
    try:
        existing = store.get(ext)
    except Exception as exc:  # noqa: BLE001
        sys.stderr.write(f"[wakeup] store read failed, proceeding to record: {exc}\n")
        existing = None
    for attempt in range(MAX_ATTEMPTS):
        if existing:
            # Read back what's set (guarding a corrupt/empty epoch), then keep
            # offering change/cancel — including across the retry.
            if attempt == 0:
                stream(prompt("sw-wakeup-exists"))  # "You have a wake-up set for…"
                tgt = existing.get("target_epoch")
                if isinstance(tgt, int) and tgt > 0:
                    agi(f"EXEC SayUnixTime {tgt},,IMp")
            else:
                stream(prompt("sw-wakeup-didnt-catch"))
            stream(prompt("sw-wakeup-change"))  # "To set a new time, say it now. To cancel, say cancel."
        else:
            stream(prompt("sw-wakeup-ask") if attempt == 0 else prompt("sw-wakeup-didnt-catch"))

        result = recognize(attempt)
        if result == CANCEL_LIKE:
            # The line turned "cancel" into something that only sounds like it.
            # It counts only where cancel was just offered: with no wake-up set
            # the caller was asked for a time, so it is a miss and they are asked
            # again. (A failed store read above also lands here, erring toward
            # keeping the alarm.)
            if existing:
                sys.stderr.write("[wakeup] a sound-alike of cancel, with a wake-up set: cancelling\n")
                result = "CANCEL"
            else:
                sys.stderr.write("[wakeup] a sound-alike of cancel, with no wake-up set: asking again\n")
        if result == "CANCEL":
            removed = store.cancel(ext)
            record_change(ext, removed=removed)
            set_var("WAKEUP_RESULT", "cancelled")
            return
        if re.fullmatch(r"\d{2}:\d{2}", result):
            entry = store.set_wakeup(ext, result)
            record_change(ext, entry=entry)
            set_var("WAKEUP_EPOCH", str(entry["target_epoch"]))
            set_var("WAKEUP_RESULT", "set")
            return

    if existing:
        # Nothing understood, and a wake-up was set when the call began. Say it
        # is still set rather than "No wake-up call was set", which a caller who
        # just tried to cancel hears as the opposite of the truth. Read the store
        # again: the claim must be about what is set NOW.
        epoch = _still_set(ext)
        if epoch:
            set_var("WAKEUP_EPOCH", str(epoch))
            set_var("WAKEUP_RESULT", "kept")
            return
    set_var("WAKEUP_RESULT", "none")


def _still_set(ext: str) -> int | None:
    """The target epoch of the wake-up stored for `ext` now, or None if there is
    none, it is unreadable, or its epoch is not a positive int. Never raises: a
    doubt means "none", so the call never claims a wake-up that may not exist."""
    try:
        entry = store.get(ext)
    except Exception as exc:  # noqa: BLE001
        sys.stderr.write(f"[wakeup] store re-read failed: {exc}\n")
        return None
    tgt = entry.get("target_epoch") if isinstance(entry, dict) else None
    if isinstance(tgt, int) and not isinstance(tgt, bool) and tgt > 0:
        return tgt
    return None


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # noqa: BLE001  (never wedge the channel)
        sys.stderr.write(f"[wakeup] fatal: {exc}\n")
        try:
            set_var("WAKEUP_RESULT", "none")
        except Exception:
            pass
