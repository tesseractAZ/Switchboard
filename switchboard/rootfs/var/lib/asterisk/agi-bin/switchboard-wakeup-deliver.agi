#!/usr/bin/python3
"""Switchboard smart wake-up delivery — AGI.

Runs inside [wakeup-deliver] when a scheduled wake-up rings a room. It adds the
"smart" extras on top of the plain greeting + time (which the dialplan always
plays): fire the configured HA scene, then speak today's weather and, optionally,
the next calendar event. Every part is a no-op if unconfigured or HA is
unreachable, and nothing here wedges the channel — the wake-up still delivers.
"""

from __future__ import annotations

import sys

sys.path.insert(0, "/usr/share/switchboard/operator")
sys.path.insert(0, "/usr/share/switchboard/webui")
import agi_speech as sp  # noqa: E402

try:
    import ha_client  # noqa: E402
except Exception:  # noqa: BLE001
    ha_client = None
try:
    import ha_reports  # noqa: E402
except Exception:  # noqa: BLE001
    ha_reports = None


def main() -> None:
    env = sp.read_env()
    wk = (sp.load_features() or {}).get("wakeup", {}) or {}

    # Per-room scene first (the room this wake-up is ringing), then the
    # whole-house fallback.
    ext = sp.channel_ext(env)
    scene = sp.wakeup_scene_for(wk, ext)
    if scene and ha_client:
        try:
            ha_client.call_service("scene", "turn_on", {"entity_id": scene})
            sp.log("wakeup-deliver", f"scene {scene} fired for ext {ext or '?'}")
        except Exception as exc:  # noqa: BLE001
            sp.log("wakeup-deliver", f"scene failed: {exc}")
    elif not scene:
        sp.log("wakeup-deliver", f"no wake-up scene configured for ext {ext or '?'}")

    if wk.get("weather", True) and ha_reports:
        # Every branch here LOGS. The 2026-08-21 06:00 wake-up delivered its
        # greeting and time and then said nothing about the weather, and the
        # logs recorded absolutely nothing about why — the fetch had timed out,
        # the report became the "unavailable" sentence, and the old string
        # sniff dropped it in silence. A feature that can fail must say so.
        try:
            w = ha_reports.weather_line()
            if not w:
                sp.log("wakeup-deliver",
                       "weather SKIPPED: no forecast (HA location unreadable or "
                       "the NWS fetch failed/timed out) — greeting + time only")
            elif not sp.say("Today's weather. " + w):
                sp.log("wakeup-deliver",
                       f"weather SKIPPED: TTS/playback failed for {w!r}")
            else:
                sp.log("wakeup-deliver", "weather spoken")
        except Exception as exc:  # noqa: BLE001
            sp.log("wakeup-deliver", f"weather failed: {exc}")

    cal = wk.get("calendar", "")
    if cal and ha_reports:
        try:
            c = ha_reports.calendar_report(cal)
            if not c:
                sp.log("wakeup-deliver", f"calendar {cal}: nothing due, skipping")
            elif not sp.say(c):
                sp.log("wakeup-deliver", f"calendar SKIPPED: TTS/playback failed for {c!r}")
        except Exception as exc:  # noqa: BLE001
            sp.log("wakeup-deliver", f"calendar failed: {exc}")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # noqa: BLE001
        sys.stderr.write(f"[wakeup-deliver] fatal: {exc}\n")
