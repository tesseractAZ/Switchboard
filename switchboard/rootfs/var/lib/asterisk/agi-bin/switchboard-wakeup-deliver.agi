#!/usr/bin/python3
"""Switchboard smart wake-up delivery — AGI.

Runs inside [wakeup-deliver] when a scheduled wake-up rings a room. It adds the
"smart" extras on top of the plain greeting + time (which the dialplan always
plays): fire the configured HA scene, then speak today's weather and, optionally,
the next calendar event. Every part is a no-op if unconfigured or HA is
unreachable, and nothing here wedges the channel — the wake-up still delivers.
"""

from __future__ import annotations

import sys

sys.path.insert(0, "/usr/share/switchboard/operator")
sys.path.insert(0, "/usr/share/switchboard/webui")
import agi_speech as sp  # noqa: E402

try:
    import ha_client  # noqa: E402
except Exception:  # noqa: BLE001
    ha_client = None
try:
    import delivery  # noqa: E402  (the answered-side ledger)
except Exception:  # noqa: BLE001
    delivery = None
try:
    import ha_reports  # noqa: E402
except Exception:  # noqa: BLE001
    ha_reports = None


def main() -> None:
    env = sp.read_env()
    wk = (sp.load_features() or {}).get("wakeup", {}) or {}

    # Optional mode argument, so the dialplan can fire the SCENE on answer and
    # speak the extras later:
    #   "scene" -> fire the scene and return    "speak" -> extras only
    #   absent  -> both, in the original order (backward compatible)
    mode = (sys.argv[1].strip().lower() if len(sys.argv) > 1 else "")
    do_scene = mode in ("", "scene")
    do_speak = mode in ("", "speak")
    # "heard" is a milestone-only pass: it writes the delivery record and returns
    # without touching HA. It runs immediately after the greeting Playback, which
    # is the earliest point at which audio has demonstrably reached the sleeper.
    do_heard = mode in ("", "heard")

    # Per-room scene first (the room this wake-up is ringing), then the
    # whole-house fallback.
    ext = sp.channel_ext(env)

    # v0.70.0 — GROUND TRUTH THAT THE WAKE-UP WAS ANSWERED.
    #
    # This AGI runs from [wakeup-deliver], which the dialplan reaches only after
    # the leg is answered. So reaching this line IS the answer, and it is the one
    # fact the scheduler could never observe: an Async Originate reports "queued"
    # the instant AMI accepts it, which is why a wake-up that rang out and one
    # that woke somebody were recorded identically as `ring-queued`. Both the
    # 2026-09-03 06:18 and 2026-09-04 06:12 wake-ups rang unanswered and left no
    # record saying so.
    #
    # Written on the "scene" pass only — the dialplan invokes this AGI twice per
    # delivery (scene on answer, speak after the time) and one answer must not
    # produce two records.
    if delivery is not None and do_scene and ext:
        try:
            delivery.record(ext, "wakeup", "answered")
        except Exception as exc:  # noqa: BLE001  (never break the wake-up over telemetry)
            sp.log("wakeup-deliver", f"could not record the answer: {exc}")

    scene = sp.wakeup_scene_for(wk, ext)
    if not do_scene:
        scene = None
    if scene and ha_client:
        try:
            ha_client.call_service("scene", "turn_on", {"entity_id": scene})
            sp.log("wakeup-deliver", f"scene {scene} fired for ext {ext or '?'}")
        except Exception as exc:  # noqa: BLE001
            sp.log("wakeup-deliver", f"scene failed: {exc}")
    elif not scene and do_scene:
        sp.log("wakeup-deliver", f"no wake-up scene configured for ext {ext or '?'}")

    # v0.77.0 — GROUND TRUTH THAT THE SLEEPER ACTUALLY HEARD SOMETHING.
    #
    # `answered` above is written on the SCENE pass, which the dialplan reaches
    # immediately after Answer() and before a single word is played. That made it
    # proof of a pickup and nothing more, and the scheduler was treating it as
    # proof of delivery. Live, on 2026-09-02 at 06:15:21, the difference was the
    # whole story: the cordless answered, the far end dropped one second later
    # during the Wait before the greeting, Asterisk transmitted ZERO audio
    # packets — and the wake-up was filed as answered and consumed. Nobody was
    # woken and nothing anywhere said so.
    #
    # WHERE this runs is the whole design. The dialplan invokes it immediately
    # after Playback(greeting) and BEFORE SayUnixTime, because Asterisk abandons
    # the extension when the channel drops: reaching this line at all proves the
    # greeting played to a live channel. Putting it any later would make a
    # perfectly ordinary wake-up — pick up, hear the greeting, hang up — look
    # undelivered, and the escalation for an undelivered wake-up is a re-ring and
    # a Do-Not-Disturb-bypassing push at six in the morning. The rule is that a
    # false alarm here costs more than the extra precision would buy.
    if do_heard and delivery is not None and ext:
        try:
            delivery.record(ext, "wakeup", "spoken")
        except Exception as exc:  # noqa: BLE001  (telemetry never breaks the wake-up)
            sp.log("wakeup-deliver", f"could not record the spoken milestone: {exc}")

    if not do_speak:
        return

    if wk.get("weather", True) and ha_reports:
        # Every branch here LOGS. The 2026-08-21 06:00 wake-up delivered its
        # greeting and time and then said nothing about the weather, and the
        # logs recorded absolutely nothing about why — the fetch had timed out,
        # the report became the "unavailable" sentence, and the old string
        # sniff dropped it in silence. A feature that can fail must say so.
        try:
            w = ha_reports.weather_line()
            if not w:
                sp.log("wakeup-deliver",
                       "weather SKIPPED: no forecast (HA location unreadable or "
                       "the NWS fetch failed/timed out) — greeting + time only")
            elif not sp.say("Today's weather. " + w):
                sp.log("wakeup-deliver",
                       f"weather SKIPPED: TTS/playback failed for {w!r}")
            else:
                sp.log("wakeup-deliver", "weather spoken")
        except Exception as exc:  # noqa: BLE001
            sp.log("wakeup-deliver", f"weather failed: {exc}")

    cal = wk.get("calendar", "")
    if cal and ha_reports:
        try:
            c = ha_reports.calendar_report(cal)
            if not c:
                sp.log("wakeup-deliver", f"calendar {cal}: nothing due, skipping")
            elif not sp.say(c):
                sp.log("wakeup-deliver", f"calendar SKIPPED: TTS/playback failed for {c!r}")
        except Exception as exc:  # noqa: BLE001
            sp.log("wakeup-deliver", f"calendar failed: {exc}")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # noqa: BLE001
        sys.stderr.write(f"[wakeup-deliver] fatal: {exc}\n")
