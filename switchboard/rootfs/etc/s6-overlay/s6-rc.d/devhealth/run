#!/command/with-contenv bashio
# Proactive device-health monitor — polls the WP826 cordless's own HTTP API for the
# signals Asterisk can't see (battery %, Wi-Fi RSSI, per-call MOS) and derives GXW
# gateway health from rtpmon's rollup, alerting on a SINGLE critical device (the
# alarm cordless; the whole gateway) that the fleet-outage gate would miss.
# Idle only on an explicit `false` — an empty/transient bashio read at boot must
# not permanently idle this enabled-by-default monitor (s6 never restarts an idle).
if [ "$(bashio::config 'device_health_enabled')" = "false" ]; then
    bashio::log.info "Device-health monitor disabled (device_health_enabled: false); idling."
    exec sleep infinity
fi

bashio::log.info "Starting Switchboard device-health monitor ..."

export DEVICE_HEALTH_INTERVAL="$(switchboard-opt device_health_interval)"
export CORDLESS_IP="$(switchboard-opt cordless_ip)"
export CORDLESS_EXT="$(switchboard-opt cordless_ext)"
export CORDLESS_PASSWORD="$(switchboard-opt cordless_password)"
export CORDLESS_CERT_SHA256="$(switchboard-opt cordless_cert_sha256)"
export GATEWAY_PORTS="$(switchboard-opt gateway_ports)"
export CORDLESS_BATTERY_CRIT="$(switchboard-opt cordless_battery_crit_pct)"
export CORDLESS_BATTERY_WARN="$(switchboard-opt cordless_battery_warn_pct)"
export CORDLESS_WIFI_MIN="$(switchboard-opt cordless_wifi_min_signal)"
# Disable alerts ONLY on an explicit `false`. `bashio::config.true` also returns
# false for an EMPTY read, which bashio can momentarily return during a config
# reload or at boot — and this export is read once, at start, so a single
# transient blank would silence every cordless/gateway alert for the whole life
# of the container with nothing to indicate it. This was the last gate in the
# add-on still using the unsafe convention; every other one (`console_enabled`,
# `link_health_enabled`, `stt_resident`, …) already tests `= "false"`.
if [ "$(bashio::config 'device_health_alerts')" = "false" ]; then
    export DEVICE_HEALTH_ALERTS=false
else
    export DEVICE_HEALTH_ALERTS=true
fi

# Read options from the post-overlay snapshot (init-switchboard writes it);
# falls back to /data/options.json when absent. Keeps every consumer on ONE
# effective view of the config.
export SWITCHBOARD_OPTIONS="/run/switchboard/options-effective.json"
exec python3 /usr/share/switchboard/devhealth/poller.py
