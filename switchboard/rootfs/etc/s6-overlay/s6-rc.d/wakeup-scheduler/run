#!/command/with-contenv bashio
# Wake-up scheduler — rings rooms at their set time via AMI Originate.
# Idle only on an explicit `false` — an empty/transient bashio read at boot must
# not permanently idle the enabled-by-default scheduler (s6 never restarts an idle),
# which would silently drop set wake-ups.
if [ "$(bashio::config 'wakeup_enabled')" = "false" ]; then
    bashio::log.info "Wake-up calls disabled (wakeup_enabled: false); scheduler idling."
    exec sleep infinity
fi

bashio::log.info "Starting Switchboard wake-up scheduler ..."

if [ -f /run/switchboard/ami.env ]; then
    # shellcheck disable=SC1091
    source /run/switchboard/ami.env
    export AMI_USER AMI_SECRET
fi

# Local time for next-occurrence math (matches the talking-clock TZ handling).
export TZ="$(cat /run/switchboard/tz 2>/dev/null || echo UTC)"
WRS="$(switchboard-opt wakeup_ring_seconds)"
export WAKEUP_RING_SECONDS="${WRS:-60}"

# v0.70.0 — the unanswered-wake-up escalation. An option is INERT until this
# script exports it: the scheduler reads os.environ, and a value that only
# reaches config.yaml never arrives.
WRT="$(switchboard-opt wakeup_retry_seconds)"
export WAKEUP_RETRY_SECONDS="${WRT:-90}"
# The notify service an undelivered wake-up escalates to, without the `notify.`
# prefix. Empty disables the push and leaves only the second ring.
WPT="$(switchboard-opt wakeup_push_target)"
export WAKEUP_PUSH_TARGET="${WPT:-mobile_app_iphone}"

# Read options from the post-overlay snapshot (init-switchboard writes it);
# falls back to /data/options.json when absent. Keeps every consumer on ONE
# effective view of the config.
export SWITCHBOARD_OPTIONS="/run/switchboard/options-effective.json"
exec python3 /usr/share/switchboard/wakeup/scheduler.py
