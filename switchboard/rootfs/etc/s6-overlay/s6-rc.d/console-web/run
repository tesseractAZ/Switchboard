#!/command/with-contenv bashio
# Console web terminal — serves the operator console's TUI in the browser via
# xterm.js, bridging WebSocket <-> the telnet console on 127.0.0.1:2300. Add it
# to the Home Assistant sidebar with a panel_iframe pointing at this LAN port.
# host_network exposes the port directly on the LAN.
# Idle ONLY on an explicit `false`. `bashio::config.true` also returns false for an
# EMPTY/transient read — bashio can momentarily read blank options during a config
# reload / at boot — which would then `exec sleep infinity` and PERMANENTLY idle an
# ENABLED service (s6 sees an idle process as "successfully started" and never
# restarts it). Both console flags default enabled, so key off the literal value:
# empty/null (transient) ⇒ run.
if [ "$(bashio::config 'console_web_enabled')" = "false" ]; then
    bashio::log.info "Console web terminal disabled (console_web_enabled: false); idling."
    exec sleep infinity
fi

# The web terminal is a front-end for the operator console; if that's off there
# is nothing to bridge to, so idle instead of serving a dead page.
if [ "$(bashio::config 'console_enabled')" = "false" ]; then
    bashio::log.info "Operator console disabled (console_enabled: false); console web terminal idling."
    exec sleep infinity
fi

# Value reads go through switchboard-opt (the post-overlay snapshot written by
# init-switchboard, which this service depends on) rather than bashio::config,
# which parses raw options.json and would silently bypass an options overlay.
# The enable-flag gates above deliberately STAY on bashio — their empty-read
# semantics are load-bearing (see the comment at the top) and the overlay is
# for values, not for turning services off.
PORT="$(switchboard-opt console_web_port 8100)"
if [ -z "${PORT}" ] || [ "${PORT}" = "null" ]; then
    PORT="8100"
fi
bashio::log.info "Starting Switchboard console web terminal on :${PORT} ..."

# Login gate: a non-empty console_users list requires a sign-in (and the WS
# upgrade itself is cookie-checked). Empty = the historical open behavior.
USERS_JSON="$(switchboard-opt console_users '[]')"
export CONSOLE_WEB_USERS="${USERS_JSON}"
if [ "${USERS_JSON}" = "[]" ] || [ -z "${USERS_JSON}" ]; then
    bashio::log.notice "The console web terminal is UNAUTHENTICATED on the LAN and drives the operator console (ring/connect/hang up). Add console_users entries to require a sign-in, or set console_web_enabled:false to turn it off."
else
    bashio::log.info "Console web terminal login gate ACTIVE (console_users configured)."
fi

export CONSOLE_WEB_PORT="${PORT}"
# Bind address: explicit console_web_bind wins; otherwise follow console_bind so
# locking the telnet console to loopback also locks the web terminal.
BIND="$(switchboard-opt console_web_bind)"
if [ -z "${BIND}" ] || [ "${BIND}" = "null" ]; then
    BIND="$(switchboard-opt console_bind)"
fi
if [ -z "${BIND}" ] || [ "${BIND}" = "null" ]; then
    BIND="0.0.0.0"
fi
export CONSOLE_WEB_BIND="${BIND}"
# Bridge to the operator console on loopback; mirror its configured port so a
# non-default console_port still works.
TARGET_PORT="$(switchboard-opt console_port 2300)"
if [ -z "${TARGET_PORT}" ] || [ "${TARGET_PORT}" = "null" ]; then
    TARGET_PORT="2300"
fi
export CONSOLE_WEB_TARGET_PORT="${TARGET_PORT}"
# Timezone backstop, matching the other services (the page itself shows no
# clock, but keep the process TZ consistent).
export TZ="$(cat /run/switchboard/tz 2>/dev/null || echo UTC)"

cd /usr/share/switchboard/console-web || exit 1
exec python3 server.py
