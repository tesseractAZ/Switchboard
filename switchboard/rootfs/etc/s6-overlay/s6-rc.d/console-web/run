#!/command/with-contenv bashio
# Console web terminal — serves the operator console's TUI in the browser via
# xterm.js, bridging WebSocket <-> the operator console's Unix socket
# (/run/switchboard/console.sock). Add it to the Home Assistant sidebar with a
# panel_iframe pointing at this port. host_network exposes the port directly on
# the LAN once its bind is moved off loopback.
# Idle ONLY on an explicit `false`. `bashio::config.true` also returns false for an
# EMPTY/transient read — bashio can momentarily read blank options during a config
# reload / at boot — which would then `exec sleep infinity` and PERMANENTLY idle an
# ENABLED service (s6 sees an idle process as "successfully started" and never
# restarts it). Both console flags default enabled, so key off the literal value:
# empty/null (transient) ⇒ run.
if [ "$(bashio::config 'console_web_enabled')" = "false" ]; then
    bashio::log.info "Console web terminal disabled (console_web_enabled: false); idling."
    exec sleep infinity
fi

# No console_enabled gate here any more. console_enabled now switches the SSH
# service only, and the operator console board this bridges to runs whenever
# this terminal is enabled (operator-console/run idles only when BOTH are off).

# Value reads go through switchboard-opt (the post-overlay snapshot written by
# init-switchboard, which this service depends on) rather than bashio::config,
# which parses raw options.json and would silently bypass an options overlay.
# The enable-flag gates above deliberately STAY on bashio — their empty-read
# semantics are load-bearing (see the comment at the top) and the overlay is
# for values, not for turning services off.
PORT="$(switchboard-opt console_web_port 8100)"
if [ -z "${PORT}" ] || [ "${PORT}" = "null" ]; then
    PORT="8100"
fi

# Login gate: the terminal runs only with at least one valid console_users row,
# and then requires a sign-in (the WS upgrade itself is cookie-checked). With
# none it does not start (the gate below, v0.125.0).
USERS_JSON="$(switchboard-opt console_users '[]')"
export CONSOLE_WEB_USERS="${USERS_JSON}"
# Count with the SERVER'S OWN parser, not a string compare on the raw JSON:
# webauth.parse_users drops rows missing a username or password, and server.py
# serves with no login at all when that leaves nothing. A list of only-invalid
# rows therefore counts 0 here and the terminal idles; counting it any other way
# would start a terminal with no login. (server.py also logs its mode at start.)
VALID_USERS="$(CONSOLE_WEB_USERS="${USERS_JSON}" python3 -c "
import os, sys
sys.path.insert(0, '/usr/share/switchboard/console-web')
import webauth
print(len(webauth.parse_users(os.environ.get('CONSOLE_WEB_USERS', ''))))
" 2>/dev/null || echo 0)"
export CONSOLE_WEB_PORT="${PORT}"
# Bind address: console_web_bind, and 127.0.0.1 when it is blank.
#
# A blank bind does not follow console_bind. That option is the SSH service's
# bind, which defaults to every interface because SSH always asks for a
# password; this terminal keeps its own bind, loopback unless console_web_bind
# says otherwise (before v0.125.0 it also ran with no login while console_users
# was empty, so following the SSH bind would have put an open terminal on the LAN).
#
# v0.71.0 — RESOLVED BEFORE THE NOTICE BELOW, not after. The warning used to be
# printed here-1 and BIND computed here+8, so the line claiming the terminal was
# "UNAUTHENTICATED on the LAN" could not see the bind that decided whether it was
# on the LAN at all.
BIND="$(switchboard-opt console_web_bind)"
if [ -z "${BIND}" ] || [ "${BIND}" = "null" ]; then
    # Fail CLOSED (since v0.94.0). This fires when the option is blank, or on a
    # transient blank read during a config reload. The old fallback was
    # 0.0.0.0, so a momentary glitch put a terminal that drives call control
    # onto the LAN until the next restart. A terminal that is briefly reachable
    # only from the host is the cheaper failure by far.
    BIND="127.0.0.1"
fi
export CONSOLE_WEB_BIND="${BIND}"

# v0.71.0 — is this bind address loopback-only?
#
# POSIX `case`, so macOS bash 3.2 and the container's ash both run it unchanged.
# `127.*` rather than a literal 127.0.0.1: the whole 127/8 block is loopback and
# a bind of 127.0.1.1 is just as unreachable from the LAN.
#
# The DEFAULT (0.0.0.0, and an empty read) deliberately falls through to "not
# loopback", so the failure direction is a warning nobody needed rather than a
# silence on a genuinely exposed terminal.
sw_is_loopback() {
    case "${1:-}" in
        127.*|::1|\[::1\]|localhost) return 0 ;;
        *) return 1 ;;
    esac
}

# v0.125.0 — NO LOGIN, NO TERMINAL. Without console_users this terminal drives
# the operator console (ring, connect, hang up) for anyone who can reach its
# port, and "bound to loopback" did not make that safe: under host_network the
# container's 127.0.0.1 is the host's own, so every program on the host and
# every other host-network add-on could connect. The Ingress console in the web
# UI is the way in without a login of its own (Home Assistant signs the caller
# in), so this service now idles instead. VALID_USERS is the server's own count
# (webauth.parse_users) and reads 0 when it cannot be parsed, so this fails
# closed, and anything that is not a positive whole number idles too.
# switchboard-opt reads the init snapshot, not bashio, so a transient blank
# options read cannot reach it.
if ! [ "${VALID_USERS}" -gt 0 ] 2>/dev/null; then
    bashio::log.notice "Console web terminal NOT started: console_users has no valid entry (a username and a password), and with no login anything on this host (under host networking, every host-network add-on too) could drive the operator console through ${BIND}:${PORT}. Use the operator console in this add-on's panel in Home Assistant, or add a console_users entry to run this terminal with a sign-in."
    exec sleep infinity
fi
bashio::log.info "Starting Switchboard console web terminal on ${BIND}:${PORT} ..."
if sw_is_loopback "${BIND}"; then
    bashio::log.info "Console web terminal login gate ACTIVE (${VALID_USERS} user(s)), bound to ${BIND}."
else
    bashio::log.info "Console web terminal login gate ACTIVE (${VALID_USERS} user(s)), reachable from the LAN on ${BIND}:${PORT}."
fi
# The bridge target is the operator console's Unix socket at a fixed path
# (server.py's CONSOLE_SOCKET default). console_port is the SSH service's port
# and has nothing to do with it, so nothing is exported for it here.
# Timezone backstop, matching the other services (the page itself shows no
# clock, but keep the process TZ consistent).
export TZ="$(cat /run/switchboard/tz 2>/dev/null || echo UTC)"

cd /usr/share/switchboard/console-web || exit 1
exec python3 server.py
