#!/command/with-contenv bashio
# Telnet operator console — a live switchboard board an operator drives over
# telnet (ring a room, connect two rooms, hang up). host_network exposes the
# port on the LAN, so `telnet <host> <port>` reaches it directly.
# Idle ONLY on an explicit `false`. bashio can momentarily read blank options at
# boot; `bashio::config.true` treats that empty read as false and would then
# PERMANENTLY idle this enabled-by-default service (s6 never restarts an idle
# process). Key off the literal value so an empty/transient read runs.
if [ "$(bashio::config 'console_enabled')" = "false" ]; then
    bashio::log.info "Operator console disabled (console_enabled: false); idling."
    exec sleep infinity
fi

# Value reads via switchboard-opt (the post-overlay snapshot from
# init-switchboard, a declared dependency) — bashio::config parses raw
# options.json and would bypass an options overlay. The enable gate above
# stays on bashio: its empty-read semantics are load-bearing.
PORT="$(switchboard-opt console_port 2300)"
BIND="$(switchboard-opt console_bind 0.0.0.0)"
# v0.71.0 — is this bind address loopback-only?
#
# POSIX `case`, so macOS bash 3.2 and the container's ash both run it unchanged.
# `127.*` rather than a literal 127.0.0.1: the whole 127/8 block is loopback and
# a bind of 127.0.1.1 is just as unreachable from the LAN.
#
# The DEFAULT (0.0.0.0, and an empty read) deliberately falls through to "not
# loopback", so the failure direction is a warning nobody needed rather than a
# silence on a genuinely exposed console.
sw_is_loopback() {
    case "${1:-}" in
        127.*|::1|\[::1\]|localhost) return 0 ;;
        *) return 1 ;;
    esac
}

bashio::log.info "Starting Switchboard operator console on ${BIND}:${PORT} ..."
# The notice used to fire unconditionally — including when console_bind was
# ALREADY 127.0.0.1, i.e. when the reader had done exactly what it asked. A
# warning you cannot silence by complying trains people to ignore the channel
# that carries the real ones.
if sw_is_loopback "${BIND}"; then
    bashio::log.info "The operator console is bound to ${BIND} — not reachable from the LAN directly. (The console web terminal, if enabled, may still be.)"
else
    bashio::log.notice "The operator console is UNAUTHENTICATED on ${BIND} and can ring/connect/hang up phones. Set console_bind to 127.0.0.1 to restrict it, or console_enabled:false to turn it off."
fi

if [ -f /run/switchboard/ami.env ]; then
    # shellcheck disable=SC1091
    source /run/switchboard/ami.env
    export AMI_USER AMI_SECRET
fi

export CONSOLE_PORT="${PORT}"
export CONSOLE_HOST="${BIND}"
# Timezone backstop: the init step points /etc/localtime at the resolved zone,
# but also export TZ so the board clock is right even if the symlink didn't take.
export TZ="$(cat /run/switchboard/tz 2>/dev/null || echo UTC)"
cd /usr/share/switchboard/console || exit 1
# Read options from the post-overlay snapshot (init-switchboard writes it);
# falls back to /data/options.json when absent. Keeps every consumer on ONE
# effective view of the config.
export SWITCHBOARD_OPTIONS="/run/switchboard/options-effective.json"
exec python3 console.py
