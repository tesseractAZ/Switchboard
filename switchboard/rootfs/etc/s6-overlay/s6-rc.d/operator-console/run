#!/command/with-contenv bashio
# Operator console board — the live switchboard an operator drives (ring a room,
# connect two rooms, hang up). It listens ONLY on the Unix socket
# /run/switchboard/console.sock (mode 0600, root), never on a network port, so
# this script reads no port or bind option: console_port and console_bind belong
# to the SSH service in front of it. Its clients are the SSH console
# (console_enabled), the browser terminal (console_web_enabled) and the console
# in the Switchboard sidebar, and each one authenticates before it connects.
#
# Idle only when BOTH front doors with a switch are explicitly off. Turning SSH
# off must not take the board away from the browser terminal or the sidebar,
# which is what keying off console_enabled alone used to do.
#
# Idle ONLY on an explicit `false`. bashio can momentarily read blank options at
# boot; `bashio::config.true` treats that empty read as false and would then
# PERMANENTLY idle this enabled-by-default service (s6 never restarts an idle
# process). Key off the literal value so an empty/transient read runs.
if [ "$(bashio::config 'console_enabled')" = "false" ] && [ "$(bashio::config 'console_web_enabled')" = "false" ]; then
    bashio::log.info "Operator console disabled (console_enabled and console_web_enabled are both false); idling. The console in the Switchboard sidebar shows 'unavailable' until one of them is turned back on."
    exec sleep infinity
fi

bashio::log.info "Starting Switchboard operator console on /run/switchboard/console.sock (local clients only) ..."

# Timezone backstop: the init step points /etc/localtime at the resolved zone,
# but also export TZ so the board clock is right even if the symlink didn't take.
export TZ="$(cat /run/switchboard/tz 2>/dev/null || echo UTC)"
cd /usr/share/switchboard/console || exit 1
# Read options from the post-overlay snapshot (init-switchboard writes it);
# falls back to /data/options.json when absent. Keeps every consumer on ONE
# effective view of the config.
export SWITCHBOARD_OPTIONS="/run/switchboard/options-effective.json"
exec python3 console.py
