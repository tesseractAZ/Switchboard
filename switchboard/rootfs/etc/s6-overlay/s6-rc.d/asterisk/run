#!/command/with-contenv bashio
# Run Asterisk in the foreground under s6 supervision.
bashio::log.info "Starting Asterisk..."

# /var/lib/asterisk must be asterisk-owned so Asterisk can create astdb.sqlite3
# (and its journal) there. `COPY rootfs /` resets the dir to root, so chown it
# back on every start — the directory itself, NOT recursively. Its agi-bin,
# sounds and moh subtrees are shipped code and audio that Asterisk only reads
# and executes; the AppArmor profile write-locks them, and a recursive chown
# would be refused (a "w" deny also covers chown) once per file, every start.
# keys/ stays asterisk-owned, as before.
mkdir -p /var/run/asterisk /var/log/asterisk /var/lib/asterisk
chown -R asterisk:asterisk /var/run/asterisk /var/log/asterisk 2>/dev/null || true
chown asterisk:asterisk /var/lib/asterisk 2>/dev/null || true
chown -R asterisk:asterisk /var/lib/asterisk/keys 2>/dev/null || true

# Timezone backstop for SayUnixTime (the talking clock): the init step points
# /etc/localtime at the resolved zone, but also export TZ so the spoken time is
# right even if the symlink didn't take.
export TZ="$(cat /run/switchboard/tz 2>/dev/null || echo UTC)"

# The -v count decides whether Asterisk's verbose trace — the dialplan trace,
# every dialled number included — reaches the add-on log: Asterisk always routes
# verbose lines to its console and drops those above this count there. The init
# step derives it from log_level (switchboard-config asterisk_console_verbosity):
# 3 for info, debug and trace; 0 for notice and above. The durable
# /data/state/asterisk.log keeps its reachability lines at any count, because its
# logger channel holds the generation level at 3. A missing or unexpected value
# means the default, info.
VERBOSITY="$(cat /run/switchboard/asterisk-verbosity 2>/dev/null || echo 3)"
case "${VERBOSITY}" in
    0) set -- ;;
    *) set -- -vvv ;;
esac

# -f  foreground (no fork, so s6 supervises it)
# s6-setuidgid starts Asterisk as the asterisk user from the first instruction,
# as whisper-server already is. Asterisk's own -U/-G switched user after
# starting as root and kept root's whole PERMITTED capability set (it asks for
# KEEPCAPS to hold on to net_admin, which the container never grants), so a
# compromised Asterisk — the process that talks to the SIP trunk — could raise
# dac_override, setuid or chown again. Started this way its permitted set is
# empty. Nothing it does needs root: its config files are 0640 root:asterisk,
# and every listener is on a port above 1024.
exec s6-setuidgid asterisk asterisk -f "$@"
